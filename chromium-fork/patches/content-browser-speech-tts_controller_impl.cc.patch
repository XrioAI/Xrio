 void TtsControllerImpl::SpeakNow(std::unique_ptr<TtsUtterance> utterance) {
+  if (xrio::IsSpeechPersonaEngine(utterance->GetEngineId())) {
+    // Branded Chrome keeps its remote voice inventory when the speech endpoint
+    // cannot be reached. A non-empty request remains current until cancellation;
+    // its component extension has no asynchronous media-error handler. Preserve
+    // that measured no-egress behavior without loading the extension or making
+    // a Google request. Empty utterances complete immediately in the extension.
+    const bool empty = utterance->GetText().empty();
+    SetCurrentUtterance(std::move(utterance));
+    if (empty) {
+      OnTtsEvent(current_utterance_->GetId(), TTS_EVENT_END, 0, 0,
+                 std::string());
+    }
+    return;
+  }
+  if (xrio::IsUnavailableSpeechPersonaEngine(utterance->GetEngineId())) {
+    // A selected but absent/invalid artifact must not fall through to a host
+    // voice that the page-facing list deliberately hid. This is Chromium's
+    // native no-engine outcome and maps to Web Speech `synthesis-failed`.
+    SetCurrentUtterance(std::move(utterance));
+    OnTtsEvent(current_utterance_->GetId(), TTS_EVENT_ERROR, 0, 0,
+               "speech persona unavailable");
+    return;
+  }
+
   // Get all available voices and try to find a matching voice.
   std::vector<VoiceData> voices;
   GetVoices(utterance->GetBrowserContext(), utterance->GetSrcUrl(), &voices);
