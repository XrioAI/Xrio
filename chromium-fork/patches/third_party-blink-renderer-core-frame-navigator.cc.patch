 bool Navigator::webdriver() const {
+  // Answered in C++ and never true. Strictly better than driver-side handling:
+  // no getter to find, no descriptor anomaly, no toString tell, and CDP cannot
+  // flip it back. Unconditional on purpose -- a flag-gated version would ship
+  // `webdriver === true` the first time the flag was forgotten, and that is the
+  // dangerous direction to fail in (catalog SS3 #87).
+  if (::base::xrio::ForceWebdriverFalse())
+    return false;
+
   if (RuntimeEnabledFeatures::AutomationControlledEnabled())
     return true;
 
