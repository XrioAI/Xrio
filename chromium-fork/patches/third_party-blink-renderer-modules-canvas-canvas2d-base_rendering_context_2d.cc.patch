@@ -18,6 +18,9 @@
 #include "base/memory/scoped_refptr.h"
 #include "base/memory/weak_ptr.h"
 #include "base/metrics/histogram_functions.h"
+#include "base/xrio_persona.h"
+#include "base/xrio_perturb.h"
+#include "ui/gfx/skia_span_util.h"
 #include "base/notreached.h"
 #include "base/numerics/checked_math.h"
 #include "base/numerics/safe_conversions.h"
@@ -515,6 +518,22 @@ ImageData* BaseRenderingContext2D::getImageDataInternal(
       SkIRect bounds =
           snapshot->PaintImageForCurrentFrame().GetSkImageInfo().bounds();
       DCHECK(!bounds.intersect(SkIRect::MakeXYWH(sx, sy, sw, sh)));
+    } else if (::base::xrio::PerturbCanvasEnabled()) {
+      // The SAME knob as the toDataURL/toBlob encode path in
+      // xrio_canvas_perturb.h, deliberately: give the two separate enables and a
+      // configuration exists where one is perturbed and the other is not, so the
+      // two would disagree about the same pixels -- louder than either constant
+      // hash on its own.
+      if (std::optional<uint64_t> xrio_seed = ::base::xrio::CanvasSeed()) {
+        // sx/sy, not zero: keying on ABSOLUTE canvas coordinates is what makes a
+        // sub-rect getImageData agree with a whole-canvas toDataURL where the
+        // two overlap.
+        ::base::xrio::PerturbPixels(
+            gfx::SkPixmapToWritableSpan(image_data_pixmap),
+            image_data_pixmap.rowBytes(), image_data_pixmap.width(),
+            image_data_pixmap.height(),
+            image_data_pixmap.info().bytesPerPixel(), sx, sy, xrio_seed.value());
+      }
     }
