+void ClipWorkArea(std::vector<display::Display>* displays,
+                  size_t primary_display_index,
+                  const gfx::Rect& net_workarea) {
+  ClipWorkAreaUpstream(displays, primary_display_index, net_workarea);
+  if (displays->empty() ||
+      std::ranges::any_of(*displays, [](const display::Display& display) {
+        return display.work_area() != display.bounds();
+      })) {
+    return;
+  }
+  const std::optional<int> panel = base::xrio::WorkAreaPanelHeight();
+  display::Display& primary = (*displays)[primary_display_index];
+  if (!panel || *panel >= primary.bounds().height()) {
+    return;
+  }
+  gfx::Rect work_area = primary.bounds();
+  work_area.set_height(work_area.height() - *panel);
+  primary.set_work_area(work_area);
+}
