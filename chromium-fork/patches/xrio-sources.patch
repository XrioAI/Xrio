+#include "base/values.h"
+
+namespace base::xrio {
+
+namespace {
+
+// A default that names another knob instead of carrying a literal. See the
+// UMBRELLAS paragraph in the header.
+constexpr char kUmbrellaPrefix = '@';
+
+// Longest umbrella chain followed. Two is enough for every row in kKnobs; the
+// bound exists so a future typo cannot spin.
+constexpr int kMaxUmbrellaHops = 4;
+
+// ---------------------------------------------------------------------------
+// Parsers. Shared by ValidateConfig and by the accessors, so a value that
+// validated at startup cannot fail to parse at a call site.
+
+bool ParseBool(std::string_view raw, bool* out) {
+  // A valueless switch harvests as an empty value. `--xrio-jitter-geometry`
+  // meaning true is the spelling a command line makes natural, and it is also
+  // what the presence-only read this replaces did.
+  if (raw.empty()) {
+    *out = true;
+    return true;
+  }
+  const std::string lowered = ToLowerASCII(raw);
+  if (lowered == "true" || lowered == "1" || lowered == "yes" ||
+      lowered == "on") {
+    *out = true;
+    return true;
+  }
+  if (lowered == "false" || lowered == "0" || lowered == "no" ||
+      lowered == "off") {
+    *out = false;
+    return true;
+  }
+  return false;
+}
+
+bool ParseInt(std::string_view raw, int64_t* out) {
+  return StringToInt64(raw, out);
+}
+
+bool ParseDouble(std::string_view raw, double* out) {
+  return StringToDouble(raw, out);
+}
+
+// Decimal or `0x`-prefixed hex, and zero is refused. Same rule as
+// XrioConfig::GetSeed, restated here because this parser also has to handle a
+// registry DEFAULT, which never passes through XrioConfig at all.
+bool ParseSeed(std::string_view raw, uint64_t* out) {
+  constexpr std::string_view kHexPrefix = "0x";
+  const bool ok = raw.starts_with(kHexPrefix)
+                      ? HexStringToUInt64(raw.substr(kHexPrefix.size()), out)
+                      : StringToUint64(raw, out);
+  return ok && *out != 0;
+}
+
+// ---------------------------------------------------------------------------
+// Constraints. Each returns false and fills `error` for a value that parses as
+// its type but cannot be honoured. ValidateConfig runs them, so every one of
+// these refuses a LAUNCH rather than a surface.
+
+bool AtLeastOne(std::string_view value, std::string* error) {
+  int64_t parsed = 0;
+  if (!ParseInt(value, &parsed) || parsed < 1) {
+    *error = "must be an integer of at least 1";
+    return false;
+  }
+  return true;
+}
+
+bool NonNegativeInt(std::string_view value, std::string* error) {
+  int64_t parsed = 0;
+  if (!ParseInt(value, &parsed) || parsed < 0) {
+    *error = "must be an integer of at least 0";
+    return false;
+  }
+  return true;
+}
+
+bool Positive(std::string_view value, std::string* error) {
+  double parsed = 0.0;
+  if (!ParseDouble(value, &parsed) || !(parsed > 0.0)) {
+    *error = "must be greater than 0";
+    return false;
+  }
+  return true;
+}
+
+bool NonNegative(std::string_view value, std::string* error) {
+  double parsed = 0.0;
+  if (!ParseDouble(value, &parsed) || parsed < 0.0) {
+    *error = "must be 0 or greater";
+    return false;
+  }
+  return true;
+}
+
+// 2^k-1 only. `(h & mask) == phase` is a uniform 1-in-(mask+1) selection exactly
+// when the mask is a run of low bits; anything else picks a lopsided residue
+// class, which shows up as a periodic flip pattern rather than a sparse one.
+bool RateMask(std::string_view value, std::string* error) {
+  int64_t parsed = 0;
+  if (!ParseInt(value, &parsed) || parsed < 0) {
+    *error = "must be a non-negative integer";
+    return false;
+  }
+  const uint64_t mask = static_cast<uint64_t>(parsed);
+  if ((mask & (mask + 1)) != 0) {
+    *error = "must be 2^k-1 (0, 1, 3, 7, 15, 31, ...) so the pixel selection "
+             "is uniform";
+    return false;
+  }
+  // 2^24-1 is one pixel in ~16 million: a 4K canvas would get a handful of
+  // flips and most canvases none, which is the constant hash back again. The
+  // bound is a guard against a typo, not a claim about the right value.
+  if (mask > 0xFFFFFF) {
+    *error = "is so sparse that most canvases would get no flip at all "
+             "(maximum 0xFFFFFF)";
+    return false;
+  }
+  return true;
+}
+
+// The rendered page IS the product. 1 is +-1/255 on one channel; 3 is +-3/255
+// and already visible as speckle on a flat fill, which is its own anomaly. Wider
+// than that is not a fingerprinting knob, it is damage.
+bool PixelBitMask(std::string_view value, std::string* error) {
+  int64_t parsed = 0;
+  if (!ParseInt(value, &parsed) || parsed < 1 || parsed > 3) {
+    *error = "must be 1 or 3 -- a wider mask is visible in the rendered image, "
+             "which is the deliverable";
+    return false;
+  }
+  if (parsed == 2) {
+    *error = "must be 1 or 3: a mask of 2 moves only the second bit, which "
+             "changes a pixel by 2/255 while leaving the low bit constant";
+    return false;
+  }
+  return true;
+}
+
+bool HashShift(std::string_view value, std::string* error) {
+  int64_t parsed = 0;
+  if (!ParseInt(value, &parsed) || parsed < 1 || parsed > 63) {
+    *error = "must be in [1, 63] -- it is a shift of a 64-bit word";
+    return false;
+  }
+  return true;
+}
+
+bool IsReportableDeviceMemory(double gb) {
+  return gb == 2.0 || gb == 4.0 || gb == 8.0 || gb == 16.0 || gb == 32.0;
+}
+
+bool CoreCount(std::string_view value, std::string* error) {
+  int64_t parsed = 0;
+  if (!ParseInt(value, &parsed) || parsed < 1 ||
+      parsed > std::numeric_limits<int>::max()) {
+    *error = "must be an integer from 1 to 2147483647";
+    return false;
+  }
+  return true;
+}
+
+bool ReportableDeviceMemory(std::string_view value, std::string* error) {
+  double parsed = 0.0;
+  if (!ParseDouble(value, &parsed) || !IsReportableDeviceMemory(parsed)) {
+    *error = "must be 2, 4, 8, 16 or 32, the values desktop Chrome reports";
+    return false;
+  }
+  return true;
+}
+
+bool NonEmpty(std::string_view value, std::string* error) {
+  if (value.empty()) {
+    *error = "must not be empty";
+    return false;
+  }
+  return true;
+}
+
+// A file NAME component, not a path: the same rule NameIsUsable applies to a
+// persona name, for the same reason. `--xrio-gl-table-suffix=/etc/passwd` would
+// otherwise turn a suffix into a path expression.
+bool FilenameSuffix(std::string_view value, std::string* error) {
+  if (value.empty() || value.front() != '.') {
+    *error = "must be a filename suffix beginning with '.'";
+    return false;
+  }
+  if (value.find('/') != std::string_view::npos ||
+      value.find("..") != std::string_view::npos) {
+    *error = "must not contain a path separator or a parent reference";
+    return false;
+  }
+  return true;
+}
+
+// A Chrome full version: exactly four dot-separated components, digits only, no
+// leading zeros. SYNTAX ONLY, deliberately.
+//
+// Whether a version was ever RELEASED is not a question this process can answer.
+// It would need either a network lookup -- and a browser that must reach the
+// network to decide whether it may start is a worse failure mode than the tell
+// this knob exists to remove -- or a copy of the released-version list compiled
+// into base/, which is a second place for that knowledge to drift. The
+// allowlist, and the check that the value's major agrees with
+// CHROMIUM_VERSION, live in tools/check_ua_version.py and run at package time.
+// Startup owns syntax; packaging owns policy.
+//
+// Empty is allowed and means "report the build's own version". That IS the tell,
+// so it is refused in a SHIPPED config by tools/check_ua_version.py rather than
+// here, where a development build still has a legitimate reason to want it.
+bool UaFullVersion(std::string_view value, std::string* error) {
+  if (value.empty()) {
+    return true;
+  }
+  int components = 0;
+  size_t start = 0;
+  while (true) {
+    const size_t dot = value.find('.', start);
+    const std::string_view part = value.substr(
+        start, dot == std::string_view::npos ? std::string_view::npos
+                                             : dot - start);
+    if (part.empty()) {
+      *error = "must be four dot-separated numbers, e.g. 151.0.7922.137";
+      return false;
+    }
+    for (const char c : part) {
+      if (c < '0' || c > '9') {
+        *error = "must be four dot-separated numbers, e.g. 151.0.7922.137";
+        return false;
+      }
+    }
+    // A leading zero is how a transposed or hand-edited version reads as valid
+    // while denoting something else; no Chrome version component carries one.
+    if (part.size() > 1 && part.front() == '0') {
+      *error = "must not have a leading zero in any component";
+      return false;
+    }
+    ++components;
+    if (dot == std::string_view::npos) {
+      break;
+    }
+    start = dot + 1;
+  }
+  if (components != 4) {
+    *error = "must have exactly four components, e.g. 151.0.7922.137";
+    return false;
+  }
+  return true;
+}
+
+// One of the four upstream WebRTC IP-handling policies. Spelled as the pref
+// values blink defines, so what goes in the flag is what lands in the pref.
+bool ColorScheme(std::string_view value, std::string* error) {
+  if (value == "light" || value == "dark") {
+    return true;
+  }
+  *error = "must be one of: light, dark";
+  return false;
+}
+
+bool WebRtcPolicy(std::string_view value, std::string* error) {
+  if (value == "default" || value == "default_public_and_private_interfaces" ||
+      value == "default_public_interface_only" ||
+      value == "disable_non_proxied_udp") {
+    return true;
+  }
+  *error = "must be one of: default, "
+           "default_public_and_private_interfaces, "
+           "default_public_interface_only, disable_non_proxied_udp";
+  return false;
+}
+
+// `[[cores, memory_gb, free_disk_gb, weight], ...]`, non-empty, every row
+// coherent. Validated here rather than at the consumer because a malformed table
+// must refuse the launch: silently falling back to upstream's own cores and
+// memory would leave the operator believing a persona was applied.
+// An expected machine class, as persisted by whatever created the session
+// profile. The SHAPE is checked here so a malformed one refuses the launch with
+// a message naming the field; whether the expectation is HONOURED is a question
+// about this host and is answered by MachineClassExpectationProblem() in
+// xrio_persona.cc, after the config is installed.
+bool MachineClassExpectation(std::string_view value, std::string* error) {
+  std::optional<DictValue> parsed = JSONReader::ReadDict(value, JSON_PARSE_RFC);
+  if (!parsed.has_value()) {
+    *error = "must be a JSON object";
+    return false;
+  }
+  const std::optional<int> version = parsed->FindInt("version");
+  if (!version.has_value() || *version < 1) {
+    *error = "needs \"version\": the integer selection-algorithm version the "
+             "expectation was drawn under (base/xrio_knobs.h's "
+             "kMachineSelectionVersion)";
+    return false;
+  }
+  const std::optional<int> ceiling = parsed->FindInt("ceiling");
+  if (!ceiling.has_value() || *ceiling < 1) {
+    *error = "needs \"ceiling\": the effective core ceiling the class was "
+             "drawn under, which is min(host processors, the persona's "
+             "max_threads). Without it a re-draw on this host is not the same "
+             "draw";
+    return false;
+  }
+  // The persona is REQUIRED but may be the empty string, because "no persona"
+  // is a real configuration and it has to be distinguishable from "the field
+  // was forgotten". An expectation drawn with a persona and replayed without
+  // one is a different ceiling and therefore a different draw.
+  if (!parsed->FindString("persona")) {
+    *error = "needs \"persona\": the gl-persona name the class was drawn "
+             "under, or \"\" for none";
+    return false;
+  }
+  const ListValue* row = parsed->FindList("class");
+  if (!row || row->size() != 3) {
+    *error = "needs \"class\": [cores, memory_gb, free_disk_gb], the drawn "
+             "row's first three fields";
+    return false;
+  }
+  if (!(*row)[0].GetIfInt() || !(*row)[1].GetIfDouble() ||
+      !(*row)[2].GetIfInt()) {
+    *error = "\"class\" must be [int cores, number memory_gb, int "
+             "free_disk_gb]";
+    return false;
+  }
+  return true;
+}
