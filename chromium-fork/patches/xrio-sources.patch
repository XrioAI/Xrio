+std::string UaFullVersionOr(std::string_view real) {
+  // Only the HIGH-ENTROPY version surfaces reach this: `navigator.userAgent`
+  // already reads `151.0.0.0` because kReduceUserAgentMinorVersion is on, so it
+  // is identical on stock and on this fork and needs no help. What differs is
+  // `sec-ch-ua-full-version`, `sec-ch-ua-full-version-list` and the
+  // `fullVersionList` high-entropy hint -- all three fed by
+  // version_info::GetVersionNumber(), which reports the BUILD, and this fork's
+  // build number is not one any released Chrome carries.
+  //
+  // Deliberately NOT routed through version_info itself. `chrome --version`,
+  // the envelope's chrome_version, verify_probe's check and the GL persona
+  // artifact's chrome_version all read version_info directly, and the persona
+  // FAILS CLOSED on a mismatch -- so overriding it there would silently disable
+  // every GL surface this fork exists to move.
+  std::string configured = GetString("ua-full-version");
+  if (configured.empty()) {
+    return std::string(real);
+  }
+  return configured;
+}
