+TEST(XrioPersonaTest, BatteryStatusReadsACompleteTuple) {
+  XrioConfig::Get().SetAll(
+      {{"battery-status",
+        R"json({"charging": false, "level": 0.71,
+                "charging_time": "Infinity", "discharging_time": 42960})json"}});
+  const std::optional<BatteryStatus> status = BatteryStatusOverride();
+  ASSERT_TRUE(status.has_value());
+  EXPECT_FALSE(status->charging);
+  EXPECT_EQ(0.71, status->level);
+  EXPECT_TRUE(std::isinf(status->charging_time));
+  EXPECT_EQ(42960.0, status->discharging_time);
+  XrioConfig::Get().SetAll({});
+}
+
+// An integer time is the same value as the float, not a type error. `42960` is
+// what a person writes.
+TEST(XrioPersonaTest, BatteryTimesAcceptIntegersAndInfinity) {
+  BatteryStatus status;
+  std::string error;
+  ASSERT_TRUE(ParseBatteryStatus(
+      R"json({"charging": true, "level": 0.5,
+              "charging_time": 600, "discharging_time": "Infinity"})json",
+      &status, &error))
+      << error;
+  EXPECT_EQ(600.0, status.charging_time);
+  EXPECT_TRUE(std::isinf(status.discharging_time));
+}
+
+// THE TUPLE IS ATOMIC. A partial object would take compiled defaults for the
+// fields it omits and pair them with the operator's, which is how "charging
+// with a finite discharging time" gets built by someone who never typed it.
+TEST(XrioPersonaTest, BatteryStatusRefusesAPartialTuple) {
+  BatteryStatus status;
+  std::string error;
+  EXPECT_FALSE(ParseBatteryStatus(
+      R"json({"charging": false, "level": 0.5})json", &status, &error));
+  // "is missing", not just the key name: `charging_time` is a SUBSTRING of
+  // `discharging_time`, so an assertion on the bare key would be satisfied by
+  // a message about the other field entirely.
+  EXPECT_NE(std::string::npos, error.find("is missing \"charging_time\""))
+      << "the message must name the missing key: " << error;
+  // An extra key is refused for the mirror reason: a typo must not read as
+  // accepted.
+  EXPECT_FALSE(ParseBatteryStatus(
+      R"json({"charging": false, "level": 0.5, "charge_time": "Infinity",
+              "charging_time": "Infinity", "discharging_time": 60})json",
+      &status, &error));
+  EXPECT_FALSE(ParseBatteryStatus("[]", &status, &error));
+  EXPECT_FALSE(ParseBatteryStatus("not json", &status, &error));
+}
+
+TEST(XrioPersonaTest, BatteryStatusRefusesAnIncoherentTuple) {
+  BatteryStatus status;
+  std::string error;
+  // Filling and emptying at once.
+  EXPECT_FALSE(ParseBatteryStatus(
+      R"json({"charging": true, "level": 0.5,
+              "charging_time": 600, "discharging_time": 900})json",
+      &status, &error));
+  EXPECT_NE(std::string::npos, error.find("discharging_time")) << error;
+  // Discharging with a time until full.
+  EXPECT_FALSE(ParseBatteryStatus(
+      R"json({"charging": false, "level": 0.5,
+              "charging_time": 600, "discharging_time": 900})json",
+      &status, &error));
+  EXPECT_NE(std::string::npos, error.find("is discharging")) << error;
+  // A level outside (0, 1]. Zero is a machine that has switched off.
+  for (const char* level : {"0", "-0.1", "1.5"}) {
+    const std::string tuple =
+        StrCat({R"json({"charging": false, "level": )json", level,
+                R"json(, "charging_time": "Infinity",
+                        "discharging_time": 60})json"});
+    EXPECT_FALSE(ParseBatteryStatus(tuple, &status, &error)) << level;
+  }
+  // Negative and non-finite times.
+  EXPECT_FALSE(ParseBatteryStatus(
+      R"json({"charging": false, "level": 0.5,
+              "charging_time": "Infinity", "discharging_time": -1})json",
+      &status, &error));
+  EXPECT_FALSE(ParseBatteryStatus(
+      R"json({"charging": false, "level": 0.5,
+              "charging_time": "Infinity", "discharging_time": "soon"})json",
+      &status, &error));
+}
+
+// A full battery cannot have a finite non-zero time until full, and this is the
+// case a hand-written tuple gets wrong most easily: level 1 with the charging
+// time left over from the value it was copied from.
+TEST(XrioPersonaTest, BatteryStatusRefusesFullWithATimeUntilFull) {
+  BatteryStatus status;
+  std::string error;
+  EXPECT_FALSE(ParseBatteryStatus(
+      R"json({"charging": true, "level": 1.0,
+              "charging_time": 600, "discharging_time": "Infinity"})json",
+      &status, &error));
+  EXPECT_NE(std::string::npos, error.find("charging at level 1")) << error;
+  // Infinity is not a way around it either: a full battery being charged has a
+  // KNOWN time to full, and it is zero.
+  EXPECT_FALSE(ParseBatteryStatus(
+      R"json({"charging": true, "level": 1.0,
+              "charging_time": "Infinity", "discharging_time": "Infinity"})json",
+      &status, &error));
+  // Zero is the coherent form -- and note what it is: it is exactly upstream's
+  // no-battery default (charging, full, 0 to full, Infinity to empty). Valid,
+  // and pointless as a persona, which is worth knowing before someone
+  // configures it and measures nothing.
+  ASSERT_TRUE(ParseBatteryStatus(
+      R"json({"charging": true, "level": 1.0,
+              "charging_time": 0, "discharging_time": "Infinity"})json",
+      &status, &error))
+      << error;
+  EXPECT_EQ(0.0, status.charging_time);
+}
