+}
+
+const char* GlVendor() {
+  // Safe to hand out: ActiveGlTable() retains every table it parses, so the
+  // pointer outlives any reconfiguration. The header's `const char*` contract
+  // exists so the WebGL patch can reuse Blink's String(const char*)
+  // construction verbatim, and it survives the move off a compiled constant.
+  const GlTable* table = ActiveGlTable();
+  if (!table) {
+    return nullptr;
+  }
+  // knob -> artifact -> untouched. The knob is refused without a persona at
+  // validation time, and this early return means it could not take effect
+  // anyway: a string over an honest capability table is the contradiction the
+  // persona gate exists to prevent.
+  if (const char* from_knob = InternedKnobString("gl-vendor")) {
+    return from_knob;
+  }
+  return table->vendor().c_str();
+}
