+// The expected-class contract. Four ways a placement can fail to honour a
+// profile's identity, and the compatible case.
+//
+// The table is pinned to ONE row per arm wherever the drawn value has to be
+// known: the shipped nine-row table draws a host-dependent class, and a test
+// that asserted a specific row from it would pass or fail on the machine
+// running the test rather than on the code.
+TEST(XrioPersonaTest, AnIncompatiblePlacementIsRefused) {
+  const unsigned host = HostThreadCeiling();
+  const std::string cores = NumberToString(host);
+  // One row, sized to this host, so the draw is deterministic and the ceiling
+  // in the expectations below is honourable.
+  const std::string table = StrCat({"[[", cores, ",16,250,1]]"});
+  // Captures NOTHING: every value this builds comes from its own parameters.
+  // `[&cores]` was here and unused, which is -Werror,-Wunused-lambda-capture --
+  // so base_unittests did not compile at all, and the gate that runs them could
+  // not have passed on any host.
+  const auto expect = [](std::string_view version,
+                         std::string_view persona,
+                         std::string_view ceiling,
+                         std::string_view row) {
+    return StrCat({"{\"version\":", version, ",\"persona\":\"", persona,
+                   "\",\"ceiling\":", ceiling, ",\"class\":", row, "}"});
+  };
+  const std::string row = StrCat({"[", cores, ",16,250]"});
+
+  // NOTHING SET IS NOTHING ENFORCED, and that is every deployment today.
+  XrioConfig::Get().SetAll({{"seed", "0x1111"}, {"machine-classes", table}});
+  EXPECT_FALSE(MachineClassExpectationProblem().has_value());
+
+  // The compatible case: the same version, the same persona, a ceiling this
+  // host can honour, and the row that draw produces.
+  XrioConfig::Get().SetAll(
+      {{"seed", "0x1111"},
+       {"machine-classes", table},
+       {"machine-class-expect", expect("1", "", cores, row)}});
+  EXPECT_FALSE(MachineClassExpectationProblem().has_value())
+      << MachineClassExpectationProblem().value_or("");
+
+  // 1. The algorithm moved. A version this build does not implement cannot be
+  //    honoured OR refuted, so it is refused rather than re-drawn.
+  XrioConfig::Get().SetAll(
+      {{"seed", "0x1111"},
+       {"machine-classes", table},
+       {"machine-class-expect", expect("99", "", cores, row)}});
+  ASSERT_TRUE(MachineClassExpectationProblem().has_value());
+  EXPECT_NE(std::string::npos,
+            MachineClassExpectationProblem()->find("selection version"));
+
+  // 2. A different persona is refused.
+  XrioConfig::Get().SetAll(
+      {{"seed", "0x1111"},
+       {"machine-classes", table},
+       {"machine-class-expect", expect("1", "some-other-box", cores, row)}});
+  ASSERT_TRUE(MachineClassExpectationProblem().has_value());
+  EXPECT_NE(std::string::npos,
+            MachineClassExpectationProblem()->find("gl-persona"));
+
+  // 3. The table moved under a seed that still draws. Same version, same
+  //    persona, an honourable ceiling -- and a row this configuration does not
+  //    produce.
+  XrioConfig::Get().SetAll(
+      {{"seed", "0x1111"},
+       {"machine-classes", table},
+       {"machine-class-expect", expect("1", "", cores, "[2,4,64]")}});
+  ASSERT_TRUE(MachineClassExpectationProblem().has_value());
+  EXPECT_NE(std::string::npos,
+            MachineClassExpectationProblem()->find("draws"));
+
+  // An expectation with no seed can never be honoured: nothing is drawn at all.
+  // Refused rather than silently ignored, which is the failure mode this whole
+  // knob is arranged against.
+  XrioConfig::Get().SetAll(
+      {{"machine-classes", table},
+       {"machine-class-expect", expect("1", "", cores, row)}});
+  ASSERT_TRUE(MachineClassExpectationProblem().has_value());
+  EXPECT_NE(std::string::npos,
+            MachineClassExpectationProblem()->find("--xrio-seed"));
+  XrioConfig::Get().SetAll({});
+}
