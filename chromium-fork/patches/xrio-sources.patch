+enum class Source { kSet, kDefault, kUmbrella, kDerived, kAbsent };
+
+// The raw string a knob resolves to, following umbrella defaults. nullopt for a
+// knob whose default is absent and whose key is unset.
+std::optional<std::string> Effective(std::string_view key, Source* source) {
+  const Knob* knob = FindKnob(key);
+  if (!knob) {
+    if (source) {
+      *source = Source::kAbsent;
+    }
+    return std::nullopt;
+  }
+  const Knob* current = knob;
+  for (int hop = 0; hop < kMaxUmbrellaHops; ++hop) {
+    if (XrioConfig::Get().Has(current->key)) {
+      // An explicit value stops the chain: a sub-knob set on the command line
+      // beats its umbrella, which is the whole point of having both.
+      if (source) {
+        *source = current == knob ? Source::kSet : Source::kUmbrella;
+      }
+      return XrioConfig::Get().GetString(current->key);
+    }
+    if (current->type == KnobType::kDerived) {
+      if (source) {
+        *source = Source::kDerived;
+      }
+      return std::nullopt;
+    }
+    if (current->default_value.empty()) {
+      if (source) {
+        *source = Source::kDefault;
+      }
+      return std::nullopt;
+    }
+    if (current->default_value.front() != kUmbrellaPrefix) {
+      if (source) {
+        *source = current == knob ? Source::kDefault : Source::kUmbrella;
+      }
+      return std::string(current->default_value);
+    }
+    const std::string_view parent = current->default_value.substr(1);
+    const Knob* next = FindKnob(parent);
+    // A row naming a key that does not exist is a code defect, not a
+    // configuration one, and it would otherwise present as a surface silently
+    // stuck on its umbrella's default.
+    CHECK(next) << "xrio knob '" << current->key << "' defers to unknown key '"
+                << parent << "'";
+    current = next;
+  }
+  // Not a configuration error: the registry is a compile-time table and
+  // check_knobs.py rejects a cycle in it, so reaching this is a code defect.
+  NOTREACHED() << "xrio knob '" << key << "' has a cyclic umbrella chain";
+}
+
+const Knob& Require(std::string_view key) {
+  const Knob* knob = FindKnob(key);
+  // A call site naming an unregistered key would read as a defaulted surface,
+  // which is the failure this whole file exists to end. Loud, immediately, on
+  // the first launch.
+  CHECK(knob) << "xrio knob '" << key << "' is not in the registry";
+  return *knob;
+}
+
+std::string RequireValue(std::string_view key) {
+  std::optional<std::string> raw = Effective(key, nullptr);
+  CHECK(raw.has_value()) << "xrio knob '" << key
+                         << "' has no default; the call site wants GetOptional*";
+  return *raw;
+}
+
+// ---------------------------------------------------------------------------
+// Retained caches. Lock-free on the hit path, a lock only when the generation
+// moved -- which happens at most once in a real process (the mojo push).
+//
+// The generation is stored as `generation + 1` so that a zero-initialised
+// atomic means "never primed": generation 0 is a real value, held by every
+// process before its first read.
+
+template <typename T>
+class RetainedCache {
+ public:
+  // Returns the cached value for the current generation, building it with
+  // `build` on a miss. The returned reference is valid for the life of the
+  // process: everything ever built is retained.
+  template <typename Build>
+  const T& Get(Build build) {
+    const uint32_t generation = XrioConfig::Get().generation();
+    if (primed_.load(std::memory_order_acquire) == generation + 1) {
+      const T* hit = current_.load(std::memory_order_relaxed);
+      if (hit) {
+        return *hit;
+      }
+    }
+    auto fresh = std::make_unique<T>(build());
+    const T* published = fresh.get();
+    {
+      AutoLock guard(lock_);
+      retained_.push_back(std::move(fresh));
+    }
+    // Publish the pointer BEFORE the generation, and read them in the opposite
+    // order, so a reader that sees the new generation cannot see a stale
+    // pointer. Two threads racing on a cold cache build identical values from
+    // identical inputs, so whichever lands last is the same as the other and
+    // the loser stays retained rather than dangling.
+    current_.store(published, std::memory_order_release);
+    primed_.store(generation + 1, std::memory_order_release);
+    return *published;
+  }
+
+ private:
+  std::atomic<uint32_t> primed_{0};
+  std::atomic<const T*> current_{nullptr};
+  Lock lock_;
+  std::vector<std::unique_ptr<T>> retained_ GUARDED_BY(lock_);
+};
+
+PerturbTuning BuildTuning() {
+  PerturbTuning tuning;
+  const auto seed_of = [](std::string_view key) {
+    uint64_t parsed = 0;
+    const std::string raw = RequireValue(key);
+    // Validated at startup, so a failure here means a unit test installed a map
+    // that never went through ValidateConfig. Fall back to the registry default
+    // rather than to zero, which would read as "unset" and disable a surface.
+    if (!ParseSeed(raw, &parsed)) {
+      CHECK(ParseSeed(Require(key).default_value, &parsed));
+    }
+    return parsed;
+  };
+  const auto int_of = [](std::string_view key) {
+    int64_t parsed = 0;
+    const std::string raw = RequireValue(key);
+    if (!ParseInt(raw, &parsed)) {
+      CHECK(ParseInt(Require(key).default_value, &parsed));
+    }
+    return parsed;
+  };
+  const auto double_of = [](std::string_view key) {
+    double parsed = 0.0;
+    const std::string raw = RequireValue(key);
+    if (!ParseDouble(raw, &parsed)) {
+      CHECK(ParseDouble(Require(key).default_value, &parsed));
+    }
+    return parsed;
+  };
+
+  tuning.hash_mix_1 = seed_of("hash-mix-1");
+  tuning.hash_mix_2 = seed_of("hash-mix-2");
+  tuning.hash_shift = static_cast<uint64_t>(int_of("hash-shift"));
+  tuning.seed_tag_basis = seed_of("seed-tag-basis");
+  tuning.seed_tag_prime = seed_of("seed-tag-prime");
+  tuning.seed_zero_substitute = seed_of("seed-zero-substitute");
+  tuning.coord_mixer = seed_of("coord-mixer");
+  tuning.audio_channel_mixer = seed_of("audio-channel-mixer");
+
+  tuning.pixel_rate_mask = static_cast<uint64_t>(int_of("pixel-rate-mask"));
+  tuning.pixel_rate_phase = static_cast<uint64_t>(int_of("pixel-rate-phase"));
+  // A phase outside the mask selects nothing at all, so every pixel would keep
+  // its constant value. Validation cannot catch it -- the two knobs are only
+  // incoherent together -- so fold it here, where both are in hand.
+  tuning.pixel_rate_phase &= tuning.pixel_rate_mask;
+  tuning.pixel_bit_mask = static_cast<uint8_t>(int_of("pixel-bit-mask"));
+  // Draw the channel choice from bits above the ones the rate decision
+  // consumed, or the two decisions correlate and only one channel ever moves.
+  tuning.channel_shift = 0;
+  for (uint64_t mask = tuning.pixel_rate_mask; mask != 0; mask >>= 1) {
+    ++tuning.channel_shift;
+  }
+
+  tuning.audio_scale_floor = double_of("audio-scale-floor");
+  tuning.audio_scale_span = double_of("audio-scale-span");
+  tuning.jitter_quantum = double_of("jitter-quantum");
+  tuning.jitter_steps = int_of("jitter-steps");
+  tuning.jitter_step_size = double_of("jitter-step-size");
+  return tuning;
+}
+
+std::vector<MachineClass> ParseMachineClasses(const std::string& raw) {
+  std::vector<MachineClass> classes;
+  std::optional<ListValue> parsed = JSONReader::ReadList(raw, JSON_PARSE_RFC);
+  if (!parsed.has_value()) {
+    // ValidateConfig refuses the launch over this, so reaching it means a unit
+    // test installed a map directly. Empty is the fail-closed answer: upstream's
+    // own cores and memory, never a partial table.
+    return classes;
+  }
+  for (const Value& entry : *parsed) {
+    const ListValue* row = entry.GetIfList();
+    // FOUR OR FIVE. The fifth is the optional chassis; see FormFactor in
+    // xrio_knobs.h for why it cannot be required.
+    if (!row || (row->size() != 4 && row->size() != 5)) {
+      return {};
+    }
+    std::optional<int> cores = (*row)[0].GetIfInt();
+    std::optional<double> memory = (*row)[1].GetIfDouble();
+    std::optional<int> disk = (*row)[2].GetIfInt();
+    std::optional<int> weight = (*row)[3].GetIfInt();
+    if (!cores.has_value() || !memory.has_value() || !disk.has_value() ||
+        !weight.has_value() || *cores < 1 ||
+        !IsReportableDeviceMemory(*memory) || *disk < 1 ||
+        *weight < 1) {
+      return {};
+    }
+    FormFactor form_factor = FormFactor::kUnspecified;
+    if (row->size() == 5) {
+      const std::string* chassis = (*row)[4].GetIfString();
+      if (!chassis) {
+        return {};
+      }
+      if (*chassis == "laptop") {
+        form_factor = FormFactor::kLaptop;
+      } else if (*chassis == "desktop") {
+        form_factor = FormFactor::kDesktop;
+      } else {
+        // FAIL CLOSED ON A TYPO rather than reading it as unspecified. Treating
+        // "Laptop" or "notebook" as "says nothing" would silently switch off
+        // the consistency rule this column exists to turn on, which is the
+        // worst of the three outcomes: the operator asked for a chassis, the
+        // table looks configured, and nothing checks it.
+        return {};
+      }
+    }
+    classes.push_back({static_cast<unsigned>(*cores),
+                       static_cast<float>(*memory),
+                       static_cast<unsigned>(*disk),
+                       static_cast<unsigned>(*weight), form_factor});
+  }
+  return classes;
+}
+
+std::vector<MachineClass> BuildMachineClasses() {
+  return ParseMachineClasses(RequireValue("machine-classes"));
+}
