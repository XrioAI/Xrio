+const std::string* RequiredString(const DictValue& dict,
+                                  std::string_view key,
+                                  std::string* error) {
+  const std::string* value = dict.FindString(key);
+  if (!value || value->empty()) {
+    *error = StrCat({"field '", key, "' is missing, not a string, or empty"});
+    return nullptr;
+  }
+  return value;
+}
+
+bool RequiredBool(const DictValue& dict,
+                  std::string_view key,
+                  bool* out,
+                  std::string* error) {
+  std::optional<bool> value = dict.FindBool(key);
+  if (!value.has_value()) {
+    *error = StrCat({"field '", key, "' is missing or not a bool"});
+    return false;
+  }
+  *out = *value;
+  return true;
+}
+
+bool NameIsUsable(std::string_view name) {
+  const int64_t max_length = GetInt("speech-persona-max-name");
+  if (name.empty() || max_length < 1 ||
+      name.size() > static_cast<size_t>(max_length) || name.front() == '.') {
+    return false;
+  }
+  return std::all_of(name.begin(), name.end(), [](char c) {
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+           (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-';
+  });
+}
+
+size_t MaxTableBytes() {
+  const int64_t configured = GetInt("gl-table-max-bytes");
+  return configured > 0 ? static_cast<size_t>(configured) : 0u;
+}
+
+std::optional<FilePath> SpeechPath(const std::string& name,
+                                   const std::string& dir_override) {
+  if (!NameIsUsable(name)) {
+    return std::nullopt;
+  }
+  FilePath dir;
+  if (!dir_override.empty()) {
+    dir = FilePath::FromUTF8Unsafe(dir_override);
+  } else if (!PathService::Get(DIR_EXE, &dir)) {
+    return std::nullopt;
+  } else {
+    dir = dir.AppendASCII(GetString("persona-dir-name"));
+  }
+  return dir.AppendASCII(StrCat({name, GetString("speech-table-suffix")}));
+}
+
+std::optional<std::string> ReadSpeechBody(const std::string& name,
+                                          const std::string& dir_override) {
+  std::optional<FilePath> path = SpeechPath(name, dir_override);
+  if (!path) {
+    return std::nullopt;
+  }
+  static NoDestructor<Lock> lock;
+  static NoDestructor<flat_map<FilePath, std::optional<std::string>>> cache;
+  AutoLock guard(*lock);
+  auto found = cache->find(*path);
+  if (found != cache->end()) {
+    return found->second;
+  }
+  std::string body;
+  std::optional<std::string> result;
+  if (ReadFileToStringWithMaxSize(*path, &body, MaxTableBytes())) {
+    result = std::move(body);
+  }
+  cache->insert({*path, result});
+  return result;
+}
+
+bool EventTypeFromName(std::string_view name, SpeechEventType* out) {
+  if (name == "start") {
+    *out = SpeechEventType::kStart;
+  } else if (name == "end") {
+    *out = SpeechEventType::kEnd;
+  } else if (name == "error") {
+    *out = SpeechEventType::kError;
+  } else {
+    return false;
+  }
+  return true;
+}
+
+struct BrowserTableCache {
+  Lock lock;
+  std::string name GUARDED_BY(lock);
+  std::string body GUARDED_BY(lock);
+  raw_ptr<const SpeechTable> active GUARDED_BY(lock) = nullptr;
+  std::vector<std::unique_ptr<SpeechTable>> retained GUARDED_BY(lock);
+};
+
+BrowserTableCache& GetBrowserTableCache() {
+  static NoDestructor<BrowserTableCache> cache;
+  return *cache;
+}
