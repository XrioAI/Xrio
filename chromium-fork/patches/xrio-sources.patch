+
+TEST(XrioPersonaTest, MachineProfileFailsClosed) {
+  XrioConfig::Get().SetAll({});
+  EXPECT_FALSE(HardwareConcurrency().has_value());
+  EXPECT_FALSE(DeviceMemoryGb().has_value());
+}
+
+TEST(XrioPersonaTest, MachineProfileIsStableForOneSeed) {
+  XrioConfig::Get().SetAll({{"seed", "0x1111"}});
+  const unsigned cores = HardwareConcurrency().value();
+  const float memory = DeviceMemoryGb().value();
+  EXPECT_EQ(cores, HardwareConcurrency().value());
+  EXPECT_EQ(memory, DeviceMemoryGb().value());
+}
+
+// The measured defect: every fresh profile reported 12 cores and 8 GB. If this
+// does not spread, the fork has not fixed the thing it was added for.
+TEST(XrioPersonaTest, MachineProfileVariesAcrossSeeds) {
+  std::set<unsigned> cores;
+  for (int i = 0; i < 64; ++i) {
+    XrioConfig::Get().SetAll({{"seed", "0x" + std::to_string(1000 + i)}});
+    cores.insert(HardwareConcurrency().value());
+  }
+  EXPECT_GT(cores.size(), 2u) << "core count collapsed to one value";
+}
+
+// A 12-core box reporting 4 GB is not a machine anyone owns. Incoherence is a
+// worse signal than the constant it replaced.
+TEST(XrioPersonaTest, CoresAndMemoryStayCoherent) {
+  for (int i = 0; i < 128; ++i) {
+    XrioConfig::Get().SetAll({{"seed", "0x" + std::to_string(2000 + i)}});
+    const unsigned cores = HardwareConcurrency().value();
+    const float memory = DeviceMemoryGb().value();
+    EXPECT_GE(cores, 4u);
+    EXPECT_LE(cores, 24u);
+    // Powers of two inside Chrome's DESKTOP clamp of [2, 32]. The 8 GB ceiling
+    // is Android-only; this build reported 16 on a 24 GB host.
+    EXPECT_TRUE(memory == 8.0f || memory == 16.0f || memory == 32.0f)
+        << "memory=" << memory;
+    // A 12-core box with 8 GB is not a machine anyone owns.
+    if (cores >= 12) {
+      EXPECT_GE(memory, 16.0f) << cores << " cores with " << memory << " GB";
+    }
+  }
+}
+
+// Every one of these is a knob now, and every default reproduces the `return
+// true` it replaced. That is the whole safety argument for the conversion: a
+// launch with no flags must behave exactly as the previous build did.
+//
+// The two readback gates are the deliberate exceptions -- they were made
+// persona-conditional after this test was written, and canvas2d now ships off
+// entirely. Both are asserted here in their no-flags state so the exception
+// stays visible rather than being dropped from the list.
+TEST(XrioPersonaTest, IdentityAndSuppressionDefaultsReproduceTheOldConstants) {
+  XrioConfig::Get().SetAll({});
+  EXPECT_TRUE(ForceWebdriverFalse());
+  EXPECT_TRUE(SuppressHeadlessToken());
+  EXPECT_TRUE(SuppressVariationsFetch());
+  EXPECT_TRUE(SuppressNetworkTimeQuery());
+  EXPECT_TRUE(SuppressIntranetRedirectProbe());
+  EXPECT_TRUE(SuppressOutdatedBuildDetector());
+  EXPECT_TRUE(SuppressFirstRunImport());
+  EXPECT_TRUE(SuppressFrameworkDetection());
+  EXPECT_TRUE(SuppressBeforeunloadDialogs());
+  EXPECT_TRUE(BeforeunloadAutoAccept());
+  EXPECT_TRUE(PopupOpensAsForegroundTab());
+  EXPECT_TRUE(SuppressStartupInfobars());
+  // The one identity-shaped row that defaults FALSE. See
+  // HeadfulPermissionPromptsInHeadlessShipOff below for why the asymmetry with
+  // the four above it is correct rather than an oversight.
+  EXPECT_FALSE(HeadfulPermissionPromptsEnabled());
+  // NOT true, and deliberately so -- the gate ANDs with GlPersonaActive(), and
+  // this arm sets no persona. perturb-canvas additionally defaults to false.
+  // The full matrix (seed alone / seed+persona / the canvas opt-in) is
+  // ReadbackPerturbationNeedsThePersona below; asserting the old unconditional
+  // `return true` here contradicted it. There is no GL readback gate to assert
+  // beside it any more -- `perturb-gl-readback` was removed 2026-09-07.
+  EXPECT_FALSE(PerturbCanvasEnabled());
+  // NOR are these, since 2026-09-09. `perturb-audio` and both of its children
+  // default FALSE: the scale reaches every sample of a completed buffer, so a
+  // page rendering a signal it already knows reads its own input back
+  // multiplied by a number no node applied. Retained as an opt-in; asserted
+  // here in the no-flags state so the default cannot drift back silently.
+  // AudioDefaultsOffAndTheOptInStillWorks below is the full matrix.
+  EXPECT_FALSE(PerturbAudioBuffersEnabled());
+  EXPECT_FALSE(PerturbOfflineAudioEnabled());
+  EXPECT_EQ("disable_non_proxied_udp", WebRtcIpHandlingPolicy());
+  std::optional<std::string> brand;
+  OverrideUserAgentBrand(&brand);
+  EXPECT_EQ("Google Chrome", brand.value());
+}
+
+// And each is reachable. Before this conversion none of them was: the only way
+// to find out what a target did without the Headless-token removal or without
+// the WebRTC posture was a five-hour rebuild.
+TEST(XrioPersonaTest, IdentityKnobsCanBeTurnedOff) {
+  XrioConfig::Get().SetAll({{"webdriver-false", "false"},
+                           {"suppress-headless-token", "0"},
+                           {"webrtc-ip-handling-policy", "default"}});
+  EXPECT_FALSE(ForceWebdriverFalse());
+  EXPECT_FALSE(SuppressHeadlessToken());
+  EXPECT_EQ("default", WebRtcIpHandlingPolicy());
+
+  // An empty ua-brand is the off switch, and it must leave the caller's value
+  // ALONE rather than clearing it -- upstream's own brand is what stands.
+  XrioConfig::Get().SetAll({{"ua-brand", ""}});
+  std::optional<std::string> brand = "Chromium";
+  OverrideUserAgentBrand(&brand);
+  EXPECT_EQ("Chromium", brand.value());
+
+  XrioConfig::Get().SetAll({{"ua-brand", "Brave"}});
+  OverrideUserAgentBrand(&brand);
+  EXPECT_EQ("Brave", brand.value());
+  XrioConfig::Get().SetAll({});
+}
+
+TEST(XrioPersonaTest, HrefTranslateDefaultsOnAndCanBeTurnedOff) {
+  XrioConfig::Get().SetAll({});
+  EXPECT_TRUE(ExposeHrefTranslate());
+
+  XrioConfig::Get().SetAll({{"href-translate", "false"}});
+  EXPECT_FALSE(ExposeHrefTranslate());
+  XrioConfig::Get().SetAll({});
+}
+
+// The umbrella is the reason splitting one boolean into six did not become six
+// flags to turn one thing off.
+TEST(XrioPersonaTest, SuppressionUmbrellasResolveBothWays) {
+  XrioConfig::Get().SetAll({{"suppress-background-fetches", "false"}});
+  EXPECT_FALSE(SuppressVariationsFetch());
+  EXPECT_FALSE(SuppressNetworkTimeQuery());
+  EXPECT_FALSE(SuppressFirstRunImport());
+  EXPECT_FALSE(SuppressFrameworkDetection());
+
+  // A member set explicitly beats its umbrella. This is the case that used to be
+  // impossible: one behaviour on while the rest of the group is off.
+  XrioConfig::Get().SetAll({{"suppress-background-fetches", "false"},
