+// A knob string handed out as `const char*`, interned so the pointer outlives
+// the call.
+//
+// The `const char*` return of GlVendor()/GlRenderer() is a contract the WebGL
+// patch depends on -- it constructs `String(xrio_renderer)` directly -- and
+// GetString() returns a temporary, so a view into it would dangle. Interning in
+// a never-destroyed std::set works because set never invalidates references to
+// its elements on insert; a vector's would move.
+//
+// Never freed, and the ceiling is two entries per process (one vendor, one
+// renderer), plus one per distinct value a unit test installs. Locked because
+// two renderer threads can reach a getParameter concurrently.
+//
+// nullopt-shaped: an empty value returns nullptr, meaning "fall back", which is
+// the registry's documented reading of an absent kString knob. There is
+// deliberately no sentinel like "-": a second spelling of absent is how two call
+// sites end up disagreeing about what unset means.
+const char* InternedKnobString(std::string_view key) {
+  std::string value = GetString(key);
+  if (value.empty()) {
+    return nullptr;
+  }
+  static NoDestructor<Lock> lock;
+  static NoDestructor<std::set<std::string>> pool;
+  AutoLock guard(*lock);
+  return pool->insert(std::move(value)).first->c_str();
+}
+
+// The machine class this profile draws, or nullptr.
+//
+// The nine-row table used to be a constexpr array right here, which made the
+// complete set of machines this fleet could claim an attribute of the BINARY:
+// hardwareConcurrency, deviceMemory and (until 2026-09-29) the storage quota
+// were all drawn from 36 literals, so no seed could widen the reportable set
+// past nine buckets and re-measuring it cost a five-hour rebuild. It is the
+// `machine-classes` knob now, with those exact nine rows as the default.
+//
+// deviceMemory in that table is what Chrome REPORTS, not what is installed: it
+// is rounded to a power of two and clamped to [2, 32]. MEASURED, and it corrects
+// an earlier comment here: the 8 GB ceiling is ANDROID-ONLY --
+// approximated_device_memory.cc sets kMaxMemory = 32.0f and only drops it to
+// 8.0f under BUILDFLAG(IS_ANDROID). This build reported 16 on a 24 GB host, and
+// basharsx4 reporting 8 was its honest value (7 GB of RAM), not a cap. An
+// earlier version of the table claimed 4 or 8 for every class, which would have
+// had the entire fleet posing as low-end machines.
+
+std::atomic<unsigned> g_host_thread_ceiling_for_testing{0};
+
+}  // namespace
+
+void SetHostThreadCeilingForTesting(unsigned ceiling) {
+  g_host_thread_ceiling_for_testing.store(ceiling, std::memory_order_relaxed);
+}
+
+unsigned HostThreadCeiling() {
+  if (const unsigned forced =
+          g_host_thread_ceiling_for_testing.load(std::memory_order_relaxed)) {
+    return forced;
+  }
+  const int processors = SysInfo::NumberOfProcessors();
+  // NumberOfProcessors() is documented to be at least 1 and has returned 0 on
+  // misconfigured containers. Clamp rather than trust it: a ceiling of 0 drops
+  // every row and turns a persona into upstream's own numbers silently, which
+  // is the failure mode this cap exists to make impossible.
+  return processors > 0 ? static_cast<unsigned>(processors) : 1u;
+}
+
+unsigned MachineClassCeiling() {
+  unsigned ceiling = HostThreadCeiling();
+  // EffectiveGlTable(), not ActiveGlTable(): the browser process emits the
+  // Device-Memory client hint and has no pushed map to read the table from, so
+  // reading only the renderer-side one would let the two processes draw
+  // different classes from one seed. See InstallBrowserGlTable.
+  if (const GlTable* table = EffectiveGlTable()) {
+    if (table->max_threads() > 0 && table->max_threads() < ceiling) {
+      ceiling = table->max_threads();
+    }
+  }
+  return ceiling;
+}
+
+namespace {
+
+// THE DRAW, and the only implementation of it. Split out from PickMachineClass()
+// so the expectation check below can reproduce a draw taken on ANOTHER host --
+// which means passing the seed and the ceiling in rather than reading the live
+// ones. Two implementations of one algorithm is exactly how the font stack came
+// to have two answers for one question (tools/check_fontstack.py), so there is
+// one function and two callers.
+const MachineClass* DrawMachineClass(span<const MachineClass> classes,
+                                     uint64_t seed,
+                                     unsigned ceiling) {
+  // THE CEILING IS APPLIED BEFORE THE ROLL, not after. Filtering the drawn
+  // result would make one class absorb every rejected draw; filtering the table
+  // renormalises the weights across the rows that remain, which is what the
+  // table means. The consequence is worth stating: the same seed draws
+  // different classes on hosts of different size, because the surviving weights
+  // differ -- which is what `machine-class-expect` exists to refuse rather than
+  // to absorb.
+  uint64_t total = 0;
+  for (const MachineClass& m : classes) {
+    if (m.cores <= ceiling) {
+      total += m.weight;
+    }
+  }
+  if (total == 0) {
+    return nullptr;
+  }
+  uint64_t roll = seed % total;
+  for (const MachineClass& m : classes) {
+    if (m.cores > ceiling) {
+      continue;
+    }
+    if (roll < m.weight) {
+      return &m;
+    }
+    roll -= m.weight;
+  }
+  // Unreachable while `roll < total`, which the loop above guarantees. It used
+  // to `return &kMachineClasses[0]`, which would have had every profile in the
+  // fleet claiming a 4-core/8 GB/120 GB box -- a substituted constant, and the
+  // one thing this file is not allowed to do. nullptr is the fail-closed answer.
+  return nullptr;
+}
+
+const MachineClass* PickMachineClass() {
+  const span<const MachineClass> classes = MachineClasses();
+  if (classes.empty()) {
+    // Only reachable from a unit test that installed a map without going
+    // through ValidateConfig, which refuses a malformed table at launch. Fail
+    // closed: upstream's own cores and memory.
+    return nullptr;
+  }
+  std::optional<uint64_t> seed = Seed(GetString("seed-purpose-machine"));
+  if (!seed.has_value()) {
+    return nullptr;
+  }
+  return DrawMachineClass(classes, seed.value(), MachineClassCeiling());
+}
