+}  // namespace
+
+std::optional<std::string> MachineClassTableProblem() {
+  if (XrioConfig::Get().GetString("machine-classes").empty()) {
+    return std::nullopt;
+  }
+  const unsigned ceiling = MachineClassCeiling();
+  for (const MachineClass& m : MachineClasses()) {
+    if (m.cores <= ceiling) {
+      return std::nullopt;
+    }
+  }
+  return StrCat({"--xrio-machine-classes has no row at or below ",
+                 NumberToString(ceiling), " cores, which is ",
+                 ceiling < HostThreadCeiling()
+                     ? "the GL persona's max_threads"
+                     : "this host's processor count",
+                 ". Every row would claim a machine a page can rule out by "
+                 "counting workers."});
+}
+
+std::optional<std::string> MachineClassExpectationProblem() {
+  const std::string raw = GetString("machine-class-expect");
+  if (raw.empty()) {
+    // NOTHING TO ENFORCE, and that is the default. The fork has no memory of a
+    // previous host, so it cannot invent an expectation -- absent means this
+    // launch draws whatever this host draws, which is the behaviour every
+    // deployment has today. fork/IMPLEMENTATION_ANSWERS.md 5.
+    return std::nullopt;
+  }
+  // ValidateConfig has already refused a malformed value through
+  // MachineClassExpectation(), so every field below is present and typed.
+  // Re-checking would be a second implementation of the same rule; a
+  // std::nullopt here means the map was installed without validation, which is
+  // a unit test, and refusing with a clear message is right for that too.
+  std::optional<DictValue> parsed =
+      JSONReader::ReadDict(raw, JSON_PARSE_RFC);
+  if (!parsed.has_value()) {
+    return "--xrio-machine-class-expect is not a JSON object";
+  }
+  const std::optional<int> version = parsed->FindInt("version");
+  const std::optional<int> ceiling = parsed->FindInt("ceiling");
+  const std::string* persona = parsed->FindString("persona");
+  const ListValue* row = parsed->FindList("class");
+  if (!version || !ceiling || !persona || !row || row->size() != 3) {
+    return "--xrio-machine-class-expect is missing a field it needs "
+           "(version, ceiling, persona, class)";
+  }
+
+  // 1. THE ALGORITHM. An expectation is a claim about what one function
+  //    returns; replayed against a different function it means nothing, and
+  //    silently re-drawing is the failure this knob exists to prevent.
+  if (*version != kMachineSelectionVersion) {
+    return StrCat({"--xrio-machine-class-expect was drawn under selection "
+                   "version ", NumberToString(*version), " and this build is ",
+                   NumberToString(kMachineSelectionVersion),
+                   ". The draw changed, so the expectation cannot be honoured "
+                   "or refuted -- re-draw the profile against this build."});
+  }
+
+  const std::string configured_persona = GetString("gl-persona");
+  if (*persona != configured_persona) {
+    return StrCat({"--xrio-machine-class-expect was drawn under gl-persona '",
+                   *persona, "' and this launch configures '",
+                   configured_persona, "'."});
+  }
+
+  std::optional<uint64_t> seed = Seed(GetString("seed-purpose-machine"));
+  if (!seed.has_value()) {
+    return "--xrio-machine-class-expect needs --xrio-seed: without one no class "
+           "is drawn at all, so the expectation can never be honoured.";
+  }
+  const unsigned live_ceiling = MachineClassCeiling();
+  const MachineClass* drawn = PickMachineClass();
+  if (!drawn) {
+    return StrCat({"--xrio-machine-class-expect cannot be honoured: no row in "
+                   "--xrio-machine-classes survives this launch's ceiling of ",
+                   NumberToString(live_ceiling), " cores."});
+  }
+  const std::optional<int> want_cores = (*row)[0].GetIfInt();
+  const std::optional<double> want_memory = (*row)[1].GetIfDouble();
+  const std::optional<int> want_disk = (*row)[2].GetIfInt();
+  const bool same =
+      want_cores && want_memory && want_disk &&
+      drawn->cores == static_cast<unsigned>(*want_cores) &&
+      drawn->memory_gb == static_cast<float>(*want_memory) &&
+      drawn->free_disk_gb == static_cast<unsigned>(*want_disk);
+  if (!same) {
+    return StrCat({"--xrio-machine-class-expect names [",
+                   NumberToString(want_cores.value_or(0)), ", ",
+                   NumberToString(want_memory.value_or(0)), ", ",
+                   NumberToString(want_disk.value_or(0)),
+                   "] drawn under a ceiling of ", NumberToString(*ceiling),
+                   ", and this launch draws [", NumberToString(drawn->cores),
+                   ", ", NumberToString(drawn->memory_gb), ", ",
+                   NumberToString(drawn->free_disk_gb),
+                   "] under a ceiling of ", NumberToString(live_ceiling),
+                   ". Schedule the profile where its class is drawn again, or "
+                   "re-draw it deliberately."});
+  }
+  return std::nullopt;
+}
