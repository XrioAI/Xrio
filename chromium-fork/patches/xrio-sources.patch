+TEST_F(XrioKnobsTest, ChannelShiftTracksTheRateMask) {
+  for (const auto& [mask, shift] : {std::pair<const char*, unsigned>{"0", 0u},
+                                    {"1", 1u},
+                                    {"7", 3u},
+                                    {"15", 4u},
+                                    {"255", 8u}}) {
+    XrioConfig::Get().SetAll({{"pixel-rate-mask", mask}});
+    EXPECT_EQ(shift, Tuning().channel_shift) << "mask " << mask;
+  }
+}
+
+// A phase outside its mask selects nothing, so every pixel would keep its
+// constant value. The two knobs are only incoherent together, so validation
+// cannot see it and the tuning folds it instead.
+TEST_F(XrioKnobsTest, RatePhaseIsFoldedIntoTheMask) {
+  XrioConfig::Get().SetAll({{"pixel-rate-mask", "7"},
+                           {"pixel-rate-phase", "99"}});
+  EXPECT_LE(Tuning().pixel_rate_phase, Tuning().pixel_rate_mask);
+  EXPECT_EQ(UINT64_C(3), Tuning().pixel_rate_phase);
+}
+
+TEST_F(XrioKnobsTest, TuningIsInvalidatedWhenTheConfigChanges) {
+  XrioConfig::Get().SetAll({});
+  EXPECT_EQ(UINT64_C(0x7), Tuning().pixel_rate_mask);
+  XrioConfig::Get().SetAll({{"pixel-rate-mask", "31"}});
+  EXPECT_EQ(UINT64_C(31), Tuning().pixel_rate_mask);
+  XrioConfig::Get().SetAll({});
+  EXPECT_EQ(UINT64_C(0x7), Tuning().pixel_rate_mask)
