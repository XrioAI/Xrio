+span<const Knob> Knobs() {
+  return span<const Knob>(kKnobs);
+}
+
+const Knob* FindKnob(std::string_view key) {
+  for (const Knob& knob : kKnobs) {
+    if (knob.key == key) {
+      return &knob;
+    }
+  }
+  return nullptr;
+}
+
+bool ValidateConfig(const XrioConfig::Map& map, std::string* error) {
+  CHECK(error);
+  for (const auto& [key, value] : map) {
+    const Knob* knob = FindKnob(key);
+    if (!knob) {
+      *error = StrCat({"--xrio-", key,
+                       " is not a knob this build reads. Run --xrio-dump-config "
+                       "for the list."});
+      return false;
+    }
+    if (knob->type == KnobType::kDerived) {
+      *error = StrCat({"--xrio-", key,
+                       " is derived by the browser process and may not be "
+                       "supplied from outside."});
+      return false;
+    }
+    bool parsed_ok = true;
+    switch (knob->type) {
+      case KnobType::kBool: {
+        bool ignored = false;
+        parsed_ok = ParseBool(value, &ignored);
+        break;
+      }
+      case KnobType::kInt: {
+        int64_t ignored = 0;
+        parsed_ok = ParseInt(value, &ignored);
+        break;
+      }
+      case KnobType::kDouble: {
+        double ignored = 0.0;
+        parsed_ok = ParseDouble(value, &ignored);
+        break;
+      }
+      case KnobType::kSeed: {
+        uint64_t ignored = 0;
+        parsed_ok = ParseSeed(value, &ignored);
+        break;
+      }
+      case KnobType::kJson:
+        parsed_ok = JSONReader::Read(value, JSON_PARSE_RFC).has_value();
+        break;
+      case KnobType::kString:
+        parsed_ok = true;
+        break;
+      case KnobType::kDerived:
+        NOTREACHED();
+    }
+    if (!parsed_ok) {
+      // std::to_array rather than a C array: base/ builds with
+      // -Wunsafe-buffer-usage as an error, and std::array's bounds-checked
+      // operator[] is the sanctioned way to index by an enum. Order tracks
+      // KnobType.
+      static constexpr auto kTypeNames = std::to_array<std::string_view>(
+          {"a boolean", "an integer", "a number",
+           "a non-zero seed (decimal, or 0x-prefixed hex)", "a string",
+           "a JSON document", "derived"});
+      *error = StrCat({"--xrio-", key, "='", value, "' is not ",
+                       kTypeNames[static_cast<size_t>(knob->type)], "."});
+      return false;
+    }
+    // An empty value is how a valueless switch harvests, so it is only
+    // meaningful for a bool. Skip the constraint for it on every other type,
+    // where it means "unset" -- refusing it would make `--xrio-persona-dir=`
+    // an error rather than a no-op.
+    if (knob->constraint && !(value.empty() && knob->type != KnobType::kBool)) {
+      std::string detail;
+      if (!knob->constraint(value, &detail)) {
+        *error = StrCat({"--xrio-", key, "='", value, "' ", detail, "."});
+        return false;
+      }
+    }
+  }
+
+  // The FIRST cross-key rule, and it needs the whole map rather than one value.
+  //
+  // gl-vendor and gl-renderer put a STRING in front of a capability table.
+  // Without a persona there is no table, so the string would sit over the
+  // honest one -- exactly the machine no driver produces that --xrio-gl-persona
+  // exists to prevent, and the same reason xrio refuses --gl-persona
+  // without --chrome-path. The accessors fail closed on this too (no table means
+  // no string at all); refusing here is what makes it an actionable startup
+  // error instead of a knob that reads as set and does nothing.
+  const auto set_and_nonempty = [&map](std::string_view key) {
+    const auto it = map.find(std::string(key));
+    return it != map.end() && !it->second.empty();
+  };
+  if ((set_and_nonempty("gl-vendor") || set_and_nonempty("gl-renderer")) &&
+      !set_and_nonempty("gl-persona")) {
+    *error =
+        "--xrio-gl-vendor and --xrio-gl-renderer need --xrio-gl-persona: a "
+        "spoofed string over an honest capability table is a machine no driver "
+        "produces.";
+    return false;
+  }
+
+  const auto configured = map.find("machine-classes");
+  const std::vector<MachineClass> classes =
+      (configured == map.end() || configured->second.empty())
+          ? std::vector<MachineClass>()
+          : ParseMachineClasses(configured->second);
+
+  // The THIRD cross-key rule, and the reason the fifth machine-class column is
+  // worth having: a chassis this build cannot answer consistently.
+  //
+  // `battery-status` is ONE tuple for the life of the process, not a per-row
+  // draw, so a table that names a chassis at all is checkable against it, and
+  // both directions are guaranteed contradictions rather than weak personas:
+  //
+  //   a `laptop` row and no battery -> getBattery() reports upstream's
+  //       batteryless desktop tuple (charging, level 1, 0 to full, Infinity to
+  //       empty) on a machine the rest of the persona calls a laptop. This is
+  //       the contradiction fork/OPEN_DECISIONS.md 2 was opened for, reached
+  //       through a GL artifact declaring form_factor `laptop` for a Ryzen
+  //       5000U while this knob stayed absent.
+  //   a `desktop` row and a battery -> the mirror, and just as readable.
+  //
+  // A four-field table declares no chassis and neither rule fires. That is the
+  // whole reason the column is optional: every configuration anybody has
+  // deployed is unaffected, and the refusal can only be reached by an operator
+  // who opted in by writing a fifth field.
+  //
+  // The mixed-table case is refused by the same two rules acting together, and
+  // correctly: one tuple cannot serve both chassis. Lifting that means drawing
+  // the battery from the DRAWN row, which is the fleet model and is blocked on
+  // time-series captures from admitted laptops -- fork/not-implemented.md
+  // section J.
+  if (!classes.empty()) {
+    const bool has_battery = set_and_nonempty("battery-status");
+    const auto declares = [&classes](FormFactor want) {
+      return std::any_of(
+          classes.begin(), classes.end(),
+          [want](const MachineClass& m) { return m.form_factor == want; });
+    };
+    if (declares(FormFactor::kLaptop) && !has_battery) {
+      *error =
+          "--xrio-machine-classes declares a `laptop` row while "
+          "--xrio-battery-status is absent, so getBattery() would report "
+          "upstream's batteryless DESKTOP tuple on a machine this persona "
+          "calls a laptop. Set a complete battery tuple, or drop the chassis "
+          "column from the table.";
+      return false;
+    }
+    if (declares(FormFactor::kDesktop) && has_battery) {
+      *error =
+          "--xrio-machine-classes declares a `desktop` row while "
+          "--xrio-battery-status is set, so a desktop would report a battery. "
+          "One tuple serves every drawn row; drawing it per row is the fleet "
+          "model, and that is not built (fork/not-implemented.md section J).";
+      return false;
+    }
+  }
+
+  const auto reads_true = [&map](std::string_view key, bool if_absent) {
+    const auto it = map.find(std::string(key));
+    if (it == map.end()) {
+      return if_absent;
+    }
+    bool parsed = false;
+    // A value that does not parse was already refused by the per-key loop
+    // above, so ParseBool cannot fail here; if it somehow did, treat the key
+    // as absent rather than as set.
+    return ParseBool(it->second, &parsed) ? parsed : if_absent;
+  };
+  const bool hardware_on = reads_true("spoof-hardware", true);
+  // The FOURTH cross-key rule: a hardware override beside the gate that
+  // discards it. `--xrio-hardware-concurrency=6 --xrio-spoof-hardware=false`
+  // was accepted and then reported nothing: HardwareConcurrency() checks the
+  // gate before the override, so the value an operator typed is discarded. The
+  // gate winning over an override is deliberate and stays that way -- one flag
+  // has to be able to retreat the surface whatever else is configured, and
+  // XrioPersonaTest.HardwareGateAndOverrides asserts exactly that -- but a
+  // command line that says both is a contradiction, and refusing it is how the
+  // operator finds out which half the browser was going to ignore.
+  if (!hardware_on) {
+    for (std::string_view key : {"hardware-concurrency", "device-memory"}) {
+      if (set_and_nonempty(key)) {
+        *error = StrCat({"--xrio-", key,
+                         " is set while --xrio-spoof-hardware is false, so the "
+                         "value would be discarded: the gate is checked before "
+                         "the override. Drop one of the two."});
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+std::string DescribeConfig() {
+  std::string out = StrCat({"xrio-knobs: ", NumberToString(std::size(kKnobs)),
+                            " knobs\n"});
+  for (const Knob& knob : kKnobs) {
+    Source source = Source::kAbsent;
+    std::optional<std::string> value = Effective(knob.key, &source);
+    std::string_view mark;
+    switch (source) {
+      case Source::kSet:
+        mark = "[set]";
+        break;
+      case Source::kDefault:
+        mark = "[def]";
+        break;
+      case Source::kUmbrella:
+        mark = "[umb]";
+        break;
+      case Source::kDerived:
+        mark = "[der]";
+        break;
+      case Source::kAbsent:
+        mark = "[???]";
+        break;
+    }
+    std::string shown;
+    if (knob.type == KnobType::kDerived) {
+      // A whole JSON artifact. Its presence and size are the useful facts; the
+      // body belongs in the envelope, keyed by the artifact's own digest.
+      const size_t bytes = XrioConfig::Get().GetString(knob.key).size();
+      shown = bytes == 0 ? std::string("<absent>")
+                         : StrCat({"<", NumberToString(bytes), " bytes>"});
+    } else if (!value.has_value()) {
+      shown = "<unset>";
+    } else {
+      shown = *value;
+    }
+    StrAppend(&out, {mark, " ", knob.key, " = ", shown, "\n"});
+  }
+  return out;
+}
+
+std::optional<int64_t> GetOptionalInt(std::string_view key) {
+  Require(key);
+  std::optional<std::string> raw = Effective(key, nullptr);
+  int64_t parsed = 0;
+  if (!raw.has_value() || !ParseInt(*raw, &parsed)) {
+    return std::nullopt;
+  }
+  return parsed;
+}
+
+std::optional<double> GetOptionalDouble(std::string_view key) {
+  Require(key);
+  std::optional<std::string> raw = Effective(key, nullptr);
+  double parsed = 0.0;
+  if (!raw.has_value() || !ParseDouble(*raw, &parsed)) {
+    return std::nullopt;
+  }
+  return parsed;
+}
+
+std::optional<std::string> GetOptionalString(std::string_view key) {
+  Require(key);
+  std::optional<std::string> raw = Effective(key, nullptr);
+  if (!raw.has_value() || raw->empty()) {
+    return std::nullopt;
+  }
+  return raw;
+}
+
+bool GetBool(std::string_view key) {
+  const std::string raw = RequireValue(key);
+  bool parsed = false;
+  if (!ParseBool(raw, &parsed)) {
+    CHECK(ParseBool(Require(key).default_value, &parsed));
+  }
+  return parsed;
+}
+
+int64_t GetInt(std::string_view key) {
+  const std::string raw = RequireValue(key);
+  int64_t parsed = 0;
+  if (!ParseInt(raw, &parsed)) {
+    CHECK(ParseInt(Require(key).default_value, &parsed));
+  }
+  return parsed;
+}
+
+double GetDouble(std::string_view key) {
+  const std::string raw = RequireValue(key);
+  double parsed = 0.0;
+  if (!ParseDouble(raw, &parsed)) {
+    CHECK(ParseDouble(Require(key).default_value, &parsed));
+  }
+  return parsed;
+}
+
+std::string GetString(std::string_view key) {
+  Require(key);
+  // Deliberately NOT RequireValue: for every kString knob in the registry ""
+  // and absent both mean "do not override", so a knob with an absent default
+  // has a perfectly good answer here. GetBool/GetInt/GetDouble do CHECK,
+  // because for those "no value" has no representation to return.
+  return Effective(key, nullptr).value_or(std::string());
+}
+
+const PerturbTuning& Tuning() {
+  static NoDestructor<RetainedCache<PerturbTuning>> cache;
+  return cache->Get(&BuildTuning);
+}
+
+span<const MachineClass> MachineClasses() {
+  static NoDestructor<RetainedCache<std::vector<MachineClass>>> cache;
+  return span<const MachineClass>(cache->Get(&BuildMachineClasses));
+}
+
+}  // namespace base::xrio
