+++ b/base/xrio_media_table_unittest.cc
@@ -0,0 +1,218 @@
+#include "base/xrio_media_table.h"
+
+#include <memory>
+#include <string>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/xrio_config.h"
+#include "base/strings/strcat.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace base::xrio {
+namespace {
+
+constexpr char kName[] = "basharsx4-amd-renoir";
+
+// A media-shaped artifact: the fields a capture tool emits, trimmed to two
+// families. The RENOIR-shaped values are what the mechanism exists to carry:
+// hardware decode for H.264 and VP9, nothing for AV1 (RENOIR's UVD predates
+// AV1 decode), which is exactly the shape SwiftShader cannot honestly answer.
+std::string Artifact(std::string_view name = kName) {
+  return StrCat({R"json({
+  "schema": "xrio-media-table/v1",
+  "name": ")json",
+                 name, R"json(",
+  "chrome_version": "151.0.7922.108",
+  "decode": [
+    {"family": "h264", "supported": true, "smooth": true, "power_efficient": true},
+    {"family": "av1", "supported": true, "smooth": false, "power_efficient": false}
+  ],
+  "digest": "sha256:0000"
+})json"});
+}
+
+// Renames `key` rather than deleting it: same reasoning as the GL table's
+// test -- deleting the last field's line leaves a trailing comma, and the
+// parse would then fail as malformed JSON while the test claimed missing-field.
+std::unique_ptr<MediaTable> ParseWithout(std::string_view key,
+                                         std::string* error) {
+  std::string body = Artifact();
+  const std::string needle = StrCat({"\"", key, "\":"});
+  const size_t at = body.find(needle);
+  CHECK_NE(at, std::string::npos) << key;
+  body[at + 1] = '_';
+  return MediaTable::Parse(body, kName, error);
+}
+
+class MediaTableTest : public testing::Test {
+ public:
+  MediaTableTest() { XrioConfig::Get().SetAll({}); }
+  ~MediaTableTest() override { XrioConfig::Get().SetAll({}); }
+};
+
+TEST_F(MediaTableTest, ParsesAndAnswersPerFamily) {
+  std::string error;
+  auto table = MediaTable::Parse(Artifact(), kName, &error);
+  ASSERT_TRUE(table) << error;
+  EXPECT_EQ(kName, table->name());
+  DecodingAnswer answer{false, false, false};
+  EXPECT_TRUE(table->Find(MediaFamily::kH264, &answer));
+  EXPECT_TRUE(answer.supported);
+  EXPECT_TRUE(answer.smooth);
+  EXPECT_TRUE(answer.power_efficient);
+  // The AV1 row says supported-but-not-smooth: a real machine answers this way
+  // (software decode is still playable), so the triple must survive intact
+  // rather than being collapsed to all-true.
+  EXPECT_TRUE(table->Find(MediaFamily::kAv1, &answer));
+  EXPECT_TRUE(answer.supported);
+  EXPECT_FALSE(answer.smooth);
+  EXPECT_FALSE(answer.power_efficient);
+  // An unmeasured family misses: stock answers stand.
+  EXPECT_FALSE(table->Find(MediaFamily::kVp9, &answer));
+}
+
+TEST_F(MediaTableTest, RefusesWrongSchema) {
+  std::string error;
+  std::string body = Artifact();
+  body.replace(body.find("xrio-media-table/v1"), 17, "xrio-gl-table/v1");
+  EXPECT_EQ(nullptr, MediaTable::Parse(body, kName, &error));
+}
+
+TEST_F(MediaTableTest, RefusesWrongName) {
+  std::string error;
+  EXPECT_EQ(nullptr, MediaTable::Parse(Artifact(), "other-host", &error));
+  EXPECT_NE(std::string::npos, error.find("other-host"));
+}
+
+TEST_F(MediaTableTest, RefusesMissingProvenance) {
+  std::string error;
+  EXPECT_EQ(nullptr, ParseWithout("chrome_version", &error));
+  EXPECT_EQ(nullptr, ParseWithout("digest", &error));
+}
+
+TEST_F(MediaTableTest, RefusesBadRows) {
+  std::string error;
+
+  // Unknown family: not in the vocabulary, so no row may claim it.
+  std::string unknown = Artifact();
+  const std::string fam_needle = "\"family\": \"h264\"";
+  unknown.replace(unknown.find(fam_needle), fam_needle.size(),
+                  "\"family\": \"mpeg4\"");
+  EXPECT_EQ(nullptr, MediaTable::Parse(unknown, kName, &error));
+  EXPECT_NE(std::string::npos, error.find("unknown codec family"));
+
+  // Duplicate family.
+  std::string duped = Artifact();
+  const std::string row_end = "\"power_efficient\": true},";
+  const std::string dupe_row =
+      "\n    {\"family\": \"h264\", \"supported\": false, "
+      "\"smooth\": false, \"power_efficient\": false},";
+  const size_t at = duped.find(row_end);
+  ASSERT_NE(std::string::npos, at);
+  duped.insert(at + row_end.size(), dupe_row);
+  std::unique_ptr<MediaTable> parsed = MediaTable::Parse(duped, kName, &error);
+  EXPECT_EQ(nullptr, parsed) << "error was: " << error;
+  if (!parsed) {
+    EXPECT_NE(std::string::npos, error.find("duplicate")) << error;
+  }
+
+  // A row missing one of its three booleans is not a measurement.
+  std::string missing = Artifact();
+  missing.replace(missing.find(", \"power_efficient\": true}"),
+                  sizeof(", \"power_efficient\": true}") - 1, "}");
+  EXPECT_EQ(nullptr, MediaTable::Parse(missing, kName, &error));
+  EXPECT_NE(std::string::npos, error.find("missing bool"));
+}
+
+TEST_F(MediaTableTest, EmptyDecodeListParsesAndAlwaysMisses) {
+  std::string error;
+  std::string empty = Artifact();
+  const size_t start = empty.find("[", empty.find("\"decode\""));
+  const size_t end = empty.find("]", start);
+  empty.replace(start + 1, end - start - 1, "");
+  auto table = MediaTable::Parse(empty, kName, &error);
+  ASSERT_TRUE(table) << error;
+  DecodingAnswer answer{true, true, true};
+  EXPECT_FALSE(table->Find(MediaFamily::kH264, &answer));
+  EXPECT_TRUE(answer.supported);  // untouched by the miss
+}
+
+TEST_F(MediaTableTest, ApplyNeedsKnobAndTableAndFamily) {
+  constexpr char kSwitch[] = "media-persona";
+  DecodingAnswer answer{false, false, false};
+
+  // No persona at all: untouched, whatever the knob says.
+  XrioConfig::Get().SetAll({{kSwitch, "true"}});
+  ApplyMediaPersona(MediaFamily::kH264, &answer);
+  EXPECT_FALSE(answer.power_efficient);
+
+  // Persona + table + knob: overridden as a triple.
+  XrioConfig::Get().SetAll({{kSwitch, "true"},
+                           {"gl-persona", kName},
+                           {"media-table", Artifact()}});
+  ApplyMediaPersona(MediaFamily::kH264, &answer);
+  EXPECT_TRUE(answer.supported);
+  EXPECT_TRUE(answer.smooth);
+  EXPECT_TRUE(answer.power_efficient);
+
+  // The knob retreats one surface without touching the others' plumbing.
+  XrioConfig::Get().SetAll({{kSwitch, "false"},
+                           {"gl-persona", kName},
+                           {"media-table", Artifact()}});
+  answer = {false, false, false};
+  ApplyMediaPersona(MediaFamily::kH264, &answer);
+  EXPECT_FALSE(answer.power_efficient);
+
+  // kNone never consults anything: the unmeasured families stay honest.
+  XrioConfig::Get().SetAll({{kSwitch, "true"},
+                           {"gl-persona", kName},
+                           {"media-table", Artifact()}});
+  answer = {false, false, false};
+  ApplyMediaPersona(MediaFamily::kNone, &answer);
+  EXPECT_FALSE(answer.power_efficient);
+
+  // A defective table is no table: stock answers stand.
+  XrioConfig::Get().SetAll({{kSwitch, "true"},
+                           {"gl-persona", kName},
+                           {"media-table", "{not json"}});
+  answer = {false, false, false};
+  ApplyMediaPersona(MediaFamily::kH264, &answer);
+  EXPECT_FALSE(answer.power_efficient);
+}
+
+TEST_F(MediaTableTest, ExpandReadsSiblingArtifactAndNeverInheritsBody) {
+  ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const FilePath artifact =
+      dir.GetPath().AppendASCII(StrCat({kName, ".xrio-media.json"}));
+  ASSERT_TRUE(WriteFile(artifact, Artifact()));
+
+  // argv-supplied bodies are stripped before anything reads them.
+  XrioConfig::Map map{{"gl-persona", kName}, {"media-table", "injected"}};
+  ExpandMediaTable(&map);
+  EXPECT_EQ(map.end(), map.find("media-table"))
+      << "an injected body survived into the config";
+
+  // With persona-dir pointed at the temp dir, the real body arrives inlined.
+  map = {{"gl-persona", kName}, {"persona-dir", dir.GetPath().AsUTF8Unsafe()}};
+  ExpandMediaTable(&map);
+  ASSERT_NE(map.end(), map.find("media-table"));
+  EXPECT_EQ(Artifact(), map["media-table"]);
+
+  // No artifact on disk: absent, not an error -- every persona captured before
+  // the first media measurement lives here.
+  XrioConfig::Map bare{{"gl-persona", kName}};
+  ExpandMediaTable(&bare);
+  EXPECT_EQ(bare.end(), bare.find("media-table"));
+
+  // No persona selected: nothing to claim decode hardware FOR, even if an
+  // artifact exists. A media table over honest SwiftShader strings would be
+  // the contradiction this whole file exists to prevent, in isolation.
+  XrioConfig::Map orphans{{"persona-dir", dir.GetPath().AsUTF8Unsafe()}};
+  ExpandMediaTable(&orphans);
+  EXPECT_EQ(orphans.end(), orphans.find("media-table"));
+}
