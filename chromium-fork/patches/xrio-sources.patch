+namespace {
+
+// One `battery-status` time field: a non-negative finite number, or the string
+// "Infinity".
+//
+// The string spelling is not a convenience. RFC 8259 JSON has no infinity
+// literal, and every alternative encoding means something else to a page:
+// `null` is absent, `-1` is a negative time, and a large finite number is a
+// battery that empties in a century. The API's own value for "not applicable or
+// unknown" is Infinity, so the config file has to be able to say it.
+bool ParseBatteryTime(std::string_view key,
+                      const Value& value,
+                      double* out,
+                      std::string* error) {
+  if (const std::string* text = value.GetIfString()) {
+    if (*text == "Infinity") {
+      *out = std::numeric_limits<double>::infinity();
+      return true;
+    }
+    *error = StrCat({"\"", key,
+                     "\" must be a non-negative number of seconds or the "
+                     "string \"Infinity\""});
+    return false;
+  }
+  // GetIfDouble accepts an integer too, so `"discharging_time": 42960` and
+  // `42960.0` are the same value rather than a type error nobody expects.
+  const std::optional<double> number = value.GetIfDouble();
+  if (!number.has_value() || !std::isfinite(*number) || *number < 0.0) {
+    *error = StrCat({"\"", key,
+                     "\" must be a non-negative number of seconds or the "
+                     "string \"Infinity\""});
+    return false;
+  }
+  *out = *number;
+  return true;
+}
+
+}  // namespace
+
+bool GlPersonaActive() {
+  // "A table parsed, and its name is the one that was selected." Exact match
+  // only, and it is GlTable::Parse that enforces it: a near-miss must not
+  // half-apply, because strings spoofed with an honest capability table
+  // underneath is the contradiction this exists to prevent. Same end state as
+  // the compiled table gave -- an unrecognised name leaves every GL surface
+  // untouched -- reached by refusing the artifact rather than by failing a
+  // string compare against a constant.
+  return ActiveGlTable() != nullptr;
+}
+
+bool OverrideGlInt(uint32_t pname, int32_t* value) {
+  const GlTable* table = ActiveGlTable();
+  return table && table->FindInt(pname, value);
+}
+
+bool OverrideGlFloat(uint32_t pname, float* value) {
