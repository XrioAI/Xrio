+TEST_F(XrioKnobsTest, ValidationAcceptsAValuelessSwitchOnlyForABool) {
+  std::string error;
+  // `--xrio-jitter-geometry` with no value.
+  EXPECT_TRUE(ValidateConfig({{"jitter-geometry", ""}}, &error)) << error;
+  // `--xrio-persona-dir=` means "unset", not "a directory called nothing", so a
+  // constraint must not fire on it.
+  EXPECT_TRUE(ValidateConfig({{"persona-dir-name", ""}}, &error)) << error;
+}
