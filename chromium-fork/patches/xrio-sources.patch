--- /dev/null
+++ b/base/xrio_knobs.h
@@ -0,0 +1,348 @@
+#ifndef BASE_XRIO_KNOBS_H_
+#define BASE_XRIO_KNOBS_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/base_export.h"
+#include "base/containers/span.h"
+#include "base/xrio_config.h"
+
+namespace base::xrio {
+
+// THE REGISTRY. Every value this fork reads at runtime, its type, and its
+// default -- in one table, in one place.
+//
+// WHY IT EXISTS. A Chromium build is ~5 hours. A value that lives only as a C++
+// literal costs five hours to change, so the tree drifted toward "measure once,
+// hardcode, move on": a nine-row machine-class table, a 1-in-8 pixel rate, an
+// audio scale of [0.999, 1.000), a +-0.02 px geometry step, a WebRTC leak
+// posture baked into a pref default, and two booleans returning `true` that
+// between them controlled nine unrelated behaviours. None of those is a constant
+// of nature. Every one is a measurement or a judgement, and every one will be
+// revised.
+//
+// So the rule is: a value a human might want to change is a KNOB, not a
+// literal. The literal survives as the knob's DEFAULT, so a launch with no
+// `--xrio-*` flag at all reproduces the previous build's behaviour exactly.
+//
+// WHY A REGISTRY AND NOT JUST MORE ACCESSORS. This project's dominant failure
+// mode is a knob that reads as working while doing nothing: the audio hook
+// shipped as a complete no-op at 27/27 green, --xrio-jitter-geometry shipped
+// unit-tested and unexercised by any probe, and four separate knobs have been
+// believed live while inert. A bare XrioConfig::GetString("cavnas-rate") returns
+// "" for a typo and the surface silently stays upstream. That is unacceptable
+// for a mechanism whose entire purpose is to be checked. And the existing
+// `Has("jitter-geometry")` read is the same defect in miniature: it is
+// presence-only, so `--xrio-jitter-geometry=false` ENABLES geometry jitter.
+//
+// The registry closes all of that three ways, and all three are load-bearing:
+//
+//   1. VALIDATION. ValidateConfig() refuses an unregistered `xrio-*` key, a value
+//      that does not parse as its registered type, and a value its constraint
+//      rejects. ChromeMainDelegate calls it before anything reads a knob and
+//      REFUSES TO LAUNCH on failure. A typo is a startup error naming the key,
+//      not a silent no-op.
+//   2. OBSERVABILITY. `--xrio-dump-config` prints the registry and the effective
+//      value of every knob, so "is this knob live" is one exec away and
+//      tools/verify_probe.py can assert the configuration rather than assume it.
+//   3. ONE DEFAULT. Written once, here, as the string a command line would
+//      carry. A call site cannot disagree with the documentation about what
+//      "unset" means, because there is only one copy of the answer.
+//
+// UMBRELLAS. Some knobs default to another knob's value rather than to a
+// literal: the six outbound-silence suppressions default to
+// `suppress-background-fetches`, and the three automation-blocker behaviours
+// default to `suppress-automation-blockers`. Those two booleans each used to be
+// one `return true` standing in for a group of unrelated behaviours -- one
+// controlling a variations fetch, a DNS probe, a pref write and a first-run
+// import at once. Splitting them without an umbrella would mean six flags to
+// turn one thing off; keeping them fused meant no way to turn one thing off at
+// all. `default_value` naming another key is spelled `@other-key`.
+//
+// WHAT IS DELIBERATELY *NOT* A KNOB. The full list is in kKnobs' trailing
+// comment; the reasons come in four kinds:
+//
+//   Bootstrap -- XrioConfig::kSwitchPrefix ("xrio-") and the "0x" seed prefix.
+//   A key naming the prefix would itself need the prefix.
+//
+//   Contract -- GlTable::kSchema. Letting an artifact of unknown shape declare
+//   itself acceptable is the fail-closed rule inverted; a v2 needs parser code,
+//   which is a rebuild by definition.
+//
+//   Structural -- GlTable::kMaxComponents (4) is Blink's std::array bound and
+//   the GlTable::Array template argument; the `y << 32` coordinate packing
+//   width; `% 3` colour channels (byte 3 is alpha under both RGBA and BGRA, so
+//   touching it makes transparent pixels opaque); `bytes_per_pixel == 4`.
+//
+//   Guard -- the persona-name charset and the leading-dot refusal. Those exist
+//   so `--xrio-gl-persona` cannot become a path expression; configurable defeats
+//   them.
+//
+// ADDING A KNOB is a two-line change: a row in kKnobs and a call site that asks
+// for it. xrio_knobs_unittest.cc asserts that every registry row is exercised by
+// a test, so the registry cannot grow a member nothing checks.
+
+// How a knob's value is spelled, and therefore what ValidateConfig accepts.
+enum class KnobType {
+  // "true"/"false", "1"/"0", "yes"/"no", "on"/"off", case-insensitively. A
+  // valueless switch (`--xrio-jitter-geometry`) reads as TRUE, which is the
+  // spelling a command line makes natural -- and unlike the presence-only read
+  // it replaces, `=false` now means false.
+  kBool,
+  kInt,
+  kDouble,
+  // Decimal, or `0x`-prefixed hex. Zero is REFUSED rather than accepted,
+  // because XrioConfig::GetSeed reports zero as absent and an operator who
+  // passed `--xrio-seed=0` would get an untouched surface while believing they
+  // had keyed it.
+  kSeed,
+  kString,
+  // A JSON document, validated as parseable here and for shape by its
+  // consumer -- which for "machine-classes" is this file, so its constraint
+  // does check the shape.
+  kJson,
+  // Populated by the fork itself, never accepted from outside. Supplying one is
+  // refused with a message saying so; see "gl-table".
+  kDerived,
+};
+
+struct Knob {
+  // The key, with no `xrio-` prefix: XrioConfig strips the prefix at harvest, so
+  // key "gl-persona" is switch `--xrio-gl-persona` and config-file key
+  // "gl-persona".
+  std::string_view key;
+  KnobType type;
+  // Exactly the string a command line would carry to reproduce the behaviour
+  // this fork had before the value became a knob.
+  //
+  // EMPTY MEANS ABSENT, not empty-string: a knob defaulting to absent leaves its
+  // surface untouched and the GetOptional* accessors report std::nullopt. A
+  // kString knob whose real default is "" therefore cannot say so, and none
+  // needs to -- for every one of them "" and absent both mean "do not
+  // override".
+  //
+  // `@other-key` defers to another knob's effective value. See UMBRELLAS above.
+  std::string_view default_value;
+  // One line, printed by --xrio-dump-config. Operator-facing documentation; a
+  // sentence, not a paragraph.
+  std::string_view doc;
+  // Extra constraint beyond the type, or nullptr. Returns false and fills
+  // `error` for a value that parses but cannot be honoured: a pixel rate mask
+  // that is not 2^k-1, a non-positive step count, a machine-class table with a
+  // malformed row. Checked by ValidateConfig, so a bad value refuses the launch
+  // rather than reaching a surface.
+  bool (*constraint)(std::string_view value, std::string* error) = nullptr;
+};
+
+// The registry, sorted by key. Stable for the life of the process.
+BASE_EXPORT span<const Knob> Knobs();
+
+// nullptr for a key no build reads. Call sites inside the fork must never get
+// here with an unregistered key -- the typed accessors CHECK on one, because a
+// call site naming a key the registry does not carry would otherwise present as
+// a silently-defaulted surface, which is the exact failure this file exists to
+// end.
+BASE_EXPORT const Knob* FindKnob(std::string_view key);
+
+// ---------------------------------------------------------------------------
+// Validation and reporting. Called from ChromeMainDelegate::BasicStartupComplete
+// over the browser's own command line and over any --xrio-config-file, BEFORE
+// any surface reads a knob.
+
+// False, with `error` set to something an operator can act on, when `map`
+// carries an unregistered key, a value that does not parse as its registered
+// type, a value its constraint refuses, or a kDerived key supplied from outside.
+//
+// FAILS THE LAUNCH, not the surface. This is the one place in the fork that does
+// not fail closed, and the asymmetry is the point: a mistyped knob means the
+// operator believes something is configured that is not, so rendering anyway
+// produces a measurement whose configuration is not what the ledger records.
+// Refusing to start is the only outcome that cannot be mistaken for success.
+BASE_EXPORT bool ValidateConfig(const XrioConfig::Map& map, std::string* error);
+
+// The registry and the effective value of every knob, one `key = value` per
+// line, sorted, each marked with where its value came from: `[set]` for a flag
+// or a config file, `[def]` for the registry default, `[umb]` for a default
+// deferred to an umbrella knob, `[der]` for a derived key.
+//
+// Printed by `--xrio-dump-config`, which exits 0 -- the same "a switch that
+// answers a question and stops" shape as `--version`, so xrio and
+// tools/verify_probe.py can read the effective configuration with one exec
+// instead of inferring it from the flags they think they passed.
+//
+// Seeds are printed. They are already on the browser's command line, and an
+// operator diagnosing a render needs to know which seed produced it. A derived
+// key's VALUE is not printed -- "gl-table" is a whole JSON artifact -- only its
+// presence and byte count.
+BASE_EXPORT std::string DescribeConfig();
+
+// ---------------------------------------------------------------------------
+// Typed reads. Each resolves the knob's own default when the key is absent, so a
+// call site never repeats a literal. CHECK-fails on an unregistered key.
+
+// For knobs whose default is absent.
+BASE_EXPORT std::optional<int64_t> GetOptionalInt(std::string_view key);
+BASE_EXPORT std::optional<double> GetOptionalDouble(std::string_view key);
+BASE_EXPORT std::optional<std::string> GetOptionalString(std::string_view key);
+
+// For knobs that always have a value. CHECK-fails when the registry gives the
+// knob an absent default, because then there is nothing to return and the call
+// site wanted GetOptional*.
+BASE_EXPORT bool GetBool(std::string_view key);
+BASE_EXPORT int64_t GetInt(std::string_view key);
+BASE_EXPORT double GetDouble(std::string_view key);
+BASE_EXPORT std::string GetString(std::string_view key);
+
+// ---------------------------------------------------------------------------
+// Perturbation tuning, drawn together and cached.
+//
+// One struct rather than eighteen accessors, for two reasons.
+//
+// SPEED. These are the fork's only genuinely hot reads: JitterDimension runs on
+// every getBoundingClientRect -- thousands of times a frame on a
+// layout-thrashing page -- and the pixel rate and the two hash constants are
+// consulted once per pixel. A flat_map lookup and a strtod per pixel is not
+// affordable, and neither is a mutex (xrio_config.h documents why).
+//
+// COHERENCE. A caller must not observe a step count from one configuration
+// against a scale from another, and the per-pixel path must not see the rate
+// mask move between two rows of the same buffer.
+struct PerturbTuning {
+  // murmur3-64's finalizer and FNV-1a's basis and prime. ALGORITHM CONSTANTS:
+  // they define every derived sub-seed, every per-pixel decision, every jitter
+  // offset and the audio scale, so changing one invalidates every hash ever
+  // captured from this fork and makes two builds render differently from the
+  // same --xrio-seed. Keyed anyway, because "we would have to rebuild to find
+  // out" is the thing this file exists to remove -- but --xrio-dump-config
+  // records them, so a capture always says which constants produced it.
+  uint64_t hash_mix_1;
+  uint64_t hash_mix_2;
+  uint64_t hash_shift;
+  uint64_t seed_tag_basis;
+  uint64_t seed_tag_prime;
+  // Substituted when a derived sub-seed avalanches to exactly zero, which would
+  // read as "unset" everywhere downstream. Probability 2^-64. This is the
+  // fork's only substituted seed constant and the one place it does what
+  // xrio_perturb.h forbids; keying it at least makes the substitution visible.
+  uint64_t seed_zero_substitute;
+  // Mixes a pixel's absolute x into its decision, and a channel index into the
+  // audio scale, so a stereo buffer's channels do not move in lockstep.
+  uint64_t coord_mixer;
+  uint64_t audio_channel_mixer;
+
+  // (h & mask) == phase selects a pixel, so mask 0x7 with phase 0 is one pixel
+  // in eight. The mask must be 2^k-1 or the selection is not uniform, and the
+  // phase must fit inside it; both constraints are enforced at validation.
+  uint64_t pixel_rate_mask;
+  uint64_t pixel_rate_phase;
+  // XORed into one of the three colour bytes. 1 is +-1/255: invisible to a
+  // human, fatal to a hash. Anything wider is visible in the rendered product,
+  // which IS the deliverable, so validation caps it.
+  uint8_t pixel_bit_mask;
+  // How far above the rate-mask bits the channel choice is drawn from, so the
+  // two decisions do not correlate. Derived from the mask width, not keyed.
+  uint8_t channel_shift;
+
+  // Audio channel scale is drawn from [floor, floor + span).
+  double audio_scale_floor;
+  double audio_scale_span;
+
+  // Dimensions are quantised to 1/quantum px before keying, so two reads
+  // differing only in float noise land on the same jitter. The jitter is one of
+  // `steps` offsets centred on zero, in 1/step_size px; 41 and 1024 give
+  // +-0.02 px in 1/1024 steps.
+  double jitter_quantum;
+  int64_t jitter_steps;
+  double jitter_step_size;
+};
+
+// Valid for the life of the process: tunings are retained and never freed, the
+// idiom ActiveGlTable() uses and for the same reason -- a caller may hold the
+// reference across a reconfiguration, which happens at most once (the mojo
+// push), so this retains at most a handful of ~120-byte objects in exchange for
+// a guarantee that holds by construction rather than by argument.
+BASE_EXPORT const PerturbTuning& Tuning();
+
+// ---------------------------------------------------------------------------
+// The machine class table, parsed from the "machine-classes" knob.
+//
+// Was a constexpr array of nine rows -- and with --xrio-seed set, those 36
+// literals were the complete set of machines this fleet could claim:
+// hardwareConcurrency, deviceMemory and (until 2026-09-29) the storage quota
+// were all drawn from them, so the reportable machine set was fleet-wide fixed
+// at nine buckets that no seed could widen. It is a measurement, it will be
+// re-measured, and a five-hour rebuild per revision is the wrong price. The
+// array survives verbatim as the knob's default, so an unconfigured build draws
+// from exactly the table it drew from before.
+//
+// The four columns stay ONE key rather than four. patches/series section 4 and
+// xrio_persona.h both record why: the triple is drawn together from one machine
+// class because a 12-core box reporting 4 GB is not a machine anyone owns, and
+// an incoherent triple is a worse signal than a constant one. Four independent
+// keys would let an operator build exactly that.
+
+// THE FIFTH COLUMN IS OPTIONAL, and that is a contract rather than a
+// convenience. The nine shipped rows are four-field, and any deployment that
+// already set this knob wrote four-field rows; making the column required would
+// break every one of them. An absent form factor means what it has always
+// meant -- the row says nothing about the chassis -- so an unconfigured build
+// and every existing configuration behave exactly as they did.
+//
+// It exists because a battery claim cannot be DRAWN from a machine class that
+// carries no chassis, which is the gap fork/not-implemented.md section J names
+// as the fleet model's first prerequisite. `battery-status` is one fixed tuple
+// for the life of the process, so the most this column can do today is let
+// ValidateConfig refuse the two combinations that are guaranteed
+// contradictions: a laptop row with no battery, and a desktop row with one.
+// Drawing a battery from the drawn row is the fleet model itself, and that is
+// blocked on time-series captures from admitted laptops -- without them the
+// evolution rule would be invented, which is the failure this fork has already
+// been bitten by.
+enum class FormFactor {
+  kUnspecified,
+  kLaptop,
+  kDesktop,
+};
+
+struct MachineClass {
+  unsigned cores;
+  float memory_gb;
+  unsigned free_disk_gb;
+  unsigned weight;
+  // Defaulted so the four-value aggregate initialisation in ParseMachineClasses
+  // and in every test that writes a row by hand keeps compiling.
+  FormFactor form_factor = FormFactor::kUnspecified;
+};
+
+// THE VERSION OF THE SELECTION ALGORITHM, and the reason a `machine-class-expect`
+// value carries it. An expectation is a claim about what a specific function
+// returns for a specific seed, ceiling and table -- so it is only meaningful
+// against the function that produced it. Bump this whenever DrawMachineClass()
+// changes what it returns for an input it already accepted: the weight
+// renormalisation, the roll, the ceiling's position relative to the roll, or the
+// order the table is walked in. Every persisted expectation then refuses its
+// launch and says the algorithm moved, which is the correct outcome -- the
+// alternative is a fleet silently re-drawn by a build.
+//
+// Adding a FIELD to the table (the fifth chassis column was one) does not
+// require a bump on its own: four-field rows still draw identically. Changing
+// the shipped default table does not either, because the table is an input the
+// expectation is checked against rather than part of the algorithm.
+inline constexpr int kMachineSelectionVersion = 1;
+
+// The configured table. Empty only when "machine-classes" is unparseable, which
+// ValidateConfig refuses the launch over -- so an empty table in a real browser
+// cannot happen, and in a unit test that installed a map directly it means the
+// caller wrote a bad one. Callers treat empty as "no machine class", which is
+// the fail-closed path: upstream's own cores and memory.
+//
+// Retained for the life of the process, same argument as Tuning().
+BASE_EXPORT span<const MachineClass> MachineClasses();
+
+}  // namespace base::xrio
