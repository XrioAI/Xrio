+bool ParseBatteryStatus(std::string_view json,
+                        BatteryStatus* out,
+                        std::string* error) {
+  CHECK(out);
+  CHECK(error);
+  // DictValue, not `Value::Dict`: this tree has the standalone base::DictValue
+  // class (base/values.h:242), and the nested alias does not exist here.
+  std::optional<DictValue> parsed = JSONReader::ReadDict(json, JSON_PARSE_RFC);
+  if (!parsed.has_value()) {
+    *error = "must be a JSON object";
+    return false;
+  }
+
+  // ALL FOUR KEYS AND NOTHING ELSE. Refusing a partial object is the whole
+  // reason this is one knob: a tuple missing `discharging_time` would take that
+  // field's compiled default and pair it with the operator's `charging`, which
+  // is how "charging with a finite discharging time" gets built without anyone
+  // typing it. An extra key is refused for the mirror reason -- a typo'd
+  // `charge_time` would otherwise read as accepted and do nothing.
+  static constexpr auto kKeys = std::to_array<std::string_view>(
+      {"charging", "charging_time", "discharging_time", "level"});
+  for (const std::string_view key : kKeys) {
+    if (parsed->Find(key) == nullptr) {
+      *error = StrCat({"is missing \"", key,
+                       "\"; the tuple is all four of charging, charging_time, "
+                       "discharging_time and level, or none"});
+      return false;
+    }
+  }
+  if (parsed->size() != kKeys.size()) {
+    *error =
+        "must hold exactly the four keys charging, charging_time, "
+        "discharging_time and level";
+    return false;
+  }
+
+  const std::optional<bool> charging = parsed->FindBool("charging");
+  if (!charging.has_value()) {
+    *error = "\"charging\" must be a boolean";
+    return false;
+  }
+  const std::optional<double> level = parsed->FindDouble("level");
+  if (!level.has_value() || !(*level > 0.0) || *level > 1.0) {
+    // Zero is refused rather than clamped: a level of 0 is a machine that has
+    // already switched off, and the API's own range starts above it.
+    *error = "\"level\" must be greater than 0 and at most 1";
+    return false;
+  }
+  double charging_time = 0.0;
+  double discharging_time = 0.0;
+  if (!ParseBatteryTime("charging_time", *parsed->Find("charging_time"),
+                        &charging_time, error) ||
+      !ParseBatteryTime("discharging_time", *parsed->Find("discharging_time"),
+                        &discharging_time, error)) {
+    return false;
+  }
+
+  // Coherence. Each of these is a status no device reports, and each is one an
+  // operator can type without noticing.
+  if (*charging && !std::isinf(discharging_time)) {
+    *error =
+        "is charging, so \"discharging_time\" must be \"Infinity\" -- a "
+        "battery cannot be filling and emptying at once";
+    return false;
+  }
+  if (!*charging && !std::isinf(charging_time)) {
+    *error =
+        "is discharging, so \"charging_time\" must be \"Infinity\" -- there is "
+        "no time until full while nothing is charging it";
+    return false;
+  }
+  if (*charging && *level == 1.0 && charging_time != 0.0) {
+    *error =
+        "is charging at level 1, so \"charging_time\" must be 0 -- a full "
+        "battery cannot have a finite non-zero time until full";
+    return false;
+  }
+
+  out->charging = *charging;
+  out->charging_time = charging_time;
+  out->discharging_time = discharging_time;
+  out->level = *level;
+  return true;
+}
+
+std::optional<BatteryStatus> BatteryStatusOverride() {
+  const std::string configured = GetString("battery-status");
+  if (configured.empty()) {
+    return std::nullopt;
+  }
+  BatteryStatus status;
+  std::string error;
+  if (!ParseBatteryStatus(configured, &status, &error)) {
+    // Unreachable in the browser -- ValidateConfig refused the launch over this
+    // before anything read a knob. Reachable in a unit test, in a
+    // content_shell that never ran that hook, and in any future process that
+    // publishes a map directly, and in all of them the host's own answer is the
+    // safe one.
+    return std::nullopt;
+  }
+  return status;
+}
