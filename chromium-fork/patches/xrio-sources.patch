+TEST_F(XrioKnobsTest, AChassisWithoutAMatchingBatteryRefusesTheLaunch) {
+  std::string error;
+  const std::string kBattery =
+      R"json({"charging": false, "level": 0.71, "charging_time": )json"
+      R"json("Infinity", "discharging_time": 42960})json";
+
+  // THE CONTRADICTION fork/OPEN_DECISIONS.md 2 WAS OPENED FOR: a laptop
+  // persona whose getBattery() reports upstream's batteryless desktop tuple.
+  EXPECT_FALSE(ValidateConfig({{"machine-classes", HostRow("laptop")}},
+                              &error));
+  EXPECT_NE(std::string::npos, error.find("battery"))
+      << "the refusal must name the other key: " << error;
+
+  // And the mirror, which is what makes the rule a rule rather than a nudge.
+  EXPECT_FALSE(ValidateConfig({{"machine-classes", HostRow("desktop")},
+                               {"battery-status", kBattery}},
+                              &error));
+
+  // Both coherent directions pass.
+  EXPECT_TRUE(ValidateConfig({{"machine-classes", HostRow("laptop")},
+                              {"battery-status", kBattery}},
+                             &error))
+      << error;
+  EXPECT_TRUE(ValidateConfig({{"machine-classes", HostRow("desktop")}},
+                             &error))
+      << error;
+
+  // ONE TUPLE CANNOT SERVE TWO CHASSIS, so a mixed table is refused whichever
+  // way the battery is set. That restriction lifts when the battery is drawn
+  // from the drawn row, which is the fleet model.
+  // Both rows sized to this host, so the refusal below is the chassis rule and
+  // not the ceiling rule reached first, which would pass this test for a reason
+  // it is not testing.
+  const std::string cores = NumberToString(HostThreadCeiling());
+  const std::string kMixed = StrCat({"[[", cores, ",16,250,1,\"laptop\"],[",
+                                     cores, ",32,500,1,\"desktop\"]]"});
+  EXPECT_FALSE(ValidateConfig({{"machine-classes", kMixed}}, &error));
+  EXPECT_NE(std::string::npos, error.find("battery"))
+      << "a mixed table must be refused over the chassis, not the ceiling: "
+      << error;
+  EXPECT_FALSE(ValidateConfig(
+      {{"machine-classes", kMixed}, {"battery-status", kBattery}}, &error));
+
+  // AND THE SHIPPED DEFAULT IS STILL LEGAL WITH NO BATTERY, which is the whole
+  // reason the column is optional: nine four-field rows name no chassis, so
+  // neither rule can fire on any configuration anybody has deployed.
+  EXPECT_TRUE(ValidateConfig({}, &error)) << error;
+  EXPECT_TRUE(ValidateConfig({{"battery-status", kBattery}}, &error)) << error;
+}
+
+// The fourth cross-key rule: a hardware override beside the gate that discards
+// it. A knob that reads as set and changes nothing a page can see is the
+// failure mode this fork refuses at launch rather than records -- the same
+// argument as the gl-vendor rule. (It used to share this test with the storage
+// quota's override rule; both quota knobs were removed 2026-09-29.)
+TEST_F(XrioKnobsTest, AHardwareOverrideBesideItsRetreatRefusesTheLaunch) {
+  std::string error;
+
+  for (const char* key : {"hardware-concurrency", "device-memory"}) {
+    EXPECT_FALSE(ValidateConfig({{key, "8"}, {"spoof-hardware", "false"}},
+                                &error))
+        << key << " should be refused beside spoof-hardware=false";
+    EXPECT_NE(std::string::npos, error.find(key)) << error;
+    // And each is legal on its own, where the gate defaults true.
+    EXPECT_TRUE(ValidateConfig({{key, "8"}}, &error)) << error;
+  }
+
+  // AND AN UNCONFIGURED LAUNCH IS STILL LEGAL. spoof-hardware defaults true, so
+  // this rule cannot fire on a configuration nobody wrote.
+  EXPECT_TRUE(ValidateConfig({}, &error)) << error;
+  EXPECT_TRUE(ValidateConfig({{"spoof-hardware", "false"}}, &error)) << error;
+}
+
+// The expectation's SHAPE is validated here and its HONOURING is validated in
+// xrio_persona_unittest.cc, and the split is the point: a malformed value must
+// refuse the launch with a message naming the field, before anything tries to
+// replay a draw with it.
+TEST_F(XrioKnobsTest, AMalformedMachineClassExpectationRefusesTheLaunch) {
+  std::string error;
+  const char kGood[] =
+      R"json({"version":1,"persona":"","ceiling":4,"class":[4,8,120]})json";
+
+  EXPECT_TRUE(ValidateConfig({{"machine-class-expect", kGood}}, &error))
+      << error;
+  // Absent is legal and is the default: the fork cannot invent an expectation.
+  EXPECT_TRUE(ValidateConfig({}, &error)) << error;
+
+  // Every field is required, and the message has to name the missing one --
+  // this value comes from another process, so "malformed" alone is not
+  // actionable.
+  struct {
+    const char* json;
+    const char* names;
+  } const kBad[] = {
+      {R"json(["not", "an", "object"])json", "object"},
+      {R"json({"persona":"","ceiling":4,"class":[4,8,120]})json", "version"},
+      {R"json({"version":0,"persona":"","ceiling":4,"class":[4,8,120]})json",
+       "version"},
+      {R"json({"version":1,"ceiling":4,"class":[4,8,120]})json", "persona"},
+      {R"json({"version":1,"persona":"","class":[4,8,120]})json", "ceiling"},
+      {R"json({"version":1,"persona":"","ceiling":0,"class":[4,8,120]})json",
+       "ceiling"},
+      {R"json({"version":1,"persona":"","ceiling":4})json", "class"},
+      {R"json({"version":1,"persona":"","ceiling":4,"class":[4,8]})json",
+       "class"},
+      {R"json({"version":1,"persona":"","ceiling":4,"class":["4",8,120]})json",
+       "class"},
+  };
+  for (const auto& bad : kBad) {
+    EXPECT_FALSE(ValidateConfig({{"machine-class-expect", bad.json}}, &error))
+        << bad.json << " should be refused";
+    EXPECT_NE(std::string::npos, error.find(bad.names))
+        << bad.json << " -> " << error;
+  }
+
+  // An empty persona is a real configuration -- "drawn with no GL persona" --
+  // and has to stay distinguishable from a forgotten field, which is why the
+  // key is required and its value may be empty.
+  EXPECT_TRUE(ValidateConfig(
+      {{"machine-class-expect",
+        R"json({"version":1,"persona":"basharsx4-amd-renoir","ceiling":16,)json"
+        R"json("class":[16,32,500]})json"}},
+      &error))
+      << error;
+}
+
+TEST_F(XrioKnobsTest, HardwareValuesMustBeReportable) {
+  std::string error;
+  EXPECT_FALSE(
+      ValidateConfig({{"hardware-concurrency", "4294967296"}}, &error));
+  EXPECT_FALSE(
+      ValidateConfig({{"hardware-concurrency", "2147483648"}}, &error));
+  EXPECT_TRUE(ValidateConfig({{"hardware-concurrency", "2147483647"}}, &error))
+      << error;
+
+  for (const char* bad : {"0.5", "3", "12", "64"}) {
+    EXPECT_FALSE(ValidateConfig({{"device-memory", bad}}, &error)) << bad;
+  }
+  for (const char* good : {"2", "4", "8", "16", "32"}) {
+    EXPECT_TRUE(ValidateConfig({{"device-memory", good}}, &error)) << error;
+  }
+
+  EXPECT_FALSE(ValidateConfig({{"machine-classes", "[[1,12,250,1]]"}}, &error));
+  XrioConfig::Get().SetAll({{"machine-classes", "[[1,12,250,1]]"}});
+  EXPECT_TRUE(MachineClasses().empty());
+}
+
+TEST_F(XrioKnobsTest, ValidateConfigLeavesTheCeilingToStartup) {
+  std::string error;
+  EXPECT_TRUE(ValidateConfig({}, &error)) << error;
+  EXPECT_FALSE(ValidateConfig({{"machine-classes", ""}}, &error));
+
+  EXPECT_TRUE(ValidateConfig({{"machine-classes", HostRow()}}, &error))
+      << error;
+}
+
+// ---------------------------------------------------------------------------
+// Reporting. --xrio-dump-config is how "is this knob live" stops being a guess.
+
+TEST_F(XrioKnobsTest, DescribeConfigMarksWhereEachValueCameFrom) {
+  XrioConfig::Get().SetAll({{"seed", "0x2b"},
+                           {"suppress-background-fetches", "false"}});
+  const std::string report = DescribeConfig();
+  EXPECT_NE(std::string::npos, report.find("[set] seed = 0x2b"));
+  // A member with no value of its own reports its umbrella's, marked as such.
+  EXPECT_NE(std::string::npos,
+            report.find("[umb] suppress-variations-fetch = false"));
+  EXPECT_NE(std::string::npos, report.find("[def] pixel-rate-mask = 7"));
+  // A derived key reports presence and size, never the body.
+  EXPECT_NE(std::string::npos, report.find("[der] gl-table = <absent>"));
+  // Every knob appears, so the dump is a complete answer rather than a sample.
+  for (const Knob& knob : Knobs()) {
+    EXPECT_NE(std::string::npos, report.find(std::string(knob.key)))
+        << knob.key << " is missing from the dump";
+  }
+}
+
+}  // namespace
+}  // namespace base::xrio
diff --git a/base/xrio_media_table.cc b/base/xrio_media_table.cc
new file mode 100644
index 0000000000000000000000000000000000000000..cd19e7e34b57a8b9512415935b402a4625d8381d
--- /dev/null
+++ b/base/xrio_media_table.cc
@@ -0,0 +1,335 @@
+#include "base/xrio_media_table.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/xrio_knobs.h"
+
+#include "base/base_paths.h"
+#include "base/containers/flat_map.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/memory/raw_ptr.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "base/strings/strcat.h"
+#include "base/synchronization/lock.h"
+#include "base/thread_annotations.h"
+#include "base/values.h"
+
+namespace base::xrio {
+
+namespace {
+
+// Same rules as the GL name: this becomes a FILENAME, and --xrio-gl-persona
+// comes off a command line. Kept textually separate from xrio_gl_table.cc's
+// rather than shared, so neither file's guards can drift under the other's
+// feet; if they ever diverge, that is a finding, not a convenience.
+bool NameIsUsable(std::string_view name) {
+  const int64_t max_length = GetInt("gl-persona-max-name");
+  if (name.empty() || max_length < 1 ||
+      name.size() > static_cast<size_t>(max_length)) {
+    return false;
+  }
+  if (name.front() == '.') {
+    return false;
+  }
+  return std::all_of(name.begin(), name.end(), [](char c) {
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+           (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-';
+  });
+}
+
+const std::string* RequiredString(const DictValue& dict,
+                                  std::string_view key,
+                                  std::string* error) {
+  const Value* value = dict.Find(key);
+  if (!value || !value->is_string()) {
+    *error = StrCat({"missing or non-string field: ", key});
+    return nullptr;
+  }
+  const std::string& out = value->GetString();
+  if (out.empty()) {
+    *error = StrCat({"empty field: ", key});
+    return nullptr;
+  }
+  return &out;
+}
+
+// The artifact filename suffix. Its own knob, because a ruleset retreat that
+// points media at a different capture must not also move the GL table -- but
+// the SIZE CAP is deliberately shared with gl-table-max-bytes: both artifacts
+// are our own generated JSON of comparable size, one cap is one number to
+// reason about, and two caps would invite a state where media accepts what GL
+// refuses.
+size_t MaxTableBytes() {
+  const int64_t configured = GetInt("gl-table-max-bytes");
+  return configured > 0 ? static_cast<size_t>(configured) : 0u;
+}
+
+std::string MediaSuffix() { return GetString("media-table-suffix"); }
+
+std::optional<FilePath> MediaPath(const std::string& name,
+                                  const std::string& dir_override) {
+  if (!NameIsUsable(name)) {
+    return std::nullopt;
+  }
+  FilePath dir;
+  if (!dir_override.empty()) {
+    dir = FilePath::FromUTF8Unsafe(dir_override);
+  } else if (!PathService::Get(DIR_EXE, &dir)) {
+    return std::nullopt;
+  } else {
+    dir = dir.AppendASCII(GetString("persona-dir-name"));
+  }
+  return dir.AppendASCII(StrCat({name, MediaSuffix()}));
+}
+
+std::optional<std::string> ReadUncached(const FilePath& path) {
+  std::string body;
+  // Missing, unreadable and oversized are not distinguished, for the same
+  // reason the GL read does not distinguish them: all three mean "the operator
+  // named an artifact this browser cannot use", and the answer to all three is
+  // stock decode answers rather than a partial table.
+  if (!ReadFileToStringWithMaxSize(path, &body, MaxTableBytes())) {
+    return std::nullopt;
+  }
+  return body;
+}
+
+std::optional<std::string> ReadMediaBody(const std::string& name,
+                                         const std::string& dir_override) {
+  std::optional<FilePath> path = MediaPath(name, dir_override);
+  if (!path.has_value()) {
+    return std::nullopt;
+  }
+  // Memoized on the resolved path, exactly like ExpandGlTable: Init runs once
+  // per renderer launch and a batch render starts many renderers. One small
+  // read per browser process.
+  static NoDestructor<Lock> lock;
+  static NoDestructor<flat_map<FilePath, std::optional<std::string>>> cache;
+  AutoLock guard(*lock);
+  auto it = cache->find(*path);
+  if (it != cache->end()) {
+    return it->second;
+  }
+  std::optional<std::string> body = ReadUncached(*path);
+  cache->insert({*path, body});
+  return body;
+}
+
+bool FamilyFromName(std::string_view name, MediaFamily* out) {
+  if (name == "h264") {
+    *out = MediaFamily::kH264;
+  } else if (name == "hevc") {
+    *out = MediaFamily::kHevc;
+  } else if (name == "vp8") {
+    *out = MediaFamily::kVp8;
+  } else if (name == "vp9") {
+    *out = MediaFamily::kVp9;
+  } else if (name == "av1") {
+    *out = MediaFamily::kAv1;
+  } else {
+    return false;
+  }
+  return true;
+}
+
+
+}  // namespace
+
+MediaTable::MediaTable() = default;
+MediaTable::~MediaTable() = default;
+
+// static
+std::unique_ptr<MediaTable> MediaTable::Parse(std::string_view json,
+                                              std::string_view expected_name,
+                                              std::string* error) {
+  std::optional<DictValue> parsed = JSONReader::ReadDict(json, JSON_PARSE_RFC);
+  if (!parsed.has_value()) {
+    *error = "not a JSON object";
+    return nullptr;
+  }
+  const DictValue& dict = *parsed;
+
+  const std::string* schema = RequiredString(dict, "schema", error);
+  if (!schema) {
+    return nullptr;
+  }
+  if (*schema != kSchema) {
+    *error = StrCat({"schema '", *schema, "' is not '", kSchema, "'"});
+    return nullptr;
+  }
+
+  const std::string* name = RequiredString(dict, "name", error);
+  if (!name) {
+    return nullptr;
+  }
+  if (*name != expected_name) {
+    *error = StrCat({"artifact names persona '", *name, "' but '",
+                     expected_name, "' was selected"});
+    return nullptr;
+  }
+
+  // Present, not compared -- the same split as GlTable. base cannot see its own
+  // browser version; xrio and verify_probe.py refuse a stale pairing before
+  // launch. Requiring the field means an artifact with no provenance at all is
+  // refused outright.
+  const std::string* chrome_version =
+      RequiredString(dict, "chrome_version", error);
+  if (!chrome_version) {
+    return nullptr;
+  }
+  const std::string* digest = RequiredString(dict, "digest", error);
+  if (!digest) {
+    return nullptr;
+  }
+
+  // The row list is REQUIRED including when empty: a regeneration against a
+  // future capture may legitimately find nothing worth overriding yet, and an
+  // absent list must not be indistinguishable from a truncated file. An empty
+  // list parses to a table whose Find always misses, which is the honest
+  // reading of "measured, nothing differs".
+  const Value* rows_value = dict.Find("decode");
+  if (!rows_value || !rows_value->is_list()) {
+    *error = "missing or non-list field: decode";
+    return nullptr;
+  }
+  std::unique_ptr<MediaTable> table(new MediaTable());
+  table->name_ = *name;
+  table->chrome_version_ = *chrome_version;
+  table->digest_ = *digest;
+  for (const Value& item : rows_value->GetList()) {
+    if (!item.is_dict()) {
+      *error = "decode row is not an object";
+      return nullptr;
+    }
+    const DictValue& row = item.GetDict();
+    const std::string* family_name = RequiredString(row, "family", error);
+    if (!family_name) {
+      return nullptr;
+    }
+    MediaFamily family;
+    if (!FamilyFromName(*family_name, &family)) {
+      *error = StrCat({"unknown codec family: ", *family_name});
+      return nullptr;
+    }
+    auto dupes = [&](const Row& r) { return r.family == family; };
+    if (std::any_of(table->rows_.begin(), table->rows_.end(), dupes)) {
+      *error = StrCat({"duplicate codec family: ", *family_name});
+      return nullptr;
+    }
+    auto bool_field = [&](std::string_view key, bool* into) -> bool {
+      const Value* v = row.Find(key);
+      // FindByString-like: absent and wrong-typed are the same defect. A row
+      // that cannot say all three things about a family is not a measurement.
+      if (!v || !v->is_bool()) {
+        *error = StrCat({"row '", *family_name, "' missing bool: ", key});
+        return false;
+      }
+      *into = v->GetBool();
+      return true;
+    };
+    Row out;
+    out.family = family;
+    if (!bool_field("supported", &out.answer.supported) ||
+        !bool_field("smooth", &out.answer.smooth) ||
+        !bool_field("power_efficient", &out.answer.power_efficient)) {
+      return nullptr;
+    }
+    table->rows_.push_back(out);
+  }
+  return table;
+}
+
+bool MediaTable::Find(MediaFamily family, DecodingAnswer* answer) const {
+  for (const Row& row : rows_) {
+    if (row.family == family) {
+      *answer = row.answer;
+      return true;
+    }
+  }
+  return false;
+}
+
+void ExpandMediaTable(XrioConfig::Map* map) {
+  if (!map) {
+    return;
+  }
+  map->erase("media-table");
+  auto persona = map->find("gl-persona");
+  if (persona == map->end() || persona->second.empty()) {
+    // No persona selected: there is no machine to claim decode hardware FOR.
+    // A media artifact without a GL persona would put powerEfficient=true over
+    // honest SwiftShader strings -- the contradiction in isolation.
+    return;
+  }
+  auto dir = map->find("persona-dir");
+  std::optional<std::string> body = ReadMediaBody(
+      persona->second, dir == map->end() ? std::string() : dir->second);
+  if (!body.has_value()) {
+    // Absent artifact is a NORMAL state -- every persona deployed before the
+    // first media capture has none -- so unlike Parse this is not even an
+    // error. It is the fail-closed default the knob exists to opt out of.
+    return;
+  }
+  map->insert_or_assign("media-table", std::move(*body));
+}
+
+const MediaTable* ActiveMediaTable() {
+  struct Cache {
+    Lock lock;
+    bool primed GUARDED_BY(lock) = false;
+    uint32_t generation GUARDED_BY(lock) = 0;
+    raw_ptr<const MediaTable> active GUARDED_BY(lock) = nullptr;
+    std::vector<std::unique_ptr<MediaTable>> retained GUARDED_BY(lock);
+  };
+  static NoDestructor<Cache> cache;
+
+  // Generation read BEFORE our lock: the same order ActiveGlTable uses, and the
+  // only order anything uses, or the two caches could observe generations
+  // out of step.
+  const uint32_t generation = XrioConfig::Get().generation();
+  AutoLock guard(cache->lock);
+  if (cache->primed && cache->generation == generation) {
+    return cache->active;
+  }
+  std::unique_ptr<MediaTable> table;
+  const std::string body = XrioConfig::Get().GetString("media-table");
+  if (!body.empty()) {
+    const std::string name = XrioConfig::Get().GetString("gl-persona");
+    std::string error;
+    table = MediaTable::Parse(body, name, &error);
+    // `error` is dropped here on purpose, matching BuildActive: a renderer has
+    // no log worth writing to and no operator watching it. The launcher-side
+    // probes (--xrio-dump-config, verify_probe.py) are where an operator looks,
+    // and they see the absence as stock answers.
+  }
+  cache->active = table.get();
+  if (table) {
+    cache->retained.push_back(std::move(table));
+  }
+  cache->primed = true;
+  cache->generation = generation;
+  return cache->active;
+}
+
+void ApplyMediaPersona(MediaFamily family, DecodingAnswer* answer) {
+  if (family == MediaFamily::kNone) {
+    return;
+  }
+  // The knob is the per-target retreat: a ruleset can turn media off for one
+  // site without touching the GL surfaces, which is the same granularity the
+  // other group-3 enables have.
+  if (!GetBool("media-persona")) {
+    return;
+  }
+  const MediaTable* table = ActiveMediaTable();
+  if (!table) {
+    return;
+  }
+  table->Find(family, answer);
+}
+
+}  // namespace base::xrio
diff --git a/base/xrio_media_table.h b/base/xrio_media_table.h
new file mode 100644
index 0000000000000000000000000000000000000000..4c9ef4101c93a56363b73dac4bfd9ede7d884a86
--- /dev/null
+++ b/base/xrio_media_table.h
@@ -0,0 +1,152 @@
+#ifndef BASE_XRIO_MEDIA_TABLE_H_
+#define BASE_XRIO_MEDIA_TABLE_H_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/base_export.h"
+#include "base/xrio_config.h"
+
+namespace base::xrio {
+
+// One decode-capability persona: what `mediaCapabilities.decodingInfo()` should
+// answer for each codec family when the GL persona claims a GPU that has real
+// fixed-function decode hardware.
+//
+// THE CONTRADICTION THIS WAS BUILT TO CLOSE, AND THE MEASUREMENT THAT FOUND
+// THERE ISN'T ONE. The argument was: under SwiftShader there are no GPU video
+// factories, so `ResolveCallbackIfReady` answers powerEfficient=false and
+// smooth=false for every codec -- while our renderer string swears an AMD
+// RENOIR iGPU is present, a part whose UVD block hardware-decodes H.264 and
+// VP9. A page asks one promise and hears "this GPU does not exist" from a
+// browser whose other surfaces insist it does.
+//
+// Measured 2026-09-07 on basharsx4, the machine that OWNS that iGPU, one
+// binary and one host with the ANGLE backend as the only variable
+// (personas/media-captures/basharsx4-{amd-renoir,swiftshader}.json). Both arms
+// answer the same thing for every family: h264, vp8, vp9 and av1 supported and
+// smooth, hevc not supported, and powerEfficient FALSE on both. WebCodecs is
+// identical, including every `prefer-hardware` answer, and so is
+// `RTCRtpReceiver.getCapabilities`.
+//
+// So two halves of the original argument are wrong. `smooth` is true under
+// SwiftShader, not false; and the real RENOIR reports powerEfficient=false
+// too, because desktop Linux Chrome does not enable VA-API by default, so the
+// UVD block is never reached whoever owns it. There is no divergence to
+// correct on this hardware, which is why the generated artifact carries ZERO
+// decode rows and the mechanism ships inert. It is kept, not deleted: a host
+// with VA-API enabled, or a different claimed GPU, could still need it, and
+// the artifact records that the question was asked.
+//
+// Were there a divergence, this would ship under group 3's rule: together with
+// the persona or not at all, the same contradiction shape as strings over an
+// honest SwiftShader capability table (catalog section 3 #91).
+//
+// WHY A SEPARATE ARTIFACT AND NOT A "media" BLOCK IN .xrio-gl.json.
+// GlTable::kSchema is a contract version, bumped when the artifact's SHAPE
+// changes; folding media in would bump it to v2 and refuse every artifact
+// already deployed, which fails closed in the worst way -- honest SwiftShader
+// strings on hosts that were coherent yesterday. A sibling artifact keyed by
+// the same persona name keeps the deployed GL tables valid and gives media its
+// own capture/regenerate cycle. The cost is that the two files can disagree
+// about their shared name; Parse refuses any artifact whose name is not exactly
+// the selected persona, so both halves always answer for the same machine.
+//
+// KEYED BY FAMILY, NOT PROFILE. RENOIR's UVD either accelerates a family or
+// does not; the per-profile split H.264-baseline-vs-high is noise at the
+// resolution antibots probe. A table with profile rows we have no measurement
+// to fill would be invented values -- the thing personas/README.md forbids.
+// The five families below are the whole vocabulary.
+//
+// ALL OR NOTHING, twice over. Any defect in the artifact -- unknown schema,
+// wrong name, absent provenance fields, an unparseable row, a duplicate family,
+// a family outside the enum -- yields no table, and ApplyMediaPersona leaves
+// the backend's own answers standing. And the knob-file path is the same shape:
+// no "media-table" body in the config map means stock answers, never guessed
+// ones.
+
+// The codec families a page's decodingInfo probes can land on. kNone is the
+// caller's "keep the driver's own answer"; it is never stored in a row.
+enum class MediaFamily : uint32_t {
+  kNone = 0,
+  kH264 = 1,
+  kHevc = 2,
+  kVp8 = 3,
+  kVp9 = 4,
+  kAv1 = 5,
+};
+
+// The three answers one decodingInfo() resolve carries. Overwritten as a TRIPLE
+// or not at all: a row that moved powerEfficient while leaving supported alone
+// would claim hardware acceleration that cannot play, which is a sharper
+// contradiction than the one being removed.
+struct BASE_EXPORT DecodingAnswer {
+  bool supported;
+  bool smooth;
+  bool power_efficient;
+};
+
+class BASE_EXPORT MediaTable {
+ public:
+  // The only schema this build accepts. Independent of GlTable's version: the
+  // two artifacts evolve with different captures.
+  static constexpr std::string_view kSchema = "xrio-media-table/v1";
+
+  // Same contract as GlTable::Parse: refuses anything that is not exactly the
+  // selected persona, requires chrome_version and digest to be PRESENT (the
+  // comparison belongs to the launcher, which can see its own version), and
+  // returns nullptr with an operator-readable error on any defect.
+  static std::unique_ptr<MediaTable> Parse(std::string_view json,
+                                           std::string_view expected_name,
+                                           std::string* error);
+
+  MediaTable(const MediaTable&) = delete;
+  MediaTable& operator=(const MediaTable&) = delete;
+  ~MediaTable();
+
+  const std::string& name() const { return name_; }
+  const std::string& chrome_version() const { return chrome_version_; }
+  const std::string& digest() const { return digest_; }
+
+  // True and overwrites `answer` when this table covers `family`. False means
+  // the caller keeps the backend's own answer -- the same miss semantics as
+  // GlTable::FindInt.
+  bool Find(MediaFamily family, DecodingAnswer* answer) const;
+
+ private:
+  MediaTable();
+
+  struct Row {
+    MediaFamily family;
+    DecodingAnswer answer;
+  };
+
+  std::string name_;
+  std::string chrome_version_;
+  std::string digest_;
+  std::vector<Row> rows_;
+};
+
+// Expands `map`'s "gl-persona" name into a "media-table" body, in place, from
+// `<persona>.xrio-media.json` beside the GL artifact. Absent file, unusable
+// name, oversized read: "media-table" stays absent, which downstream is stock
+// answers. Called next to ExpandGlTable in RenderProcessHostImpl::Init -- the
+// one site that may block -- so the renderer still never touches a path.
+BASE_EXPORT void ExpandMediaTable(XrioConfig::Map* map);
+
+// The active table for this process, lazily parsed and cached against
+// XrioConfig::generation(), or nullptr. nullptr is also the answer for every
+// defect; callers must not distinguish.
+BASE_EXPORT const MediaTable* ActiveMediaTable();
+
+// The one entry point Blink sees. Leaves `answer` untouched unless a row
+// covers `family`, the "media-persona" knob is true, and a table parsed clean;
+// every other path is the backend's own answer.
+BASE_EXPORT void ApplyMediaPersona(MediaFamily family, DecodingAnswer* answer);
+
+}  // namespace base::xrio
+
+#endif  // BASE_XRIO_MEDIA_TABLE_H_
diff --git a/base/xrio_media_table_unittest.cc b/base/xrio_media_table_unittest.cc
