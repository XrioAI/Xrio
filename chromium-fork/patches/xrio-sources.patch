+// The table is DATA now, not a compiled constant, so the fixture installs one.
+// Before, an unrecognised --xrio-gl-persona failed a string compare against
+// kGlPersonaName; now GlTable::Parse refuses an artifact whose name is not the
+// selected one. Same end state -- every GL surface untouched -- and this test
+// exists to hold that equivalence.
+constexpr char kPersona[] = "basharsx4-amd-renoir";
+constexpr char kArtifact[] = R"json({
+  "schema": "xrio-gl-table/v2",
+  "name": "basharsx4-amd-renoir",
+  "chrome_version": "151.0.7922.108",
+  "vendor": "Google Inc. (AMD)",
+  "renderer": "ANGLE (AMD, Vulkan 1.3.255 (RADV RENOIR), radv)",
+  "form_factor": "laptop",
+  "max_threads": 16,
+  "ints": [[3379, 16384]],
+  "floats": [],
+  "float_arrays": [],
+  "int_arrays": [],
+  "hidden_extensions": ["WEBGL_compressed_texture_astc"],
+  "digest": "sha256:0000"
+})json";
+
+// THE PERSONA CAPS THE MACHINE CLASS. 0x164C is Lucienne, a Ryzen 5000U mobile
+// part: 16 threads at most. The default table's [24, 32, 700, 2] row is a
+// machine that iGPU was never in, and before v2 nothing related the two keys,
+// so 2 seeds in 100 drew it.
+TEST(XrioPersonaTest, RenoirPersonaCannotDrawTwentyFourUnderAnySeed) {
+  // Every row the default table has, so the test fails if a wider one is added
+  // without thinking about the ceiling.
+  const std::string wide =
+      "[[4,8,120,12],[8,8,120,8],[6,16,200,10],[8,16,250,26],[16,16,300,8],"
+      "[12,16,400,16],[12,32,500,8],[16,32,500,10],[24,32,700,2]]";
+  const unsigned host = HostThreadCeiling();
+  bool drew_something = false;
+  for (int i = 1; i <= 400; ++i) {
+    XrioConfig::Get().SetAll({{"seed", NumberToString(i * 0x9E3779B97F4A7C15ull)},
+                             {"machine-classes", wide},
+                             {"gl-persona", kPersona},
+                             {"gl-table", kArtifact}});
+    std::optional<unsigned> cores = HardwareConcurrency();
+    if (!cores.has_value()) {
+      continue;
+    }
+    drew_something = true;
+    EXPECT_LE(*cores, 16u) << "seed " << i << " drew a machine the claimed "
+                              "iGPU cannot sit in";
+    EXPECT_LE(*cores, host) << "seed " << i << " drew more cores than the host "
+                               "has, which a page checks by counting workers";
+  }
+  EXPECT_TRUE(drew_something) << "the loop proved nothing if nothing drew";
+  XrioConfig::Get().SetAll({});
+}
