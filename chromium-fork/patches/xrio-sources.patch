@@ -0,0 +1,223 @@
+#ifndef BASE_XRIO_PERTURB_H_
+#define BASE_XRIO_PERTURB_H_
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string_view>
+
+#include "base/base_export.h"
+#include "base/containers/span.h"
+
+namespace base::xrio {
+
+// Seeded, coordinate-keyed readback perturbation. THE reason this fork exists.
+//
+// Under SwiftShader the canvas and WebGL readback hashes are bit-stable
+// constants -- identical across launches, profiles and hosts. That is a hard
+// cross-session join key: it groups every render we produce into one bucket
+// regardless of exit IP, cookies or session profile, so one blocklisted hash
+// bans the fleet. A dedicated GPU has the same defect per-host rather than
+// fleet-wide, so this is required on both deployment targets.
+//
+// WHICH SURFACES THIS ACTUALLY REACHES TODAY: canvas2d only, and only on an
+// opt-in. `perturb-canvas` defaults false (creepjs holds its own ground truth
+// for canvas2d, so no mask survives there) and the WebGL readback hook was
+// REMOVED on 2026-09-07 -- two paths read one framebuffer and the hook made
+// them disagree, which is a stronger fingerprint than the constant hash it was
+// masking. So the join key described above is currently OPEN on both pixel
+// surfaces, recorded in fork/unbranded-tells.md §3 rather than covered here;
+// the honest fix is a rendering stack whose output matches the claimed GPU.
+// fork/readback-perturbation.md has the measurement and the argument.
+//
+// Three properties, and all three are load-bearing:
+//
+//   Deterministic per seed. A surface read twice must return the same bytes. A
+//   fresh draw per read is itself the detection signal (catalog SS2 #46).
+//
+//   Keyed on ABSOLUTE canvas coordinates, never on buffer offset. getImageData
+//   on a sub-rect and toDataURL on the whole canvas must agree pixel-for-pixel
+//   where they overlap, or the disagreement is a stronger tell than the
+//   constant hash was (catalog SS2 #50, SS3 #98).
+//
+//   Sparse and low-bit only. The rendered page IS the product. Only the low bit
+//   of a colour channel moves, on roughly one pixel in eight -- enough to change
+//   a hash completely, not enough to change a pixel any human or diff can see.
+//   Dense LSB noise across a flat region is its own anomaly; real rasterisers do
+//   not produce it.
+//
+// EVERY MAGNITUDE BELOW IS A KNOB. The rate, the bit that moves, the audio
+// scale range and the geometry step are `pixel-rate-mask`, `pixel-bit-mask`,
+// `audio-scale-floor`/`audio-scale-span` and
+// `jitter-quantum`/`jitter-steps`/`jitter-step-size` in xrio_knobs.h. The numbers
+// quoted in this file are their DEFAULTS, chosen by measurement and reproduced
+// exactly when no flag is passed -- but they are judgements that will be
+// revised, and a five-hour rebuild is the wrong price for revising one.
+
+// Sub-seed for one surface class, derived from the single `--xrio-seed` master.
+//
+// One flag, many independent streams: `Seed("canvas")` and `Seed("audio")` are
+// uncorrelated, so learning one tells an observer nothing about the other, and
+// xrio still has one value to derive from the session profile id. Same shape
+// as xrio's own _profile_rng(profile_root, purpose).
+//
+// FAILS CLOSED. No master seed means nullopt for every purpose, and callers must
+// then leave their surface exactly as it was produced. Never substitute a
+// constant: Fortress falls back to 0x9e3779b9 when its seed is unset, which
+// reproduces a fleet-wide constant hash at a different value -- the exact defect
+// this exists to remove (catalog SS3 #98).
+//
+// The purpose TAGS are knobs (`seed-purpose-canvas` and friends), which is a
+// fleet-wide re-roll lever that does not touch any per-profile seed. The tags
+// for canvas2d, the WebGL readback and the encode path are deliberately ONE
+// knob: they must stay equal or a sub-rect read and a whole-canvas read
+// disagree, which is louder than the constant hash either would have had.
+BASE_EXPORT std::optional<uint64_t> Seed(std::string_view purpose);
+
+// Seed("canvas"). Named because its call sites share it and they MUST.
+//
+// TWO call sites, not three, since 2026-09-07: canvas2d's getImageData and the
+// toDataURL/toBlob encode path. The WebGL readback was the third and it is gone
+// (fork/readback-perturbation.md -- the hooked readPixels() disagreed with the
+// unhooked encode path on one framebuffer, which is a sharper tell than the
+// constant hash it masked). Both remaining callers ship DISABLED
+// (`perturb-canvas` defaults false), so in the shipping configuration this seed
+// keys NOTHING and every pixel surface is the renderer's own. The sharing still
+// has to be here: turning `perturb-canvas` back on for one target must not
+// produce a build where the two canvas paths key differently. The purpose TAG
+// stays "canvas" for the same reason its constants are not tuning -- changing
+// it re-rolls every seeded value and invalidates every reference capture.
+BASE_EXPORT std::optional<uint64_t> CanvasSeed();
+
+// The audio sub-seed. Named for the same reason as CanvasSeed(): the purpose tag
+// is a knob now, and a hook site should never have to name a knob key -- that is
+// how two call sites end up reading different keys for the same stream.
+BASE_EXPORT std::optional<uint64_t> AudioSeed();
+
+// The geometry sub-seed, and nullopt unless `--xrio-jitter-geometry` is ALSO on.
+//
+// Read as a BOOLEAN, not as presence. It used to be `Has("jitter-geometry")`,
+// which meant `--xrio-jitter-geometry=false` switched it ON -- the same shape as
+// a knob that reads as working while doing nothing. A bare valueless switch
+// still reads as true, so no existing launch changes.
+//
+// Separately opted in because it is the one perturbation whose risk is not
+// clearly worth it. Text metrics and element rects are font-derived, so like
+// `math` they describe a platform CLASS -- every Linux Chrome with the same
+// fontconfig reports the same numbers, and moving ours makes us differ from real
+// Chrome rather than from our own other profiles. It buys per-profile entropy on
+// a surface fingerprinters do read, but on a surface where being unusual is its
+// own signal. Ship it deliberately, and it is the first thing to drop if a
+// target starts failing.
+BASE_EXPORT std::optional<uint64_t> GeometrySeed();
+
+// Flips the low bit of a colour channel on a sparse, deterministic subset of the
+// pixels in `pixels`, keyed on each pixel's absolute canvas coordinate.
+//
+// `row_bytes` is the stride, which may exceed `width * bytes_per_pixel`; padding
+// is never touched. `origin_x` / `origin_y` place this buffer's top-left corner
+// in canvas space -- pass the sub-rect origin for a partial read and (0, 0) for
+// a whole-canvas one, which is what makes the two agree.
+//
+// A pixel whose three COLOUR bytes equal `skip_colour` is NEVER touched.
+//
+// It defaults to black, which covers both cleared canvas2d states -- clearRect's
+// (0,0,0,0) and an `{alpha: false}` WebGL context's (0,0,0,255). creepjs's
+// cheapest canvas check is `Math.max(...getImageData(...).data) === 0` after a
+// clearRect, with no ground truth needed, so a single flipped bit there is free
+// for the detector. Alpha is not part of the test, so a transparent pixel that
+// is not black still moves: this is a colour test, not an alpha test. The price
+// is that the skip colour is never perturbed anywhere, which is the right trade
+// -- an untouched flat region is what a real rasteriser produces.
+//
+// IT IS A PARAMETER BECAUSE WEBGL USED TO PASS ITS LIVE CLEAR COLOUR, and no
+// caller passes a non-default any more. `gl.clearColor(0.2, 0.6, 0.9, 1);
+// gl.clear(); readPixels()` is a GROUND-TRUTH read -- the page chose the
+// colour, the float-to-unorm8 conversion is exact, so it knows precisely what
+// every pixel must be -- and MEASURED on the v2 build a flat clear read back in
+// FOUR colours against stock's one, which black alone did not cover.
+//
+// That caller was removed on 2026-09-07 with the WebGL readback perturbation
+// (fork/readback-perturbation.md). The parameter is RETAINED, not dead weight:
+// it is the same ground-truth argument for any future caller with a
+// caller-known background, the unit tests cover it, and the alternative -- a
+// hardcoded black skip -- is the exact defect the v2 measurement found. Both
+// remaining callers are canvas2d, where the cleared state IS black, so they
+// take the default.
+//
+// One edge worth keeping written down, because it was half the reason the WebGL
+// hook was not coherent: the value a caller can query is the CURRENT clear
+// colour, so a page that clears to A, draws, then sets the clear colour to B
+// before reading would get its A-coloured background perturbed. Changing
+// `clearColor` WITHOUT clearing could therefore change the readback of an
+// unchanged framebuffer -- state dependence a real driver does not have.
+//
+// Why not the stronger "never perturb a uniform REGION": that needs a pixel's
+// neighbours, and a neighbour may lie outside the rectangle the caller asked
+// for. Pixel (3,3) is interior to readPixels(0,0,8,8) and on the border of
+// readPixels(0,0,4,4), so the two reads would disagree on a one-pixel ring --
+// breaking the crop coherence the whole design rests on (SS2 #50, SS3 #98). A
+// value test is local, so it is identical under every crop.
+//
+// The test is per-pixel and therefore identical under every crop, which the
+// stronger "leave uniform regions alone" form is not: a four-neighbour test
+// makes a pixel's fate depend on whether the requested rectangle happens to
+// contain its neighbours, and a sub-rect read would then disagree with a
+// whole-canvas read on a one-pixel ring.
+//
+// No-op unless `bytes_per_pixel` is 4. Every readback surface we care about is
+// 8-bit RGBA or BGRA; for those the fourth byte is alpha under both orders, so
+// only the first three are touched and channel order does not matter. Anything
+// else (F16, and any future wide format) is passed through untouched rather than
+// guessed at.
+//
+// Takes a span rather than (pointer, length): base/ enforces
+// -Wunsafe-buffer-usage as an error, and span's (ptr, count) constructor is
+// itself UNSAFE_BUFFER_USAGE. Every caller has a typed accessor that yields a
+// span directly -- DOMArrayBufferView::ByteSpanMaybeShared(),
+// gfx::SkPixmapToWritableSpan() -- so no raw pointer is ever formed, and the
+// subspan arithmetic below is bounds-checked instead of merely careful.
+BASE_EXPORT void PerturbPixels(span<uint8_t> pixels,
+                               size_t row_bytes,
+                               int width,
+                               int height,
+                               int bytes_per_pixel,
+                               int origin_x,
+                               int origin_y,
+                               uint64_t seed,
+                               std::array<uint8_t, 3> skip_colour = {0, 0, 0});
+
+// Multiplies a rendered audio channel by a per-profile factor very close to 1.
+//
+// A scale, not noise: it preserves the waveform's shape, so nothing about the
+// audio graph's behaviour changes, while the readback hash and the summed
+// magnitude that audio fingerprints actually compare both move. The range is
+// [`audio-scale-floor`, floor + `audio-scale-span`), defaulting to
+// [0.9990, 1.0000). Repeated reads
+// agree because it is applied once, when the buffer is created from the rendered
+// bus -- perturbing on read would compound with every call.
+//
+// Measured on basharsx4: the OfflineAudioContext readback hash is identical
+// across fresh profiles, which makes it the same class of join key as the canvas
+// hash. No-op when no seed is configured.
+BASE_EXPORT void ScaleAudioChannel(span<float> samples, unsigned channel_index);
+
+// Returns `value` nudged by a fraction of a pixel, deterministically.
+//
+// Keyed on the VALUE, never on screen position, and that is the whole design.
+// Fortress jitters each corner relative to p1 for the same reason (catalog
+// SS3 #90): a rect whose width changes when the page scrolls is a stronger
+// signal than a constant one, and per-coordinate noise -- Bromite's version,
+// which SS1 #37 marks AVOID -- does exactly that. Keyed on the value, a 100px
+// box reports the same 100.0137px wherever it sits and however the page moves.
+//
+// Returns `value` unchanged when no seed is set, when it is not finite, or when
+// it is zero -- a zero-size rect must stay zero-size. That last one is NOT a
+// knob: a `display:none` box reporting a sub-pixel size is an invariant break a
+// page can check with no reference machine.
+BASE_EXPORT double JitterDimension(double value, uint64_t seed);
+
+}  // namespace base::xrio
+
+#endif  // BASE_XRIO_PERTURB_H_
diff --git a/base/xrio_perturb_unittest.cc b/base/xrio_perturb_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..83965fa5d97c743823e878af01f285b9efd965d0
--- /dev/null
+++ b/base/xrio_perturb_unittest.cc
@@ -0,0 +1,400 @@
+#include "base/xrio_perturb.h"
+
+#include <array>
+#include <cmath>
+#include <vector>
+
+#include "base/xrio_config.h"
+#include "base/xrio_persona.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace base::xrio {
+namespace {
+
+constexpr int kW = 64;
+constexpr int kH = 48;
+constexpr uint64_t kSeed = 0x5eed1234;
+
+// A canvas with structure rather than a flat fill, so a bug that only shows on
+// non-uniform data has somewhere to show.
+std::vector<uint8_t> Canvas(int width = kW, int height = kH) {
+  std::vector<uint8_t> pixels(static_cast<size_t>(width) * height * 4);
+  for (size_t i = 0; i < pixels.size(); ++i) {
+    pixels[i] = static_cast<uint8_t>((i * 7 + (i >> 5)) & 0xFF);
+  }
+  return pixels;
+}
+
+void Perturb(std::vector<uint8_t>& pixels, int width, int height,
+             int origin_x = 0, int origin_y = 0, uint64_t seed = kSeed) {
+  PerturbPixels(pixels, static_cast<size_t>(width) * 4, width, height,
+                /*bytes_per_pixel=*/4, origin_x, origin_y, seed);
+}
+
+size_t CountDiff(const std::vector<uint8_t>& a, const std::vector<uint8_t>& b) {
+  size_t n = 0;
+  for (size_t i = 0; i < a.size(); ++i) {
+    n += (a[i] != b[i]);
+  }
+  return n;
+}
+
+TEST(XrioPerturbTest, SameSeedProducesTheSameBytes) {
+  auto a = Canvas(), b = Canvas();
+  Perturb(a, kW, kH);
+  Perturb(b, kW, kH);
+  EXPECT_EQ(a, b) << "a surface read twice must return identical bytes; a fresh "
+                     "draw per read is itself the detection signal";
+}
+
+TEST(XrioPerturbTest, DifferentSeedsProduceDifferentBytes) {
+  auto a = Canvas(), b = Canvas();
+  Perturb(a, kW, kH, 0, 0, kSeed);
+  Perturb(b, kW, kH, 0, 0, kSeed + 1);
+  EXPECT_NE(a, b);
+}
+
+TEST(XrioPerturbTest, ItActuallyChangesSomething) {
+  auto original = Canvas(), perturbed = Canvas();
+  Perturb(perturbed, kW, kH);
+  const size_t changed = CountDiff(original, perturbed);
+  EXPECT_GT(changed, 0u) << "no change means the constant readback hash survives";
+  // Roughly one pixel in eight of 3072; wide bounds, this asserts the rate is in
+  // the right order of magnitude, not its exact value.
+  EXPECT_GT(changed, 100u);
+  EXPECT_LT(changed, 1000u);
+}
+
+TEST(XrioPerturbTest, OnlyTheLowBitOfOneColourChannelMoves) {
+  auto original = Canvas(), perturbed = Canvas();
+  Perturb(perturbed, kW, kH);
+  for (size_t i = 0; i < original.size(); ++i) {
+    if (original[i] == perturbed[i]) {
+      continue;
+    }
+    EXPECT_EQ(original[i] ^ 1, perturbed[i]) << "byte " << i << " moved by more "
+                                                "than its low bit";
+    EXPECT_NE(3u, i % 4) << "byte " << i << " is alpha and must never move";
+  }
+}
+
+// The property the whole design turns on: a sub-rect read and a whole-canvas
+// read must agree where they overlap. Keying on the buffer offset instead of the
+// absolute canvas coordinate breaks exactly this, and the disagreement is a
+// sharper signal than the constant hash was.
+TEST(XrioPerturbTest, SubRectAgreesWithTheWholeCanvas) {
+  auto whole = Canvas();
+  Perturb(whole, kW, kH);
+
+  constexpr int kSubX = 16, kSubY = 8, kSubW = 20, kSubH = 12;
+  auto sub = Canvas(kSubW, kSubH);
+  // Copy the untouched sub-rect out of a fresh canvas, then perturb it as
+  // getImageData(sx, sy, sw, sh) would.
+  auto source = Canvas();
+  // Spans, not memcpy: base/ enforces -Wunsafe-buffer-usage-in-libc-call, and
+  // the bounds are checked rather than merely reasoned about.
+  span<uint8_t> sub_span(sub);
+  span<const uint8_t> source_span(source);
+  constexpr size_t kSubRowBytes = static_cast<size_t>(kSubW) * 4;
+  for (int row = 0; row < kSubH; ++row) {
+    sub_span.subspan(static_cast<size_t>(row) * kSubRowBytes, kSubRowBytes)
+        .copy_from(source_span.subspan(
+            (static_cast<size_t>(kSubY + row) * kW + kSubX) * 4, kSubRowBytes));
+  }
+  Perturb(sub, kSubW, kSubH, kSubX, kSubY);
+
+  for (int row = 0; row < kSubH; ++row) {
+    for (int col = 0; col < kSubW * 4; ++col) {
+      ASSERT_EQ(whole[(static_cast<size_t>(kSubY + row) * kW + kSubX) * 4 + col],
+                sub[static_cast<size_t>(row) * kSubW * 4 + col])
+          << "row " << row << " byte " << col;
+    }
+  }
+}
+
+// creepjs's cheapest canvas check: `Math.max(...getImageData(...).data) === 0`
+// after clearRect. It needs no ground truth at all, so one flipped bit in a
+// cleared buffer is free for the detector -- and the fork returned 1.
+TEST(XrioPerturbTest, AClearedBufferReadsBackAsZero) {
+  std::vector<uint8_t> cleared(static_cast<size_t>(kW) * kH * 4, 0);
+  Perturb(cleared, kW, kH);
+  for (uint8_t byte : cleared) {
+    ASSERT_EQ(0u, byte) << "a cleared region must read back exactly zero";
+  }
+}
+
+// The test above must not be passing because nothing is perturbed at all: the
+// skip is per-pixel, so a cleared pixel next to a drawn one still reads zero
+// while the drawn one moves.
+TEST(XrioPerturbTest, TheClearedSkipIsPerPixelNotWholeBuffer) {
+  auto pixels = Canvas();
+  // Clear the first half of row 0, leave the rest as drawn.
+  for (int x = 0; x < kW / 2; ++x) {
+    for (int c = 0; c < 4; ++c) {
+      pixels[static_cast<size_t>(x) * 4 + c] = 0;
+    }
+  }
+  auto before = pixels;
+  Perturb(pixels, kW, kH);
+  for (int x = 0; x < kW / 2; ++x) {
+    for (int c = 0; c < 4; ++c) {
+      ASSERT_EQ(0u, pixels[static_cast<size_t>(x) * 4 + c]);
+    }
+  }
+  EXPECT_GT(CountDiff(before, pixels), 0u)
+      << "the rest of the buffer must still be perturbed";
+}
+
+// The measured v2 residual: gl.clearColor(0.2,0.6,0.9,1) + readPixels read back
+// in FOUR colours against stock's one. A clear is a GROUND-TRUTH read -- the page
+// chose the colour -- so the caller hands us that colour to leave alone.
+TEST(XrioPerturbTest, AFlatClearInTheSkipColourReadsBackAsOneColour) {
+  const std::array<uint8_t, 3> clear = {51, 153, 229};  // 0.2, 0.6, 0.9
+  std::vector<uint8_t> pixels(static_cast<size_t>(kW) * kH * 4);
+  for (size_t i = 0; i < pixels.size(); i += 4) {
+    pixels[i] = clear[0];
+    pixels[i + 1] = clear[1];
+    pixels[i + 2] = clear[2];
+    pixels[i + 3] = 255;
+  }
+  auto before = pixels;
+  PerturbPixels(pixels, static_cast<size_t>(kW) * 4, kW, kH,
+                /*bytes_per_pixel=*/4, 0, 0, kSeed, clear);
+  EXPECT_EQ(before, pixels) << "a flat clear must read back in ONE colour";
+
+  // And the skip colour is the CALLER's, not a constant: the same buffer with
+  // the default (black) skip is perturbed, or the parameter is doing nothing.
+  auto with_default_skip = before;
+  Perturb(with_default_skip, kW, kH);
+  EXPECT_GT(CountDiff(before, with_default_skip), 0u);
+}
+
+// Drawn content in a buffer that was cleared to a non-black colour must still
+// move, or the skip becomes "perturb nothing" on any page that sets a clear
+// colour.
+TEST(XrioPerturbTest, TheSkipColourDoesNotSpareDrawnPixels) {
+  const std::array<uint8_t, 3> clear = {51, 153, 229};
+  auto pixels = Canvas();
+  auto before = pixels;
+  PerturbPixels(pixels, static_cast<size_t>(kW) * 4, kW, kH,
+                /*bytes_per_pixel=*/4, 0, 0, kSeed, clear);
+  EXPECT_GT(CountDiff(before, pixels), 0u);
+}
+
+// The skip tests the three COLOUR bytes and not alpha, and the reason is a
+// cleared buffer that is not (0,0,0,0): a WebGL context created {alpha: false}
+// clears to (0,0,0,255). An alpha test would leave R/G/B moving inside a
+// cleared buffer a page can read with no ground truth at all.
+//
+// THE JUSTIFICATION USED TO NAME readPixels AS "the one surface still perturbed
+// at the shipping default", and both halves of that are now false: the WebGL
+// readback perturbation was removed 2026-09-07
+// (fork/readback-perturbation.md), and perturb-canvas defaults off. The RULE
+// still stands on the canvas2d opt-in, which reaches this same helper and can
+// be handed an opaque-black cleared buffer by an {alpha: false} offscreen
+// context -- so this is a property of PerturbPixels, not of one caller.
+TEST(XrioPerturbTest, AnOpaqueBlackBufferReadsBackAsOpaqueBlack) {
+  std::vector<uint8_t> cleared(static_cast<size_t>(kW) * kH * 4);
+  for (size_t i = 0; i < cleared.size(); i += 4) {
+    cleared[i] = cleared[i + 1] = cleared[i + 2] = 0;
+    cleared[i + 3] = 255;
+  }
+  auto before = cleared;
+  Perturb(cleared, kW, kH);
+  EXPECT_EQ(before, cleared)
+      << "a gl.clear() on an alpha:false context must read back exactly";
+}
+
+// A fully transparent pixel that is not black is NOT a cleared pixel, and it
+// must still be perturbed -- otherwise the skip becomes an alpha test and a page
+// can read the mask's shape off a translucent canvas.
+TEST(XrioPerturbTest, TransparentButNotBlackIsStillPerturbed) {
+  std::vector<uint8_t> pixels(static_cast<size_t>(kW) * kH * 4);
+  for (size_t i = 0; i < pixels.size(); i += 4) {
+    pixels[i] = 0x40;
+    pixels[i + 1] = 0x80;
+    pixels[i + 2] = 0xC0;
+    pixels[i + 3] = 0x00;
+  }
+  auto before = pixels;
+  Perturb(pixels, kW, kH);
+  EXPECT_GT(CountDiff(before, pixels), 0u);
+}
+
+TEST(XrioPerturbTest, RefusesGeometryTheBufferCannotHold) {
+  auto pixels = Canvas(4, 4);
+  const auto original = pixels;
+  // Claims twice the rows the buffer holds. Must refuse outright rather than
+  // clamp: writing on a guess is how a fingerprint patch becomes a memory bug.
+  PerturbPixels(pixels, 4 * 4, 4, 8, 4, 0, 0, kSeed);
+  EXPECT_EQ(original, pixels);
+}
+
+TEST(XrioPerturbTest, PassesThroughFormatsItDoesNotUnderstand) {
+  auto pixels = Canvas();
+  const auto original = pixels;
+  PerturbPixels(pixels, kW * 8, kW, kH, /*bytes_per_pixel=*/8, 0, 0, kSeed);
+  EXPECT_EQ(original, pixels);
+}
+
+TEST(XrioPerturbTest, HonoursRowPaddingWithoutTouchingIt) {
+  constexpr int kWidth = 5, kHeight = 4;
+  constexpr size_t kStride = kWidth * 4 + 12;  // deliberately padded
+  std::vector<uint8_t> pixels(kStride * kHeight, 0xAB);
+  const auto original = pixels;
+  PerturbPixels(pixels, kStride, kWidth, kHeight, 4, 0, 0, kSeed);
+  for (int row = 0; row < kHeight; ++row) {
+    for (size_t i = kWidth * 4; i < kStride; ++i) {
+      EXPECT_EQ(original[row * kStride + i], pixels[row * kStride + i])
+          << "padding byte " << i << " on row " << row << " was written";
+    }
+  }
+}
+
+TEST(XrioPerturbTest, SeedFailsClosed) {
+  XrioConfig::Get().SetAll({});
+  EXPECT_FALSE(Seed("canvas").has_value());
+  EXPECT_FALSE(CanvasSeed().has_value());
+  XrioConfig::Get().SetAll({{"seed", "0"}});
+  EXPECT_FALSE(CanvasSeed().has_value()) << "zero must not enable perturbation";
+  XrioConfig::Get().SetAll({{"seed", "0x2b"}});
+  EXPECT_TRUE(CanvasSeed().has_value());
+}
+
+TEST(XrioPerturbTest, PurposesAreIndependentStreams) {
+  XrioConfig::Get().SetAll({{"seed", "0x2b"}});
+  EXPECT_NE(Seed("canvas").value(), Seed("audio").value());
+  EXPECT_NE(Seed("audio").value(), Seed("machine").value());
+  // ...and each is stable across calls, or nothing downstream reproduces.
+  EXPECT_EQ(Seed("canvas").value(), Seed("canvas").value());
+  // A different master must move every stream.
+  const uint64_t canvas_a = Seed("canvas").value();
+  XrioConfig::Get().SetAll({{"seed", "0x2c"}});
+  EXPECT_NE(canvas_a, Seed("canvas").value());
+}
+
+// Opted into separately from the master seed -- see GeometrySeed()'s comment.
+TEST(XrioPerturbTest, GeometryJitterNeedsItsOwnOptIn) {
+  XrioConfig::Get().SetAll({{"seed", "0x2b"}});
+  EXPECT_FALSE(GeometrySeed().has_value());
+  XrioConfig::Get().SetAll({{"seed", "0x2b"}, {"jitter-geometry", ""}});
+  EXPECT_TRUE(GeometrySeed().has_value());
+  XrioConfig::Get().SetAll({{"jitter-geometry", ""}});
+  EXPECT_FALSE(GeometrySeed().has_value()) << "opt-in alone must not perturb";
+}
+
+TEST(XrioPerturbTest, JitterIsStableSmallAndMostlyNonZero) {
+  constexpr uint64_t kS = 0x1234;
+
+  // Swept rather than asserted on one value. The offset is drawn from 41 steps
+  // centred on zero, so roughly 1 value in 41 legitimately comes back unchanged;
+  // EXPECT_NE on a single hard-coded value would be a coin flip that happens to
+  // land, and would silently become a real coin flip if the constant moved.
+  int moved = 0;
+  for (int i = 1; i <= 400; ++i) {
+    const double v = i * 0.5;
+    const double j = JitterDimension(v, kS);
+    EXPECT_EQ(j, JitterDimension(v, kS)) << "unstable at " << v;
+    EXPECT_LT(std::abs(j - v), 0.03) << "moved too far at " << v;
+    moved += (j != v);
+  }
+  EXPECT_GT(moved, 350) << "far too many values came back unchanged";
+
+  // A zero-size rect must stay zero-size, and non-finite input passes through.
+  EXPECT_EQ(0.0, JitterDimension(0.0, kS));
+
+  // Same value, same jitter, wherever it appears -- this is what makes the
+  // result scroll-invariant.
+  EXPECT_EQ(JitterDimension(101.5, kS), JitterDimension(101.5, kS));
+}
+
+TEST(XrioPerturbTest, AudioScaleIsInaudibleStableAndPerChannel) {
+  XrioConfig::Get().SetAll({{"seed", "0x77"}});
+  std::vector<float> left(256, 0.5f), right(256, 0.5f), again(256, 0.5f);
+  ScaleAudioChannel(span(left), 0);
+  ScaleAudioChannel(span(right), 1);
+  ScaleAudioChannel(span(again), 0);
+
+  EXPECT_EQ(left, again) << "same channel, same seed -> same samples";
+  EXPECT_NE(left, right) << "channels must not move in lockstep";
+  EXPECT_NE(left[0], 0.5f);
+  EXPECT_LT(std::abs(left[0] - 0.5f), 0.5f * 0.002f) << "must stay inaudible";
+}
+
+TEST(XrioPerturbTest, AudioScaleFailsClosed) {
+  XrioConfig::Get().SetAll({});
+  std::vector<float> samples(16, 0.25f);
+  const auto original = samples;
+  ScaleAudioChannel(span(samples), 0);
+  EXPECT_EQ(original, samples);
+}
+
+// ---------------------------------------------------------------------------
+// The shipping default, asserted through the GATE rather than around it.
+//
+// The two tests above call ScaleAudioChannel() directly, which is right for
+// testing the transform and wrong for testing what a page gets: the knob is
+// read at the two Blink hook sites, not inside the transform, so neither of
+// them can see `perturb-audio` at all. `Hooked()` below is exactly what
+// audio_buffer.cc's patched constructor does -- the enable, then the call --
+// so a default that drifts back to true fails here.
+//
+// The signals are the ones a page can hold ground truth for with no reference
+// machine: a DC constant, and a buffer round-tripped at unity gain. A scale
+// applied to every sample of a completed buffer changes both, and the page
+// already knows what both should be.
+void Hooked(span<float> samples, unsigned channel_index) {
+  if (PerturbAudioBuffersEnabled()) {
+    ScaleAudioChannel(samples, channel_index);
+  }
+}
+
+TEST(XrioPerturbTest, AKnownSignalSurvivesTheShippingDefault) {
+  // A seed and nothing else: the configuration every seeded deployment runs.
+  XrioConfig::Get().SetAll({{"seed", "0x5ec0ffee5ec0ffee"}});
+
+  // A DC constant. Two channels, because a stereo pair carrying one signal is
+  // the cheapest coherence check there is -- the per-channel mixer moves them
+  // by different amounts, so a page comparing them sees a graph that split one
+  // input into two different outputs.
+  std::vector<float> left(256, 0.25f), right(256, 0.25f);
+  Hooked(span(left), 0);
+  Hooked(span(right), 1);
+  EXPECT_EQ(std::vector<float>(256, 0.25f), left) << "a constant must survive";
+  EXPECT_EQ(left, right) << "identical channels must stay identical";
+
+  // Unity gain, round-tripped: the output of one render fed into the next. Two
+  // passes is where a per-buffer scale compounds, and 0.999^2 is measurable
+  // against an input the page still holds.
+  std::vector<float> ramp(128);
+  for (size_t i = 0; i < ramp.size(); ++i) {
+    // Signed, spanning zero: a scale is sign-preserving but a page that only
+    // ever measured positive samples would not notice if that stopped being
+    // true.
+    ramp[i] = static_cast<float>(i) / 64.0f - 1.0f;
+  }
+  const auto original = ramp;
+  Hooked(span(ramp), 0);
+  Hooked(span(ramp), 0);
+  EXPECT_EQ(original, ramp) << "two unity-gain passes must be a no-op";
+
+  // Silence stays silence. Zero times any scale is zero, so this can only fail
+  // if something other than a multiply arrives here -- which is the point of
+  // asserting it rather than reasoning about it.
+  std::vector<float> silence(64, 0.0f);
+  Hooked(span(silence), 0);
+  EXPECT_EQ(std::vector<float>(64, 0.0f), silence);
+
+  // And the opt-in still reaches the same buffer, so this test cannot pass by
+  // the mechanism having been deleted.
+  XrioConfig::Get().SetAll(
+      {{"seed", "0x5ec0ffee5ec0ffee"}, {"perturb-audio", "true"}});
+  std::vector<float> opted(256, 0.25f);
+  Hooked(span(opted), 0);
+  EXPECT_NE(std::vector<float>(256, 0.25f), opted)
+      << "the opt-in is unreachable; this test would be vacuous";
+  XrioConfig::Get().SetAll({});
+}
