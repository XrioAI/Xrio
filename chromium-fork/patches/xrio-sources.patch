+// ---------------------------------------------------------------------------
+// Validation. This is the mechanism that turns a typo from a silent no-op into
+// a refused launch, so it is the single most important thing in the file.
+
+TEST_F(XrioKnobsTest, ValidationRefusesAnUnregisteredKey) {
+  std::string error;
+  EXPECT_FALSE(ValidateConfig({{"cavnas-rate", "7"}}, &error));
+  EXPECT_NE(std::string::npos, error.find("cavnas-rate"))
+      << "the message must name the key, or it is not actionable: " << error;
+}
+
+TEST_F(XrioKnobsTest, ValidationRefusesAWrongType) {
+  std::string error;
+  EXPECT_FALSE(ValidateConfig({{"pixel-rate-mask", "banana"}}, &error));
+  EXPECT_FALSE(ValidateConfig({{"audio-scale-floor", "loud"}}, &error));
+  EXPECT_FALSE(ValidateConfig({{"webdriver-false", "perhaps"}}, &error));
+  EXPECT_FALSE(ValidateConfig({{"machine-classes", "{not a list"}}, &error));
+  // Zero is refused for a seed, because GetSeed reports it as absent and an
+  // operator who passed it would get an untouched surface while believing they
+  // had keyed one.
+  EXPECT_FALSE(ValidateConfig({{"seed", "0"}}, &error));
+  EXPECT_TRUE(ValidateConfig({{"seed", "0x2b"}}, &error)) << error;
+}
+
+TEST_F(XrioKnobsTest, ValidationBoundsTheDisplayKnobs) {
+  std::string error;
+  EXPECT_TRUE(ValidateConfig({{"color-scheme", "dark"}}, &error)) << error;
+  EXPECT_TRUE(ValidateConfig({{"color-scheme", "light"}}, &error)) << error;
+  EXPECT_FALSE(ValidateConfig({{"color-scheme", "Dark"}}, &error));
+  EXPECT_FALSE(ValidateConfig({{"color-scheme", "auto"}}, &error));
+  EXPECT_TRUE(ValidateConfig({{"workarea-panel-height", "0"}}, &error))
+      << error;
+  EXPECT_TRUE(ValidateConfig({{"workarea-panel-height", "40"}}, &error))
+      << error;
+  EXPECT_FALSE(ValidateConfig({{"workarea-panel-height", "-1"}}, &error));
+  EXPECT_FALSE(ValidateConfig({{"workarea-panel-height", "tall"}}, &error));
+}
+
+TEST_F(XrioKnobsTest, ValidationRefusesADerivedKeyFromOutside) {
+  std::string error;
+  EXPECT_FALSE(ValidateConfig({{"gl-table", "{}"}}, &error));
+  EXPECT_NE(std::string::npos, error.find("gl-table"));
+}
+
+// The one cross-key rule. A GL string in front of no capability table is the
+// same contradiction xrio refuses --gl-persona without --chrome-path for:
+// the ledger would record a claim no process ever made.
+TEST_F(XrioKnobsTest, ValidationRefusesGlStringsWithoutAPersona) {
+  std::string error;
+  EXPECT_FALSE(ValidateConfig({{"gl-vendor", "Google Inc. (NVIDIA)"}}, &error));
+  EXPECT_NE(std::string::npos, error.find("gl-persona"));
+  EXPECT_FALSE(ValidateConfig({{"gl-renderer", "ANGLE (NVIDIA)"}}, &error));
+  // An empty value is absent, so it is not a claim and must not refuse a launch.
+  EXPECT_TRUE(ValidateConfig({{"gl-vendor", ""}}, &error)) << error;
+  EXPECT_TRUE(ValidateConfig({{"gl-persona", "basharsx4-amd-renoir"},
+                              {"gl-vendor", "Google Inc. (NVIDIA)"}},
+                             &error))
+      << error;
+}
+
+TEST_F(XrioKnobsTest, ValidationEnforcesConstraintsBeyondTheType) {
+  std::string error;
+  // 2^k-1 only: any other mask picks a lopsided residue class, which shows up
+  // as a periodic flip pattern rather than a sparse one.
+  EXPECT_FALSE(ValidateConfig({{"pixel-rate-mask", "6"}}, &error));
+  EXPECT_TRUE(ValidateConfig({{"pixel-rate-mask", "15"}}, &error)) << error;
+  EXPECT_TRUE(ValidateConfig({{"pixel-rate-mask", "0"}}, &error)) << error;
+  // The rendered page is the product, so a wider bit mask is damage.
+  EXPECT_FALSE(ValidateConfig({{"pixel-bit-mask", "255"}}, &error));
+  EXPECT_FALSE(ValidateConfig({{"pixel-bit-mask", "2"}}, &error));
+  EXPECT_TRUE(ValidateConfig({{"pixel-bit-mask", "3"}}, &error)) << error;
+  // Only the four real IP-leak postures.
+  EXPECT_FALSE(ValidateConfig({{"webrtc-ip-handling-policy", "off"}}, &error));
+  EXPECT_TRUE(ValidateConfig({{"webrtc-ip-handling-policy", "default"}}, &error))
+      << error;
+  // A suffix must not become a path expression.
+  EXPECT_FALSE(ValidateConfig({{"gl-table-suffix", "/etc/passwd"}}, &error));
+  EXPECT_FALSE(ValidateConfig({{"gl-table-suffix", "json"}}, &error));
+  // A machine class row must be coherent, and a zero weight is a row that can
+  // never be drawn.
+  EXPECT_FALSE(ValidateConfig({{"machine-classes", "[]"}}, &error));
+  EXPECT_FALSE(ValidateConfig({{"machine-classes", "[[8,16,250]]"}}, &error));
+  EXPECT_FALSE(ValidateConfig({{"machine-classes", "[[8,16,250,0]]"}}, &error));
+  EXPECT_FALSE(ValidateConfig({{"machine-classes", "[[0,16,250,1]]"}}, &error));
+  EXPECT_TRUE(ValidateConfig({{"machine-classes", HostRow()}}, &error))
+      << error;
+  // The battery tuple is validated as ONE object, so every incoherent pairing
+  // is a refused launch rather than a surface that reports a device nobody
+  // sells. base::xrio::ParseBatteryStatus owns the rules; this asserts they are
+  // reached from validation, which is what turns them into a refusal.
+  EXPECT_FALSE(ValidateConfig({{"battery-status", "{}"}}, &error));
+  EXPECT_FALSE(ValidateConfig(
+      {{"battery-status", R"json({"charging": false, "level": 0.5})json"}},
+      &error));
+  EXPECT_FALSE(ValidateConfig(
+      {{"battery-status", R"json({"charging": true, "level": 0.5,
+                                  "charging_time": 600,
+                                  "discharging_time": 900})json"}},
+      &error));
+  // "is charging", not "discharging_time": the latter appears in the messages for
+  // several different refusals, so it would pass while the launch was refused for
+  // some other reason entirely.
+  EXPECT_NE(std::string::npos, error.find("is charging")) << error;
+  EXPECT_TRUE(ValidateConfig(
+      {{"battery-status", R"json({"charging": false, "level": 0.71,
+                                  "charging_time": "Infinity",
+                                  "discharging_time": 42960})json"}},
+      &error))
+      << error;
+}
