+std::optional<int> WorkAreaPanelHeight() {
+  constexpr int kMinPanel = 24;
+  constexpr int kPanelChoices = 41;
+  if (std::optional<int64_t> height = GetOptionalInt("workarea-panel-height")) {
+    if (*height == 0) {
+      return std::nullopt;
+    }
+    return static_cast<int>(
+        std::min<int64_t>(*height, std::numeric_limits<int>::max()));
+  }
+  std::optional<uint64_t> seed = Seed("workarea");
+  if (!seed) {
+    return std::nullopt;
+  }
+  return kMinPanel + static_cast<int>(*seed % kPanelChoices);
