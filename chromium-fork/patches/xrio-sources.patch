+std::optional<unsigned> HardwareConcurrency() {
+  if (!GetBool("spoof-hardware")) {
+    return std::nullopt;
+  }
+  // An explicit value needs no draw, and therefore no seed.
+  if (std::optional<int64_t> override = GetOptionalInt("hardware-concurrency")) {
+    return static_cast<unsigned>(*override);
+  }
+  const MachineClass* machine = PickMachineClass();
+  return machine ? std::optional<unsigned>(machine->cores) : std::nullopt;
+}
+
+// The saturated top bucket of memory_info.cc's QuantizeMemorySize, and the
+// physical memory at which V8's old generation reaches its 4 GB cap. Both are
+// upstream constants read out of the pinned tree, not tuning: see the argument
+// on JsHeapSizeLimit() in xrio_persona.h.
+constexpr uint64_t kSaturatedJsHeapSizeLimit = 3760000000u;
+constexpr float kJsHeapSaturationGb = 8.0f;
+
+std::optional<uint64_t> JsHeapSizeLimit() {
+  // DeviceMemoryGb(), not the machine class directly: this must move with
+  // navigator.deviceMemory or the two numbers a page compares can be made to
+  // disagree by configuration. That also makes it follow spoof-hardware and the
+  // device-memory override for free, which is the same rule the Device-Memory
+  // client hint follows.
+  const std::optional<float> claimed = DeviceMemoryGb();
+  if (!claimed.has_value()) {
+    return std::nullopt;
+  }
+  if (*claimed < kJsHeapSaturationGb) {
+    // Below saturation the reported limit depends on the young-generation
+    // terms, which depend on the host, and no machine that small has ever been
+    // measured here. Refuse to invent one: the host's own value is at least a
+    // value some real machine reports.
+    return std::nullopt;
+  }
+  return kSaturatedJsHeapSizeLimit;
+}
+
+std::optional<float> DeviceMemoryGb() {
+  if (!GetBool("spoof-hardware")) {
+    return std::nullopt;
+  }
+  if (std::optional<double> override = GetOptionalDouble("device-memory")) {
+    return static_cast<float>(*override);
+  }
+  const MachineClass* machine = PickMachineClass();
+  return machine ? std::optional<float>(machine->memory_gb) : std::nullopt;
+}
