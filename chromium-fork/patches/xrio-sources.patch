+bool MachineClassTable(std::string_view value, std::string* error) {
+  std::optional<ListValue> parsed = JSONReader::ReadList(value, JSON_PARSE_RFC);
+  if (!parsed.has_value()) {
+    *error = "must be a JSON list";
+    return false;
+  }
+  if (parsed->empty()) {
+    *error = "must hold at least one machine class";
+    return false;
+  }
+  uint64_t total_weight = 0;
+  for (const Value& entry : *parsed) {
+    const ListValue* row = entry.GetIfList();
+    if (!row || (row->size() != 4 && row->size() != 5)) {
+      *error = "every row must be [cores, memory_gb, free_disk_gb, weight] "
+               "with an optional fifth field, \"laptop\" or \"desktop\"";
+      return false;
+    }
+    std::optional<int> cores = (*row)[0].GetIfInt();
+    std::optional<double> memory = (*row)[1].GetIfDouble();
+    std::optional<int> disk = (*row)[2].GetIfInt();
+    std::optional<int> weight = (*row)[3].GetIfInt();
+    if (!cores.has_value() || *cores < 1) {
+      *error = "cores must be an integer of at least 1";
+      return false;
+    }
+    if (!memory.has_value() || !IsReportableDeviceMemory(*memory)) {
+      *error = "memory_gb must be 2, 4, 8, 16 or 32, the values desktop Chrome "
+               "reports";
+      return false;
+    }
+    if (!disk.has_value() || *disk < 1) {
+      *error = "free_disk_gb must be an integer of at least 1";
+      return false;
+    }
+    if (!weight.has_value() || *weight < 1) {
+      *error = "weight must be an integer of at least 1 -- a zero-weight row is "
+               "a machine the fleet can never claim, which is a row that should "
+               "be deleted rather than disabled";
+      return false;
+    }
+    if (row->size() == 5) {
+      const std::string* chassis = (*row)[4].GetIfString();
+      if (!chassis || (*chassis != "laptop" && *chassis != "desktop")) {
+        // The one validator message that has to name both values, because an
+        // operator who wrote "notebook" gets a refusal here and nothing else
+        // tells them the vocabulary. ParseMachineClasses fails closed on the
+        // same input; this is what makes it an actionable startup error.
+        *error = "the fifth field is the chassis and must be exactly "
+                 "\"laptop\" or \"desktop\" -- an unrecognised value is a "
+                 "malformed table rather than a row that says nothing, so that "
+                 "a typo cannot silently switch off the battery consistency "
+                 "check the field exists to turn on";
+        return false;
+      }
+    }
+    total_weight += static_cast<uint64_t>(*weight);
+  }
+  // The roll is `seed % total`, so a total that does not fit in the arithmetic
+  // is a table nobody can draw from.
+  if (total_weight > 0xFFFFFFFF) {
+    *error = "total weight must fit in 32 bits";
+    return false;
+  }
+  return true;
+}
