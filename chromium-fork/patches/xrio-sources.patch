diff --git a/base/xrio_config.cc b/base/xrio_config.cc
new file mode 100644
index 0000000000000000000000000000000000000000..d34813a6a4566b0224732e07fe8c1cdedad561e5
--- /dev/null
+++ b/base/xrio_config.cc
@@ -0,0 +1,166 @@
+#include "base/xrio_config.h"
+
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+
+namespace base {
+
+namespace {
+
+constexpr std::string_view kHexPrefix = "0x";
+
+}  // namespace
+
+XrioConfig::XrioConfig() = default;
+XrioConfig::~XrioConfig() = default;
+
+// static
+XrioConfig& XrioConfig::Get() {
+  static NoDestructor<XrioConfig> instance;
+  return *instance;
+}
+
+// static
+XrioConfig::Map XrioConfig::HarvestFromCommandLine(
+    const CommandLine& command_line) {
+  Map harvested;
+  // Switch *names* are std::string on every platform; only values are
+  // platform-typed, so read those back through GetSwitchValueASCII rather than
+  // converting StringType by hand.
+  for (const auto& entry : command_line.GetSwitches()) {
+    const std::string& name = entry.first;
+    if (!name.starts_with(kSwitchPrefix)) {
+      continue;
+    }
+    std::string key = name.substr(kSwitchPrefix.size());
+    if (key.empty()) {
+      continue;
+    }
+    harvested.insert_or_assign(std::move(key),
+                               command_line.GetSwitchValueASCII(name));
+  }
+  // "gl-table" is a DERIVED key, never an argv one: base::xrio::ExpandGlTable
+  // fills it from the artifact named by "gl-persona". Accepting it from a
+  // command line would make the switch an injection point for a table nothing
+  // generated -- the generator computes the hide-list as `source - target`,
+  // drops the add-list and guards getShaderPrecisionFormat, and a table that
+  // skipped it has none of that.
+  //
+  // Deliberately no file I/O here. This function runs under lock_ on the lazy
+  // path and on whatever thread reads first, which in the browser is one that
+  // forbids blocking; the read lives at the single call site that can afford it.
+  // See xrio_gl_table.h.
+  harvested.erase("gl-table");
+  // Same contract as "gl-table": ExpandMediaTable fills it from the artifact
+  // beside the GL one, and an argv-supplied body would be an injection point
+  // for decode claims nothing measured.
+  harvested.erase("media-table");
+  // Installed from the selected artifact by ExpandSpeechTable. Like the GL and
+  // media bodies, this is never accepted directly from argv.
+  harvested.erase("speech-table");
+  return harvested;
+}
+
+void XrioConfig::SetAll(Map values) {
+  {
+    AutoLock guard(lock_);
+    values_ = std::move(values);
+    loaded_ = true;
+  }
+  generation_.fetch_add(1, std::memory_order_release);
+}
+
+uint32_t XrioConfig::generation() const {
+  return generation_.load(std::memory_order_acquire);
+}
+
+void XrioConfig::EnsureLoadedLocked() const {
+  if (loaded_) {
+    return;
+  }
+  // Not an error to be early: leaving loaded_ false means a later read retries,
+  // and until then every accessor reports absence.
+  if (!CommandLine::InitializedForCurrentProcess()) {
+    return;
+  }
+  values_ = HarvestFromCommandLine(*CommandLine::ForCurrentProcess());
+  loaded_ = true;
+  // Bump here too: a lazy load changes the map exactly as SetAll does, and a
+  // cache keyed on the generation would otherwise never see it.
+  generation_.fetch_add(1, std::memory_order_release);
+}
+
+std::optional<std::string> XrioConfig::Lookup(std::string_view key) const {
+  AutoLock guard(lock_);
+  EnsureLoadedLocked();
+  auto it = values_.find(key);
+  if (it == values_.end()) {
+    return std::nullopt;
+  }
+  return it->second;
+}
+
+bool XrioConfig::Has(std::string_view key) const {
+  return Lookup(key).has_value();
+}
+
+std::string XrioConfig::GetString(std::string_view key) const {
+  return Lookup(key).value_or(std::string());
+}
+
+std::optional<int> XrioConfig::GetInt(std::string_view key) const {
+  std::optional<std::string> raw = Lookup(key);
+  int parsed = 0;
+  if (!raw.has_value() || !StringToInt(*raw, &parsed)) {
+    return std::nullopt;
+  }
+  return parsed;
+}
+
+std::optional<double> XrioConfig::GetDouble(std::string_view key) const {
+  std::optional<std::string> raw = Lookup(key);
+  double parsed = 0.0;
+  if (!raw.has_value() || !StringToDouble(*raw, &parsed)) {
+    return std::nullopt;
+  }
+  return parsed;
+}
+
+std::optional<uint64_t> XrioConfig::GetSeed(std::string_view key) const {
+  std::optional<std::string> raw = Lookup(key);
+  if (!raw.has_value()) {
+    return std::nullopt;
+  }
+
+  uint64_t parsed = 0;
+  std::string_view text(*raw);
+  const bool ok = text.starts_with(kHexPrefix)
+                      ? HexStringToUInt64(text.substr(kHexPrefix.size()),
+                                          &parsed)
+                      : StringToUint64(text, &parsed);
+
+  // Fail closed on all three of absent, unparseable and zero. See the header:
+  // a caller that gets nullopt must leave its surface untouched, because a
+  // substituted constant is the defect this exists to remove.
+  if (!ok || parsed == 0) {
+    return std::nullopt;
+  }
+  return parsed;
+}
+
+XrioConfig::Map XrioConfig::values() const {
+  AutoLock guard(lock_);
+  EnsureLoadedLocked();
+  return values_;
+}
+
+bool XrioConfig::empty() const {
+  AutoLock guard(lock_);
+  EnsureLoadedLocked();
+  return values_.empty();
+}
+
+}  // namespace base
diff --git a/base/xrio_config.h b/base/xrio_config.h
new file mode 100644
index 0000000000000000000000000000000000000000..0fac0c151e231e1e46a15af6aa7cd0126bb88580
--- /dev/null
+++ b/base/xrio_config.h
@@ -0,0 +1,128 @@
+#ifndef BASE_XRIO_CONFIG_H_
+#define BASE_XRIO_CONFIG_H_
+
+#include <atomic>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/base_export.h"
+#include "base/containers/flat_map.h"
+#include "base/synchronization/lock.h"
+#include "base/thread_annotations.h"
+
+namespace base {
+
+class CommandLine;
+
+template <typename T>
+class NoDestructor;
+
+// Process-wide persona configuration: one string->string map, readable from
+// every layer.
+//
+// Deliberately dumb. It lives in base/ so that base, content, Blink core and
+// Blink modules can all read it without a new DEPS edge, which is what keeps a
+// surface patch down to a couple of lines (catalog SS3 #83). The alternative --
+// a typed mojo struct per feature, Brave-style -- costs a plumbing change every
+// time a surface is added.
+//
+// Population, and why it is asymmetric:
+//
+//   Browser process: lazily harvested from its own command line on first read.
+//   Renderer process: pushed over content.mojom.Renderer.SetXrioConfig during
+//                     RenderProcessHostImpl::Init, before InitializeRenderer.
+//                     The persona never lands on the renderer command line, so
+//                     it is not in /proc for a co-tenant to read and not in any
+//                     crash dump that echoes argv (catalog SS3 #84).
+//
+// A renderer read that happens *before* the mojo push therefore sees an empty
+// map. That is intended: every accessor fails closed, so an early caller leaves
+// its surface untouched rather than perturbing it with a wrong value. Anything
+// needing config at renderer static-init time cannot use this transport and
+// needs its own early hook -- none does today.
+class BASE_EXPORT XrioConfig {
+ public:
+  // `--xrio-gl-persona=amd` is stored under the key "gl-persona". The
+  // prefix is a namespace on the command line only; it is not part of the key.
+  //
+  // Values are read back with CommandLine::GetSwitchValueASCII, so a persona
+  // value must be ASCII. Every surface we control is -- GL vendor and renderer
+  // strings, numeric capabilities, seeds -- but a future non-ASCII value needs a
+  // different accessor, not a wider assumption here.
+  static constexpr std::string_view kSwitchPrefix = "xrio-";
+
+  using Map = flat_map<std::string, std::string>;
+
+  static XrioConfig& Get();
+
+  // Every `--xrio-*` switch on `command_line`, prefix stripped. Browser-side:
+  // this is the payload SetXrioConfig carries to a renderer.
+  static Map HarvestFromCommandLine(const CommandLine& command_line);
+
+  XrioConfig(const XrioConfig&) = delete;
+  XrioConfig& operator=(const XrioConfig&) = delete;
+
+  // Replaces the map wholesale. Called once per renderer from the mojo handler.
+  // Last writer wins, and it suppresses the lazy command-line harvest.
+  void SetAll(Map values);
+
+  bool Has(std::string_view key) const;
+
+  // Empty string when absent. Callers that must distinguish absent from empty
+  // should use Has().
+  std::string GetString(std::string_view key) const;
+
+  std::optional<int> GetInt(std::string_view key) const;
+  std::optional<double> GetDouble(std::string_view key) const;
+
+  // Seed for a keyed perturbation. `0x`-prefixed values parse as hex,
+  // everything else as decimal.
+  //
+  // FAILS CLOSED, and this is the load-bearing part: absent, unparseable and
+  // zero all return nullopt, and a caller that gets nullopt must leave its
+  // surface exactly as upstream produced it. Never substitute a constant.
+  // Fortress's UxrFarbleReadPixels falls back to 0x9e3779b9 when its seed is
+  // unset, which reproduces a fleet-wide constant readback hash at a different
+  // value -- precisely the defect the perturbation exists to remove
+  // (catalog SS3 #98, why-fork Tier 1 #1).
+  std::optional<uint64_t> GetSeed(std::string_view key) const;
+
+  Map values() const;
+  bool empty() const;
+
+  // Bumped whenever the map changes. Lock-free, so a hot caller can cache a
+  // derived value and re-check validity for the price of one atomic load.
+  //
+  // This exists because JitterRectSize runs on every getBoundingClientRect, and
+  // a layout-thrashing page makes thousands of those per frame. Two mutex
+  // acquisitions per call is a real cost for a value that changes at most once
+  // in a process's life.
+  uint32_t generation() const;
+
+ private:
+  friend class NoDestructor<XrioConfig>;
+
+  XrioConfig();
+  ~XrioConfig();
+
+  // Harvests from the current process's command line the first time anything is
+  // read, unless SetAll already ran. No-op if the command line is not yet
+  // initialised, so an early read cannot crash -- it just sees nothing.
+  void EnsureLoadedLocked() const EXCLUSIVE_LOCKS_REQUIRED(lock_);
+
+  std::optional<std::string> Lookup(std::string_view key) const;
+
+  // mutable for the same reason values_ and loaded_ are: EnsureLoadedLocked()
+  // is const and the lazy load has to publish a new generation, or a cache keyed
+  // on it would never observe the load.
+  mutable std::atomic<uint32_t> generation_{0};
+  mutable Lock lock_;
+  mutable Map values_ GUARDED_BY(lock_);
+  mutable bool loaded_ GUARDED_BY(lock_) = false;
+};
+
+}  // namespace base
+
+#endif  // BASE_XRIO_CONFIG_H_
diff --git a/base/xrio_config_file.cc b/base/xrio_config_file.cc
new file mode 100644
index 0000000000000000000000000000000000000000..b80b361957b83d8d9d344954dc6391d7094b2afa
--- /dev/null
+++ b/base/xrio_config_file.cc
@@ -0,0 +1,383 @@
+#include "base/xrio_config_file.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/base_paths.h"
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/compiler_specific.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/path_service.h"
+#include "base/xrio_gl_table.h"
+#include "base/xrio_knobs.h"
+#include "base/xrio_persona.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/values.h"
+
+namespace base::xrio {
+
+namespace {
+
+constexpr char kDefaultFileName[] = "xrio-config.json";
+
+// NOT a knob, and it cannot be one: the cap has to be known before the file
+// that would carry it is read. Same bootstrap exception as XrioConfig's `xrio-`
+// prefix. Generous next to a real file -- the whole 62-knob registry written out
+// longhand is a few kilobytes -- so this only ever catches a wrong path.
+constexpr size_t kMaxConfigBytes = 256 * 1024;
+
+// Deepest nesting followed. `{"seed":{"purpose":{"canvas":...}}}` is three, and
+// no key in the registry has more than two segments; the bound is here so a
+// pathological document cannot recurse without limit.
+constexpr int kMaxDepth = 6;
+
+std::string DescribeType(const Value& value) {
+  switch (value.type()) {
+    case Value::Type::NONE:
+      return "null";
+    case Value::Type::BOOLEAN:
+      return "a boolean";
+    case Value::Type::INTEGER:
+      return "an integer";
+    case Value::Type::DOUBLE:
+      return "a number";
+    case Value::Type::STRING:
+      return "a string";
+    case Value::Type::BINARY:
+      return "binary";
+    case Value::Type::DICT:
+      return "an object";
+    case Value::Type::LIST:
+      return "a list";
+  }
+  return "unknown";
+}
+
+// The string a command line would carry for `value`. This is the whole reason
+// the file and the flag paths converge: after this conversion, ValidateConfig
+// and every accessor see one representation, so a knob cannot behave differently
+// depending on how it was spelled.
+bool Stringify(const Value& value,
+               std::string_view key,
+               std::string* out,
+               std::string* error) {
+  switch (value.type()) {
+    case Value::Type::STRING:
+      *out = value.GetString();
+      return true;
+    case Value::Type::BOOLEAN:
+      *out = value.GetBool() ? "true" : "false";
+      return true;
+    case Value::Type::INTEGER:
+      *out = NumberToString(value.GetInt());
+      return true;
+    case Value::Type::DOUBLE:
+      // Shortest round-tripping form, so 0.999 stays "0.999" rather than
+      // becoming "0.99899999999999999911182158029987" -- which would parse back
+      // to the same double but make --xrio-dump-config unreadable and a diff
+      // between two hosts' effective configs unusable.
+      *out = NumberToString(value.GetDouble());
+      return true;
+    case Value::Type::LIST:
+    case Value::Type::DICT: {
+      // A list is a VALUE, never nesting -- see the header's shape rule. It
+      // re-serialises to JSON because the knobs that take one (machine-classes)
+      // are typed kJson and their consumer parses JSON.
+      //
+      // A DICT reaches here only from Flatten's kJson branch: an object is a
+      // key prefix everywhere else, so the generic path never gets one. Both
+      // arrive as the same thing from ValidateConfig onward -- the JSON text a
+      // command line would have carried.
+      std::optional<std::string> json = WriteJson(value);
+      if (!json.has_value()) {
+        *error = StrCat({"'", key,
+                         "' holds a value that cannot be serialised as JSON"});
+        return false;
+      }
+      *out = std::move(*json);
+      return true;
+    }
+    case Value::Type::NONE:
+      // Refused rather than treated as absent, and the message says why: `null`
+      // reads as "I set this deliberately" while doing nothing, which is the
+      // exact class of silent no-op the registry exists to end. Deleting the
+      // line is how you say absent.
+      *error = StrCat({"'", key,
+                       "' is null. Delete the key instead -- null would read as "
+                       "a deliberate setting while changing nothing"});
+      return false;
+    default:
+      *error = StrCat({"'", key, "' is ", DescribeType(value),
+                       ", which is not a knob value"});
+      return false;
+  }
+}
+
+bool Flatten(const DictValue& dict,
+             std::string_view prefix,
+             int depth,
+             XrioConfig::Map* out,
+             std::string* error) {
+  if (depth > kMaxDepth) {
+    *error = StrCat({"'", prefix, "' nests deeper than ",
+                     NumberToString(kMaxDepth), " levels"});
+    return false;
+  }
+  for (const auto [raw_key, value] : dict) {
+    std::string_view segment(raw_key);
+    // Accept a `xrio-` prefix and strip it, but only on a top-level key: it is
+    // there so a key can be pasted straight off a command line, and `{"xrio-gl":
+    // {"xrio-persona": ...}}` is not a spelling anyone means.
+    if (prefix.empty() && segment.starts_with(XrioConfig::kSwitchPrefix)) {
+      segment = segment.substr(XrioConfig::kSwitchPrefix.size());
+    }
+    if (segment.empty()) {
+      *error = "a key is empty";
+      return false;
+    }
+    const std::string key =
+        prefix.empty() ? std::string(segment) : StrCat({prefix, "-", segment});
+    if (const DictValue* nested = value.GetIfDict()) {
+      // An object is a key prefix UNLESS the key it has resolved to is a kJson
+      // knob, in which case the object is that knob's value.
+      //
+      // The rule is still decidable without the operator thinking about it --
+      // the REGISTRY answers it, not the shape of the document -- and it stays
+      // "an object is a prefix" for every key that is not a kJson knob, which
+      // is the rarest type in the table.
+      //
+      // It exists because `battery-status` is a kJson knob whose value IS an
+      // object, and under the previous unconditional rule the only way to write
+      // it in this file was a string holding escaped JSON:
+      //
+      //   "battery-status": "{\"charging\": false, \"level\": 0.71, ...}"
+      //
+      // That is unreadable, it is escape-prone in exactly the file a person
+      // edits by hand, and the alternative spelling was not an error either --
+      // `{"battery-status": {"charging": ...}}` flattened to
+      // `battery-status-charging`, an unregistered key, so it refused the
+      // launch with a message about a knob nobody had heard of. A refusal is
+      // safe; a refusal that names the wrong thing still costs an hour.
+      if (const Knob* knob = FindKnob(key);
+          knob && knob->type == KnobType::kJson) {
+        std::string flat_json;
+        if (!Stringify(value, key, &flat_json, error)) {
+          return false;
+        }
+        if (out->contains(key)) {
+          *error = StrCat({"'", key,
+                           "' is set twice, once nested and once flat. Keep "
+                           "one spelling"});
+          return false;
+        }
+        out->insert_or_assign(key, std::move(flat_json));
+        continue;
+      }
+      if (!Flatten(*nested, key, depth + 1, out, error)) {
+        return false;
+      }
+      continue;
+    }
+    std::string flat;
+    if (!Stringify(value, key, &flat, error)) {
+      return false;
+    }
+    // A duplicate can only happen when a nested spelling and a flat spelling
+    // name the same knob (`{"gl": {"persona": "a"}, "gl-persona": "b"}`).
+    // flat_map iteration is sorted, so "gl" sorts before "gl-persona" and the
+    // winner would be stable but arbitrary -- and an operator who wrote both
+    // does not know which they get. Refuse.
+    //
+    // Checked before inserting rather than from insert_or_assign's `inserted`
+    // flag, because that call would have already overwritten the first value.
+    if (out->contains(key)) {
+      *error = StrCat({"'", key,
+                       "' is set twice, once nested and once flat. Keep one "
+                       "spelling"});
+      return false;
+    }
+    out->insert_or_assign(key, std::move(flat));
+  }
+  return true;
+}
+
+}  // namespace
+
+FilePath DefaultConfigPath() {
+  FilePath dir;
+  if (!PathService::Get(DIR_EXE, &dir)) {
+    return FilePath();
+  }
+  return dir.AppendASCII(kDefaultFileName);
+}
+
+bool ParseConfigDocument(std::string_view json,
+                         XrioConfig::Map* out,
+                         std::string* error) {
+  CHECK(out);
+  CHECK(error);
+  // COMMENTS AND TRAILING COMMAS ARE ALLOWED HERE, and only here.
+  //
+  // This is the one JSON in the fork a human edits, and a knob file whose rows
+  // cannot carry a warning is a knob file whose warnings live somewhere nobody
+  // reads. `webrtc-ip-handling-policy` is one edit away from leaking the real
+  // IP; that fact belongs on the line above it, not in a separate document.
+  //
+  // Deliberately NOT JSON_PARSE_CHROMIUM_EXTENSIONS: that also allows newlines
+  // inside strings and \x escapes, which is laxity with no purpose here. The GL
+  // persona artifact stays strict RFC -- it is machine-generated, so anything
+  // unusual in it means something upstream is wrong.
+  std::optional<DictValue> parsed = JSONReader::ReadDict(
+      json, JSON_ALLOW_COMMENTS | JSON_ALLOW_TRAILING_COMMAS);
+  if (!parsed.has_value()) {
+    *error = "is not a JSON object";
+    return false;
+  }
+  XrioConfig::Map flattened;
+  if (!Flatten(*parsed, std::string_view(), 0, &flattened, error)) {
+    return false;
+  }
+  *out = std::move(flattened);
+  return true;
+}
+
+bool MergeConfigFile(CommandLine* command_line, std::string* error) {
+  CHECK(command_line);
+  CHECK(error);
+
+  const Knob* file_knob = FindKnob("config-file");
+  CHECK(file_knob) << "the config-file knob is missing from the registry";
+  const std::string switch_name =
+      StrCat({XrioConfig::kSwitchPrefix, file_knob->key});
+
+  const bool named_explicitly = command_line->HasSwitch(switch_name);
+  FilePath path;
+  if (named_explicitly) {
+    const std::string raw = command_line->GetSwitchValueASCII(switch_name);
+    if (raw.empty()) {
+      *error = StrCat({"--", switch_name, " needs a path"});
+      return false;
+    }
+    path = FilePath::FromUTF8Unsafe(raw);
+  } else {
+    path = DefaultConfigPath();
+    if (path.empty() || !PathExists(path)) {
+      // The normal case for a host that configures everything by flag. Nothing
+      // to merge, and nothing wrong.
+      return true;
+    }
+  }
+
+  std::string body;
+  if (!ReadFileToStringWithMaxSize(path, &body, kMaxConfigBytes)) {
+    // Only reachable for an explicit path (the default path was PathExists'd
+    // above, so a failure here means unreadable or oversized, not absent) --
+    // and an explicit path is a requirement, not a hint. Absent, unreadable and
+    // oversized are not distinguished, for the same reason ReadGlPersonaBody
+    // does not distinguish them: all three mean the operator named a file this
+    // browser cannot use, and the path in the message is what they need.
+    *error = StrCat({"cannot read ", path.AsUTF8Unsafe(),
+                     " (missing, unreadable, or larger than ",
+                     NumberToString(kMaxConfigBytes), " bytes)"});
+    return false;
+  }
+
+  XrioConfig::Map from_file;
+  std::string detail;
+  if (!ParseConfigDocument(body, &from_file, &detail)) {
+    *error = StrCat({path.AsUTF8Unsafe(), " ", detail});
+    return false;
+  }
+
+  // A knob file naming another knob file is a configuration nobody can read
+  // back from one place, and it invites a cycle. One file.
+  if (from_file.contains(file_knob->key)) {
+    *error = StrCat({path.AsUTF8Unsafe(), " sets '", file_knob->key,
+                     "'. A knob file may not name another knob file"});
+    return false;
+  }
+
+  for (const auto& [key, value] : from_file) {
+    const std::string name = StrCat({XrioConfig::kSwitchPrefix, key});
+    // A FLAG BEATS THE FILE. The file is a host's persistent configuration; a
+    // flag is what this render decided, and xrio puts its per-render
+    // choices -- the seed, the persona, a per-target retreat -- on the command
+    // line. If the file won, a stale file on the box would silently override a
+    // decision the envelope recorded as taken.
+    if (command_line->HasSwitch(name)) {
+      continue;
+    }
+    command_line->AppendSwitchASCII(name, value);
+  }
+
+  // Make the loaded path part of the effective configuration, so
+  // --xrio-dump-config answers "which file, if any" without a second mechanism.
+  // Only when it was NOT named explicitly -- otherwise it is already there.
+  if (!named_explicitly) {
+    command_line->AppendSwitchASCII(switch_name, path.AsUTF8Unsafe());
+  }
+  return true;
+}
+
+StartupOutcome ApplyStartupConfiguration(CommandLine* command_line,
+                                        bool is_browser) {
+  CHECK(command_line);
+  if (!is_browser) {
+    // Every `--xrio-*` value the renderers need arrives over
+    // content.mojom.Renderer.SetXrioConfig, never on their own command line, so
+    // there is nothing here for a non-browser process to do -- and it could not
+    // read a file anyway.
+    return StartupOutcome::kContinue;
+  }
+
+  std::string error;
+  if (!MergeConfigFile(command_line, &error)) {
+    LOG(ERROR) << "xrio: " << error;
+    return StartupOutcome::kRefused;
+  }
+
+  XrioConfig::Map harvested = XrioConfig::HarvestFromCommandLine(*command_line);
+  if (!ValidateConfig(harvested, &error)) {
+    LOG(ERROR) << "xrio: " << error;
+    return StartupOutcome::kRefused;
+  }
+
+  // Publish before answering --xrio-dump-config, so the dump reports what a
+  // render would actually get rather than what the registry defaults to.
+  XrioConfig::Get().SetAll(std::move(harvested));
+
+  XrioConfig::Map expanded = XrioConfig::Get().values();
+  ExpandGlTable(&expanded);
+  InstallBrowserGlTable(expanded);
+
+  // Before --xrio-dump-config, deliberately: a launch that will be refused
+  // should be refused whatever else was asked for.
+  std::optional<std::string> problem = MachineClassTableProblem();
+  if (!problem) {
+    problem = MachineClassExpectationProblem();
+  }
+  if (problem) {
+    LOG(ERROR) << "xrio: " << *problem;
+    return StartupOutcome::kRefused;
+  }
+
+  if (GetBool("dump-config")) {
+    // Same shape as --version and --credits a few lines above in
+    // BasicStartupComplete: answer on stdout and stop. That makes the effective
+    // configuration queryable with one exec, which is the difference between
+    // asserting a knob is live and knowing it.
+    const std::string report = DescribeConfig();
+    UNSAFE_TODO(printf("%s", report.c_str()));
+    return StartupOutcome::kExitSuccess;
+  }
+  return StartupOutcome::kContinue;
+}
+
+}  // namespace base::xrio
diff --git a/base/xrio_config_file.h b/base/xrio_config_file.h
new file mode 100644
index 0000000000000000000000000000000000000000..1ba9e2eba2be79d431f0a1339d29daf8207036ac
--- /dev/null
+++ b/base/xrio_config_file.h
@@ -0,0 +1,155 @@
+#ifndef BASE_XRIO_CONFIG_FILE_H_
+#define BASE_XRIO_CONFIG_FILE_H_
+
+#include <string>
+#include <string_view>
+
+#include "base/base_export.h"
+#include "base/xrio_config.h"
+
+namespace base {
+class CommandLine;
+class FilePath;
+}  // namespace base
+
+namespace base::xrio {
+
+// A knob file: every `--xrio-*` value, as JSON, read fresh on every launch.
+//
+// WHY, given that flags already work. Because a render's configuration is
+// currently spread across xrio's launch plan and a command line nobody can
+// read back, and because there is a whole class of value -- the nine-row machine
+// class table, a hide-list, a tuning set someone is bisecting -- that is
+// miserable to express as argv and natural to express as a file. A build is five
+// hours; a file edit is nothing. Both spellings reach the same registry, and a
+// launch with neither reproduces the compiled defaults exactly.
+//
+// PRECEDENCE: a flag beats the file, always. The file is the persistent
+// configuration of a host; a flag is what THIS render decided. xrio computes
+// per-render values (the seed, the persona, a per-target retreat) and passes them
+// as flags, so the more specific source has to win or a stale file on the box
+// would silently override a decision the ledger recorded.
+//
+// SHAPE. A JSON object of knob keys, with two conveniences:
+//
+//   { "seed": "0xdeadbeef",              // a bare key
+//     "gl": { "persona": "renoir" },     // nested: reads as gl-persona
+//     "machine-classes": [[8,16,250,26]] // a list is a JSON value, verbatim
+//     "battery-status": { "charging": false, ... }  // a kJson knob's own object
+//   }
+//
+// A nested OBJECT is a key prefix, joined with `-`. A LIST is always a value,
+// re-serialised as JSON for a kJson knob. The ONE exception is an object whose
+// resolved key names a kJson knob: that object is the knob's value, because
+// `battery-status` is a knob whose value is an object and the prefix rule made
+// it unwritable here -- the only remaining spelling was a string of escaped
+// JSON, in the one file in the fork a person edits by hand.
+//
+// The rule stays decidable without the operator working anything out, which is
+// what matters more here than expressiveness: the REGISTRY answers whether a
+// key is JSON, not the shape of the document, and kJson is the rarest type in
+// it. A `xrio-` prefix on a key is accepted and stripped, so a key can be copied
+// straight off a command line.
+//
+// `//` and `/* */` COMMENTS and trailing commas are accepted, because this is
+// the one JSON in the fork a person edits by hand and a warning has to sit on
+// the row it warns about. `fork/xrio-config.example.jsonc` is the annotated
+// template, generated from the registry and shipped with EVERY row commented
+// out -- its header says why writing defaults into a live file would silently
+// freeze them at the version that wrote it.
+//
+// Numbers and booleans are converted to the string spelling a command line
+// would carry, so the file and the flag paths are the same code from
+// ValidateConfig onward. `null` is refused: absence is how you say absent.
+//
+// FAILS THE LAUNCH, not the surface -- the same asymmetry ValidateConfig makes,
+// for the same reason. An unreadable file that was named explicitly, a malformed
+// document, an unregistered key, a value of the wrong type: all refuse to start.
+// The alternative is a browser that renders with a configuration nobody
+// intended, and this project has already shipped four knobs that read as working
+// while doing nothing.
+
+// The path loaded when `--xrio-config-file` is absent: `xrio-config.json` beside
+// the browser binary. Not an error to be missing -- that is the normal case for
+// a host that configures everything by flag.
+BASE_EXPORT FilePath DefaultConfigPath();
+
+// Flattens `json` into knob keys. The testable core of the loader: no file I/O,
+// no command line.
+//
+// Does NOT validate keys or values against the registry -- ValidateConfig does
+// that, over the merged result, so a flag and a file entry are judged by exactly
+// the same code.
+BASE_EXPORT bool ParseConfigDocument(std::string_view json,
+                                     XrioConfig::Map* out,
+                                     std::string* error);
+
+// Reads the knob file and appends every key it names to `command_line` as
+// `--xrio-<key>=<value>`, SKIPPING any switch already present there.
+//
+// Appending to the command line rather than writing XrioConfig directly is what
+// makes this one change instead of three: the browser's own lazy harvest, the
+// map RenderProcessHostImpl ships to each renderer, and ValidateConfig all read
+// the command line already, so they need no knowledge of files. And because
+// CommandLine::ForCurrentProcess() is an in-memory object, the appended values
+// do not land in /proc/<pid>/cmdline -- so a file-configured persona is less
+// visible to a co-tenant than a flag-configured one, not more.
+//
+// BLOCKS. Unlike the persona artifact read, this one needs no
+// ScopedAllowBlocking and therefore no friend-list patch: it is called from
+// ChromeMainDelegate::BasicStartupComplete
+// (content/app/content_main_runner_impl.cc:896), and the browser main thread
+// does not forbid blocking until DisallowUnresponsiveTasks() at
+// content/browser/browser_main_loop.cc:1084, deep inside PreMainMessageLoopRun.
+// Verified in the pinned tree, and it is why the loader lives at that callback
+// rather than beside ExpandGlTable in RenderProcessHostImpl::Init -- which is a
+// friend of ScopedAllowBlocking, but runs far too late to configure the browser
+// process itself.
+//
+// That callback is also where Chrome already does its own early command-line
+// surgery (it removes --disable-web-security when --user-data-dir is default),
+// and it returns std::optional<int>, which is a ready-made refuse-to-launch.
+// It runs in EVERY process type, so the caller must gate on the browser.
+//
+// True when there was nothing to do, when the file loaded, or when no file
+// exists at the default path. False with `error` set when a file that was named
+// explicitly could not be read, or when any file present was malformed.
+BASE_EXPORT bool MergeConfigFile(CommandLine* command_line, std::string* error);
+
+// What the caller should do next.
+enum class StartupOutcome {
+  // Configuration is loaded and valid. Carry on booting.
+  kContinue,
+  // A question was asked and answered on stdout (--xrio-dump-config). Exit 0.
+  kExitSuccess,
+  // The configuration was refused, and why has been logged. Exit non-zero.
+  kRefused,
+};
+
+// The ONE call the browser makes at startup. In order:
+//
+//   1. Merge `--xrio-config-file` (or the default path) into `command_line`.
+//   2. Validate every `--xrio-*` switch on it against the knob registry.
+//   3. Publish the result into XrioConfig, so the browser process's own reads
+//      agree with the map RenderProcessHostImpl later ships to each renderer.
+//      Both read the command line, so appending in step 1 is what keeps them
+//      consistent -- but publishing explicitly also covers the case where
+//      something read XrioConfig before this ran and latched an empty map.
+//   4. Answer `--xrio-dump-config`.
+//
+// It exists as one function because patches/README.md allows a patch to carry a
+// placeholder call and nothing else: the rebase cost of logic in a patch is what
+// this fork's whole layout is arranged to avoid. So the hook in
+// ChromeMainDelegate::BasicStartupComplete is this call and a mapping of the
+// outcome onto chrome's own result codes, which base cannot name.
+//
+// No-op returning kContinue when `is_browser` is false. That gate is the
+// caller's to supply because only chrome/ knows the switch that identifies a
+// process type -- and it matters: BasicStartupComplete runs in every process,
+// and a sandboxed renderer must not try to open a file.
+BASE_EXPORT StartupOutcome ApplyStartupConfiguration(CommandLine* command_line,
+                                                     bool is_browser);
+
+}  // namespace base::xrio
+
+#endif  // BASE_XRIO_CONFIG_FILE_H_
diff --git a/base/xrio_config_file_unittest.cc b/base/xrio_config_file_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..ffbb11807bc467338c0453c16bbd990b321de720
--- /dev/null
+++ b/base/xrio_config_file_unittest.cc
@@ -0,0 +1,366 @@
+#include "base/xrio_config_file.h"
+
+#include <string>
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/xrio_config.h"
+#include "base/xrio_gl_table.h"
+#include "base/xrio_knobs.h"
+#include "base/xrio_persona.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace base::xrio {
+namespace {
+
+class XrioConfigFileTest : public ::testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(dir_.CreateUniqueTempDir()); }
+  void TearDown() override {
+    SetHostThreadCeilingForTesting(0);
+    InstallBrowserGlTable({});
+    XrioConfig::Get().SetAll({});
+  }
+
+  // Writes `body` and returns a command line naming it.
+  CommandLine WithFile(std::string_view body) {
+    const FilePath path = dir_.GetPath().AppendASCII("xrio-config.json");
+    CHECK(WriteFile(path, body));
+    CommandLine command_line(CommandLine::NO_PROGRAM);
+    command_line.AppendSwitchASCII("xrio-config-file", path.AsUTF8Unsafe());
+    return command_line;
+  }
+
+  ScopedTempDir dir_;
+};
+
+// ---------------------------------------------------------------------------
+// The document shape.
+
+TEST_F(XrioConfigFileTest, FlatKeys) {
+  XrioConfig::Map out;
+  std::string error;
+  ASSERT_TRUE(ParseConfigDocument(
+      R"json({"seed": "0x2b", "pixel-rate-mask": 15, "webdriver-false": false,
+          "audio-scale-floor": 0.999})json",
+      &out, &error))
+      << error;
+  EXPECT_EQ("0x2b", out["seed"]);
+  EXPECT_EQ("15", out["pixel-rate-mask"]);
+  EXPECT_EQ("false", out["webdriver-false"]);
+  // Shortest round-tripping form, so a dump of two hosts' effective configs is
+  // diffable rather than full of 0.99899999999999999911182158029987.
+  EXPECT_EQ("0.999", out["audio-scale-floor"]);
+}
+
+TEST_F(XrioConfigFileTest, NestedObjectsAreKeyPrefixes) {
+  XrioConfig::Map out;
+  std::string error;
+  ASSERT_TRUE(ParseConfigDocument(
+      R"json({"gl": {"persona": "renoir", "table-max-bytes": 4096},
+          "seed": {"purpose-canvas": "c"}})json",
+      &out, &error))
+      << error;
+  EXPECT_EQ("renoir", out["gl-persona"]);
+  EXPECT_EQ("4096", out["gl-table-max-bytes"]);
+  EXPECT_EQ("c", out["seed-purpose-canvas"]);
+}
+
+// A list is a VALUE, never nesting -- the rule that keeps the shape
+// unambiguous. It re-serialises to JSON because the knob that takes one is
+// typed kJson and its consumer parses JSON.
+TEST_F(XrioConfigFileTest, ListsAreValues) {
+  XrioConfig::Map out;
+  std::string error;
+  ASSERT_TRUE(ParseConfigDocument(
+      R"json({"machine-classes": [[8,16,250,26],[12,32,500,8]]})json", &out, &error))
+      << error;
+  EXPECT_EQ("[[8,16,250,26],[12,32,500,8]]", out["machine-classes"]);
+  // And it survives the round trip into validation.
+  EXPECT_TRUE(ValidateConfig(out, &error)) << error;
+}
+
+// The one exception to the prefix rule, and the reason it exists: a kJson
+// knob's value may itself be an OBJECT. `battery-status` is one, and under the
+// unconditional prefix rule the only spelling this file accepted was a string
+// of escaped JSON -- in the one file in the fork a person edits by hand. The
+// object spelling used to flatten to `battery-status-charging`, an unregistered
+// key, so it refused the launch while naming a knob nobody had heard of.
+TEST_F(XrioConfigFileTest, AJsonKnobsOwnObjectIsItsValue) {
+  XrioConfig::Map out;
+  std::string error;
+  ASSERT_TRUE(ParseConfigDocument(
+      R"json({"battery-status": {"charging": false, "level": 0.71,
+                                 "charging_time": "Infinity",
+                                 "discharging_time": 42960}})json",
+      &out, &error))
+      << error;
+  EXPECT_FALSE(out.contains("battery-status-charging"))
+      << "the object was flattened into prefixed keys, which is the defect";
+  // Serialised as the JSON text a command line would have carried, so
+  // everything from ValidateConfig onward sees one representation.
+  EXPECT_TRUE(ValidateConfig(out, &error)) << error;
+  BatteryStatus status;
+  ASSERT_TRUE(ParseBatteryStatus(out["battery-status"], &status, &error))
+      << error;
+  EXPECT_FALSE(status.charging);
+  EXPECT_EQ(0.71, status.level);
+  EXPECT_EQ(42960.0, status.discharging_time);
+
+  // The nested spelling reaches the same knob, because the rule is about the
+  // RESOLVED key rather than the depth it was written at.
+  XrioConfig::Map nested;
+  ASSERT_TRUE(ParseConfigDocument(
+      R"json({"battery": {"status": {"charging": false, "level": 0.5,
+                                     "charging_time": "Infinity",
+                                     "discharging_time": 60}}})json",
+      &nested, &error))
+      << error;
+  EXPECT_TRUE(nested.contains("battery-status"));
+  EXPECT_TRUE(ValidateConfig(nested, &error)) << error;
+}
+
+// An object still prefixes for every key that is not a JSON knob, including one
+// that does not resolve to a knob at all -- that has to keep refusing with the
+// unregistered-key message rather than being swallowed as a value.
+TEST_F(XrioConfigFileTest, AnObjectUnderAnUnknownKeyStillPrefixes) {
+  XrioConfig::Map out;
+  std::string error;
+  ASSERT_TRUE(ParseConfigDocument(
+      R"json({"not-a-knob": {"charging": false}})json", &out, &error))
+      << error;
+  EXPECT_EQ("false", out["not-a-knob-charging"]);
+  EXPECT_FALSE(ValidateConfig(out, &error));
+  EXPECT_NE(std::string::npos, error.find("not-a-knob-charging"));
+}
+
+// An incoherent tuple refuses the LAUNCH, not the surface -- the same asymmetry
+// every other knob makes. The message has to name what is wrong with it, or the
+// operator is left rereading their own JSON.
+TEST_F(XrioConfigFileTest, AnIncoherentBatteryTupleRefusesTheLaunch) {
+  XrioConfig::Map out;
+  std::string error;
+  ASSERT_TRUE(ParseConfigDocument(
+      R"json({"battery-status": {"charging": true, "level": 0.5,
+                                 "charging_time": 600,
+                                 "discharging_time": 900}})json",
+      &out, &error))
+      << error;
+  EXPECT_FALSE(ValidateConfig(out, &error));
+  EXPECT_NE(std::string::npos, error.find("discharging_time"));
+}
+
+TEST_F(XrioConfigFileTest, AXrioPrefixIsAcceptedAndStripped) {
+  XrioConfig::Map out;
+  std::string error;
+  ASSERT_TRUE(ParseConfigDocument(R"json({"xrio-seed": "0x2b"})json", &out, &error))
+      << error;
+  EXPECT_EQ("0x2b", out["seed"]);
+  EXPECT_FALSE(out.contains("xrio-seed"));
+}
+
+// `null` reads as "I set this deliberately" while changing nothing, which is the
+// exact class of silent no-op this whole mechanism exists to end.
+TEST_F(XrioConfigFileTest, NullIsRefusedRatherThanTreatedAsAbsent) {
+  XrioConfig::Map out;
+  std::string error;
+  EXPECT_FALSE(ParseConfigDocument(R"json({"seed": null})json", &out, &error));
+  EXPECT_NE(std::string::npos, error.find("seed"));
+  EXPECT_NE(std::string::npos, error.find("null"));
+}
+
+TEST_F(XrioConfigFileTest, TwoSpellingsOfOneKeyAreRefused) {
+  XrioConfig::Map out;
+  std::string error;
+  // Both name gl-persona. flat_map iteration is sorted, so a winner would be
+  // stable but arbitrary -- and whoever wrote both does not know which they get.
+  EXPECT_FALSE(ParseConfigDocument(
+      R"json({"gl": {"persona": "a"}, "gl-persona": "b"})json", &out, &error));
+  EXPECT_NE(std::string::npos, error.find("gl-persona"));
+}
+
+// A knob file whose rows cannot carry a warning is a knob file whose warnings
+// live somewhere nobody reads.
+TEST_F(XrioConfigFileTest, CommentsAndTrailingCommasAreAccepted) {
+  XrioConfig::Map out;
+  std::string error;
+  ASSERT_TRUE(ParseConfigDocument(R"json({
+      // One edit from leaking the real IP. This is exactly the kind of note
+      // that has to sit on the row it is about.
+      "webrtc-ip-handling-policy": "disable_non_proxied_udp",
+      /* block comments too */
+      "seed": "0x2b",
+    })json", &out, &error))
+      << error;
+  EXPECT_EQ("disable_non_proxied_udp", out["webrtc-ip-handling-policy"]);
+  EXPECT_EQ("0x2b", out["seed"]);
+  EXPECT_EQ(2u, out.size());
+}
+
+// A commented-out row must read as ABSENT, not as empty -- that is what makes
+// the shipped template safe to ship with every row commented out.
+TEST_F(XrioConfigFileTest, ACommentedOutRowIsAbsent) {
+  XrioConfig::Map out;
+  std::string error;
+  ASSERT_TRUE(ParseConfigDocument(R"json({
+      // "seed": "0xdeadbeef",
+      "gl-persona": "renoir"
+    })json", &out, &error))
+      << error;
+  EXPECT_FALSE(out.contains("seed"));
+  EXPECT_EQ(1u, out.size());
+}
+
+TEST_F(XrioConfigFileTest, NotAnObjectIsRefused) {
+  XrioConfig::Map out;
+  std::string error;
+  EXPECT_FALSE(ParseConfigDocument("[1, 2, 3]", &out, &error));
+  EXPECT_FALSE(ParseConfigDocument("not json at all", &out, &error));
+}
+
+TEST_F(XrioConfigFileTest, RunawayNestingIsRefused) {
+  XrioConfig::Map out;
+  std::string error;
+  std::string deep = R"json({"a":)json";
+  for (int i = 0; i < 12; ++i) {
+    deep += R"json({"b":)json";
+  }
+  deep += R"json("v")json";
+  for (int i = 0; i < 12; ++i) {
+    deep += "}";
+  }
+  deep += "}";
+  EXPECT_FALSE(ParseConfigDocument(deep, &out, &error));
+}
+
+// ---------------------------------------------------------------------------
+// Merging onto a command line.
+
+TEST_F(XrioConfigFileTest, FileFillsKeysTheCommandLineDoesNotHave) {
+  CommandLine command_line = WithFile(R"json({"seed": "0x2b", "gl-persona": "r"})json");
+  std::string error;
+  ASSERT_TRUE(MergeConfigFile(&command_line, &error)) << error;
+  EXPECT_EQ("0x2b", command_line.GetSwitchValueASCII("xrio-seed"));
+  EXPECT_EQ("r", command_line.GetSwitchValueASCII("xrio-gl-persona"));
+}
+
+// A FLAG BEATS THE FILE. The file is a host's persistent configuration; a flag
+// is what this render decided, and xrio puts its per-render choices there.
+// If the file won, a stale file on the box would silently override a decision
+// the envelope recorded as taken.
+TEST_F(XrioConfigFileTest, AFlagBeatsTheFile) {
+  CommandLine command_line = WithFile(R"json({"seed": "0xfile"})json");
+  command_line.AppendSwitchASCII("xrio-seed", "0xflag");
+  std::string error;
+  ASSERT_TRUE(MergeConfigFile(&command_line, &error)) << error;
+  EXPECT_EQ("0xflag", command_line.GetSwitchValueASCII("xrio-seed"));
+}
+
+TEST_F(XrioConfigFileTest, AFileMayNotNameAnotherFile) {
+  CommandLine command_line = WithFile(R"json({"config-file": "/tmp/other.json"})json");
+  std::string error;
+  EXPECT_FALSE(MergeConfigFile(&command_line, &error));
+  EXPECT_NE(std::string::npos, error.find("config-file"));
+}
+
+// An explicit path is a requirement, not a hint: naming a file that is not there
+// means the operator believes something is configured that is not.
+TEST_F(XrioConfigFileTest, AnExplicitPathThatDoesNotExistRefuses) {
+  CommandLine command_line(CommandLine::NO_PROGRAM);
+  command_line.AppendSwitchASCII(
+      "xrio-config-file",
+      dir_.GetPath().AppendASCII("absent.json").AsUTF8Unsafe());
+  std::string error;
+  EXPECT_FALSE(MergeConfigFile(&command_line, &error));
+  EXPECT_NE(std::string::npos, error.find("absent.json"));
+}
+
+TEST_F(XrioConfigFileTest, AnEmptyExplicitPathRefuses) {
+  CommandLine command_line(CommandLine::NO_PROGRAM);
+  command_line.AppendSwitchASCII("xrio-config-file", "");
+  std::string error;
+  EXPECT_FALSE(MergeConfigFile(&command_line, &error));
+}
+
+TEST_F(XrioConfigFileTest, AMalformedFileRefusesAndNamesThePath) {
+  CommandLine command_line = WithFile("{ this is not json");
+  std::string error;
+  EXPECT_FALSE(MergeConfigFile(&command_line, &error));
+  EXPECT_NE(std::string::npos, error.find("xrio-config.json"));
+}
+
+// ---------------------------------------------------------------------------
+// The startup entry point.
+
+TEST_F(XrioConfigFileTest, NonBrowserProcessesDoNothing) {
+  CommandLine command_line = WithFile(R"json({"seed": "0x2b"})json");
+  EXPECT_EQ(StartupOutcome::kContinue,
+            ApplyStartupConfiguration(&command_line, /*is_browser=*/false));
+  // Untouched: a renderer gets its values over SetXrioConfig, and it could not
+  // open a file from inside the sandbox anyway.
+  EXPECT_FALSE(command_line.HasSwitch("xrio-seed"));
+}
+
+TEST_F(XrioConfigFileTest, AValidConfigIsPublishedIntoXrioConfig) {
+  CommandLine command_line = WithFile(R"json({"pixel-rate-mask": 31})json");
+  ASSERT_EQ(StartupOutcome::kContinue,
+            ApplyStartupConfiguration(&command_line, /*is_browser=*/true));
+  // Published, so the browser process's own reads agree with the map
+  // RenderProcessHostImpl later harvests for each renderer.
+  EXPECT_EQ(UINT64_C(31), Tuning().pixel_rate_mask);
+}
+
+// The whole point of the exercise: a mistyped knob is a refused launch, not a
+// surface that silently stayed upstream.
+TEST_F(XrioConfigFileTest, AMistypedKnobRefusesTheLaunch) {
+  CommandLine command_line = WithFile(R"json({"pixel-rate-msak": 31})json");
+  EXPECT_EQ(StartupOutcome::kRefused,
+            ApplyStartupConfiguration(&command_line, /*is_browser=*/true));
+
+  CommandLine flagged(CommandLine::NO_PROGRAM);
+  flagged.AppendSwitchASCII("xrio-jitter-geomtery", "true");
+  EXPECT_EQ(StartupOutcome::kRefused,
+            ApplyStartupConfiguration(&flagged, /*is_browser=*/true));
+}
+
+TEST_F(XrioConfigFileTest, StartupInstallsThePersonaCeilingBeforeJudging) {
+  SetHostThreadCeilingForTesting(32);
+  ASSERT_TRUE(WriteFile(
+      dir_.GetPath().AppendASCII("tiny.xrio-gl.json"),
+      R"json({"schema": "xrio-gl-table/v2", "name": "tiny",
+          "chrome_version": "154.0.8037.57", "digest": "sha256:0000",
+          "vendor": "V", "renderer": "R", "form_factor": "desktop",
+          "max_threads": 1, "ints": [], "floats": [], "float_arrays": [],
+          "int_arrays": [], "hidden_extensions": []})json"));
+  CommandLine command_line(CommandLine::NO_PROGRAM);
+  command_line.AppendSwitchASCII("xrio-gl-persona", "tiny");
+  command_line.AppendSwitchASCII("xrio-persona-dir",
+                                 dir_.GetPath().AsUTF8Unsafe());
+  command_line.AppendSwitchASCII("xrio-machine-classes", "[[2,4,1,1]]");
+  EXPECT_EQ(StartupOutcome::kRefused,
+            ApplyStartupConfiguration(&command_line, /*is_browser=*/true));
+  EXPECT_EQ(1u, MachineClassCeiling());
+}
+
+TEST_F(XrioConfigFileTest, DumpConfigAnswersAndStops) {
+  CommandLine command_line(CommandLine::NO_PROGRAM);
+  command_line.AppendSwitchASCII("xrio-dump-config", "");
+  EXPECT_EQ(StartupOutcome::kExitSuccess,
+            ApplyStartupConfiguration(&command_line, /*is_browser=*/true));
+}
+
+// The loaded path becomes part of the effective configuration, so
+// --xrio-dump-config answers "which file, if any" with no second mechanism.
+TEST_F(XrioConfigFileTest, TheResolvedPathIsRecorded) {
+  CommandLine command_line = WithFile(R"json({"seed": "0x2b"})json");
+  std::string error;
+  ASSERT_TRUE(MergeConfigFile(&command_line, &error)) << error;
+  EXPECT_NE(std::string::npos,
+            command_line.GetSwitchValueASCII("xrio-config-file")
+                .find("xrio-config.json"));
+}
+
+}  // namespace
+}  // namespace base::xrio
