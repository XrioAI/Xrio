+// ---------------------------------------------------------------------------
+// The machine table, which used to be 36 compiled literals.
+
+TEST_F(XrioKnobsTest, MachineClassesDefaultIsTheOriginalNineRows) {
+  XrioConfig::Get().SetAll({});
+  const span<const MachineClass> classes = MachineClasses();
+  ASSERT_EQ(9u, classes.size());
+  struct Row {
+    unsigned cores;
+    float memory_gb;
+    unsigned free_disk_gb;
+    unsigned weight;
+  };
+  // std::to_array, not a C array: base/ compiles with -Wunsafe-buffer-usage as
+  // an error and that applies to tests too. `classes` is already a span.
+  constexpr auto kExpected = std::to_array<Row>({
+      {4, 8, 120, 12},   {8, 8, 120, 8},    {6, 16, 200, 10},
+      {8, 16, 250, 26},  {16, 16, 300, 8},  {12, 16, 400, 16},
+      {12, 32, 500, 8},  {16, 32, 500, 10}, {24, 32, 700, 2},
+  });
+  unsigned total = 0;
+  for (size_t i = 0; i < classes.size(); ++i) {
+    EXPECT_EQ(kExpected[i].cores, classes[i].cores) << "row " << i;
+    EXPECT_EQ(kExpected[i].memory_gb, classes[i].memory_gb) << "row " << i;
+    EXPECT_EQ(kExpected[i].free_disk_gb, classes[i].free_disk_gb) << "row " << i;
+    EXPECT_EQ(kExpected[i].weight, classes[i].weight) << "row " << i;
+    total += classes[i].weight;
+  }
+  EXPECT_EQ(100u, total) << "the weights are a percentage distribution";
+}
