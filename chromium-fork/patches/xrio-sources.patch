@@ -0,0 +1,92 @@
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_XRIO_CANVAS_PERTURB_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_XRIO_CANVAS_PERTURB_H_
+
+#include <cstdint>
+#include <optional>
+
+#include "base/containers/span.h"
+#include "base/xrio_persona.h"
+#include "base/xrio_perturb.h"
+#include "third_party/skia/include/core/SkData.h"
+#include "third_party/skia/include/core/SkImageInfo.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+#include "third_party/skia/include/core/SkRefCnt.h"
+#include "ui/gfx/skia_span_util.h"
+
+namespace blink::xrio {
+
+// Repoints `*pixmap` at a perturbed COPY of its pixels, owned by `*owner`.
+//
+// Header-only and used from exactly one translation unit, so it needs no
+// BUILD.gn entry of its own.
+//
+// The copy is not an optimisation to remove later, it is the whole point.
+// ImageDataBuffer's pixmap sometimes peeks straight into the live canvas
+// backing store -- the non-accelerated, already-unpremultiplied path takes that
+// branch. Perturbing in place there would mutate the canvas itself: the change
+// would be visible to the next draw, and it would accumulate on every encode, so
+// two successive toDataURL() calls would disagree. That is a far louder signal
+// than the constant hash this is meant to remove.
+//
+// Origin is (0, 0) because this buffer is the whole canvas. getImageData passes
+// its sub-rect origin instead, and passing absolute coordinates in both places
+// is what makes a partial read and a whole-canvas encode agree where they
+// overlap.
+//
+// GATED ON `perturb-canvas`, THE SAME KNOB AS getImageData, and that sharing is
+// load-bearing rather than tidy. This path and the canvas2d readback path both
+// key on the `canvas` sub-seed precisely so a sub-rect read and a whole-canvas
+// encode agree pixel-for-pixel where they overlap. Give them separate enables
+// and a configuration exists in which one is perturbed and the other is not --
+// so toDataURL and getImageData would disagree about the same pixels, which is a
+// far louder signal than the constant hash either would have had on its own
+// (catalog SS2 #50, SS3 #98). One knob, both sites, no such configuration.
+//
+// No-op, leaving the caller's pixels untouched, when: the knob is off, no seed
+// is configured (fail closed), the format is not 4 bytes per pixel, or the
+// geometry does not hold together. Refusing beats guessing -- this code writes
+// into image memory.
+inline void PerturbEncodeSource(SkPixmap* pixmap, sk_sp<SkData>* owner) {
+  if (!pixmap || !owner || !pixmap->addr()) {
+    return;
+  }
+  if (!base::xrio::PerturbCanvasEnabled()) {
+    return;
+  }
+  const std::optional<uint64_t> seed = base::xrio::CanvasSeed();
+  if (!seed.has_value()) {
+    return;
+  }
+  const SkImageInfo& info = pixmap->info();
+  if (info.bytesPerPixel() != 4 || info.width() <= 0 || info.height() <= 0) {
+    return;
+  }
+  const size_t size = pixmap->computeByteSize();
+  if (size == 0 || SkImageInfo::ByteSizeOverflowed(size)) {
+    return;
+  }
+
+  sk_sp<SkData> copy = SkData::MakeUninitialized(size);
+  if (!copy) {
+    return;
+  }
+
+  // Spans throughout, no memcpy and no raw pointers: base/ and blink/ enforce
+  // -Wunsafe-buffer-usage as an error, and span's (ptr, count) constructor is
+  // itself UNSAFE_BUFFER_USAGE. Both pixmaps share `info` and `rowBytes`, so the
+  // two spans are the same length and copy_from() is exact.
+  SkPixmap perturbed(info, copy->writable_data(), pixmap->rowBytes());
+  base::span<uint8_t> destination = gfx::SkPixmapToWritableSpan(perturbed);
+  destination.copy_from(gfx::SkPixmapToSpan(*pixmap));
+
+  base::xrio::PerturbPixels(destination, perturbed.rowBytes(), info.width(),
+                           info.height(), info.bytesPerPixel(),
+                           /*origin_x=*/0, /*origin_y=*/0, seed.value());
+
+  *pixmap = perturbed;
+  *owner = std::move(copy);
+}
+
+}  // namespace blink::xrio
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_XRIO_CANVAS_PERTURB_H_
