+  // Interned, so the pointer is stable across calls -- the WebGL patch keeps it
+  // only long enough to build a Blink String, but a dangling one would be a
+  // use-after-free rather than a wrong string.
+  EXPECT_EQ(GlVendor(), GlVendor());
+
+  // An empty value is absent, not empty-string: the artifact's own value stands.
+  XrioConfig::Get().SetAll({{"gl-persona", kPersona},
+                           {"gl-table", kArtifact},
+                           {"gl-renderer", ""}});
+  EXPECT_EQ(from_artifact, std::string(GlRenderer()));
+
+  // No table, no string, whatever the knobs say.
+  XrioConfig::Get().SetAll({{"gl-vendor", "Google Inc. (NVIDIA)"}});
+  EXPECT_EQ(nullptr, GlVendor());
+  XrioConfig::Get().SetAll({});
+}
+
+// The four endpoints the NetLog capture found. Each defaults to the umbrella, so
+// one flag still silences the group and one flag can turn a single member back
+// on -- and a member that silently ignored its own key would be the "reads as
+// working while doing nothing" defect the registry exists to end.
+// The headless permission row, and specifically its DEFAULT. Every other
+// identity-shaped knob defaults true because its closed state is the dangerous
+// one -- a forgotten flag would restore `webdriver === true` or a
+// `HeadlessChrome` token. This one is the exception, and the exception has to be
+// asserted or it reads as a knob somebody forgot to turn on:
+//
+//   closed state  headless denies every permission request. A tell, and the
+//                 difference from headed this row exists to remove -- but safe.
+//   open state    Chrome's normal prompt path, whose Views construction opens
+//                 with CHECK(GetNativeWindow()). Unproven under ozone/headless.
+//
+// A tell is worse than nothing; a CHECK is worse than a tell. So it ships off,
+// and flipping it is gated on a measurement no unit test can make.
+//
+// It is also NOT under suppress-automation-blockers, and that is deliberate:
+// that umbrella exists to stop automation hanging on dialogs, and this row does
+// the opposite -- it lets an undecided request stay pending exactly as headed
+// does. Putting it under that umbrella would mean "make automation not hang"
+// also silently meant "keep the headless permission tell".
+TEST(XrioPersonaTest, HeadfulPermissionPromptsInHeadlessShipOff) {
+  XrioConfig::Get().SetAll({});
+  EXPECT_FALSE(HeadfulPermissionPromptsEnabled());
+
+  XrioConfig::Get().SetAll({{"headful-permission-prompts", "true"}});
+  EXPECT_TRUE(HeadfulPermissionPromptsEnabled());
+
+  // Not umbrella'd. Both directions, because the interesting failure is the
+  // one where a group switch reaches a row it should not.
+  XrioConfig::Get().SetAll({{"suppress-automation-blockers", "false"}});
+  EXPECT_FALSE(HeadfulPermissionPromptsEnabled());
+  XrioConfig::Get().SetAll({{"suppress-automation-blockers", "true"}});
+  EXPECT_FALSE(HeadfulPermissionPromptsEnabled());
+
+  // And it is independent of the persona and the seed: this is a browser-side
+  // behaviour, not a rendered surface, so it must not acquire a GL gate the way
+  // the readback rows did.
+  XrioConfig::Get().SetAll({{"headful-permission-prompts", "true"},
+                           {"seed", "0x2b"}});
+  EXPECT_TRUE(HeadfulPermissionPromptsEnabled());
+  XrioConfig::Get().SetAll({});
+}
