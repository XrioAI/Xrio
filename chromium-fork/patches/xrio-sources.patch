+// ---------------------------------------------------------------------------
+// The tuning struct. This is the load-bearing safety test for the whole
+// conversion: at the defaults it must hold exactly the literals that were
+// compiled in before, or every hash this fork has ever produced changes.
+
+TEST_F(XrioKnobsTest, TuningDefaultsAreThePreviousCompiledConstants) {
+  XrioConfig::Get().SetAll({});
+  const PerturbTuning& t = Tuning();
+  EXPECT_EQ(UINT64_C(0xff51afd7ed558ccd), t.hash_mix_1);
+  EXPECT_EQ(UINT64_C(0xc4ceb9fe1a85ec53), t.hash_mix_2);
+  EXPECT_EQ(UINT64_C(33), t.hash_shift);
+  EXPECT_EQ(UINT64_C(0xcbf29ce484222325), t.seed_tag_basis);
+  EXPECT_EQ(UINT64_C(0x100000001b3), t.seed_tag_prime);
+  EXPECT_EQ(UINT64_C(1), t.seed_zero_substitute);
+  EXPECT_EQ(UINT64_C(0x9E3779B97F4A7C15), t.coord_mixer);
+  EXPECT_EQ(UINT64_C(0x9E3779B97F4A7C15), t.audio_channel_mixer);
+  EXPECT_EQ(UINT64_C(0x7), t.pixel_rate_mask);
+  EXPECT_EQ(UINT64_C(0), t.pixel_rate_phase);
+  EXPECT_EQ(1u, t.pixel_bit_mask);
+  EXPECT_EQ(3u, t.channel_shift) << "must be the width of the rate mask, or the "
+                                << "rate and channel decisions correlate";
+  EXPECT_EQ(0.999, t.audio_scale_floor);
+  EXPECT_EQ(0.001, t.audio_scale_span);
+  EXPECT_EQ(64.0, t.jitter_quantum);
+  EXPECT_EQ(41, t.jitter_steps);
+  EXPECT_EQ(1024.0, t.jitter_step_size);
+}
