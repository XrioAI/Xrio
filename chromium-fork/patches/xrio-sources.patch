+// static
+std::unique_ptr<SpeechTable> SpeechTable::Parse(std::string_view json,
+                                                std::string_view expected_name,
+                                                std::string* error) {
+  std::optional<DictValue> parsed = JSONReader::ReadDict(json, JSON_PARSE_RFC);
+  if (!parsed) {
+    *error = "not a JSON object";
+    return nullptr;
+  }
+  const DictValue& dict = *parsed;
+
+  const std::string* schema = RequiredString(dict, "schema", error);
+  if (!schema) {
+    return nullptr;
+  }
+  if (*schema != kSchema) {
+    *error = StrCat({"schema '", *schema, "' is not '", kSchema, "'"});
+    return nullptr;
+  }
+  const std::string* name = RequiredString(dict, "name", error);
+  if (!name) {
+    return nullptr;
+  }
+  if (*name != expected_name) {
+    *error = StrCat({"artifact names persona '", *name, "' but '",
+                     expected_name, "' was selected"});
+    return nullptr;
+  }
+  const std::string* chrome_version =
+      RequiredString(dict, "chrome_version", error);
+  if (!chrome_version) {
+    return nullptr;
+  }
+  const std::string* digest = RequiredString(dict, "digest", error);
+  if (!digest) {
+    return nullptr;
+  }
+  for (std::string_view field : {"manifest", "implementation",
+                                 "implementation_sha256", "reference",
+                                 "reference_chrome_version"}) {
+    if (!RequiredString(dict, field, error)) {
+      return nullptr;
+    }
+  }
+  const ListValue* voices = dict.FindList("voices");
+  if (!voices || voices->empty()) {
+    *error = "field 'voices' is missing, not a list, or empty";
+    return nullptr;
+  }
+
+  std::unique_ptr<SpeechTable> table(new SpeechTable());
+  table->name_ = *name;
+  table->chrome_version_ = *chrome_version;
+  table->digest_ = *digest;
+  for (size_t index = 0; index < voices->size(); ++index) {
+    const DictValue* row = (*voices)[index].GetIfDict();
+    if (!row) {
+      *error = "voice entry is not an object";
+      return nullptr;
+    }
+    const std::string* voice_uri = RequiredString(*row, "voice_uri", error);
+    const std::string* voice_name = RequiredString(*row, "name", error);
+    const std::string* lang = RequiredString(*row, "lang", error);
+    bool local_service = false;
+    bool is_default = false;
+    if (!voice_uri || !voice_name || !lang ||
+        !RequiredBool(*row, "local_service", &local_service, error) ||
+        !RequiredBool(*row, "is_default", &is_default, error)) {
+      return nullptr;
+    }
+    // Chromium 152's SpeechSynthesis bridge derives voiceURI from name. Refuse
+    // artifacts that promise a distinction this build cannot reproduce.
+    if (*voice_uri != *voice_name) {
+      *error = "voice_uri must equal name in Chromium 152";
+      return nullptr;
+    }
+    if (static_cast<bool>(index == 0) != is_default) {
+      *error = "exactly the first voice must be the sole default";
+      return nullptr;
+    }
+    if (local_service) {
+      *error = "this schema only supports the measured remote Google voices";
+      return nullptr;
+    }
+    if (std::any_of(table->voices_.begin(), table->voices_.end(),
+                    [&](const SpeechVoice& voice) {
+                      return voice.voice_uri == *voice_uri;
+                    })) {
+      *error = StrCat({"duplicate voice identity: ", *voice_uri});
+      return nullptr;
+    }
+    const ListValue* events = row->FindList("event_types");
+    if (!events) {
+      *error = "field 'event_types' is missing or not a list";
+      return nullptr;
+    }
+    SpeechVoice voice{*voice_uri, *voice_name, *lang, local_service,
+                      is_default, {}};
+    for (const Value& event : *events) {
+      const std::string* event_name = event.GetIfString();
+      SpeechEventType event_type;
+      if (!event_name || !EventTypeFromName(*event_name, &event_type)) {
+        *error = "event_types accepts only start, end, and error";
+        return nullptr;
+      }
+      if (std::find(voice.event_types.begin(), voice.event_types.end(),
+                    event_type) != voice.event_types.end()) {
+        *error = StrCat({"duplicate event type: ", *event_name});
+        return nullptr;
+      }
+      voice.event_types.push_back(event_type);
+    }
+    if (voice.event_types.size() != 3u) {
+      *error = "each remote voice must declare start, end, and error";
+      return nullptr;
+    }
+    table->voices_.push_back(std::move(voice));
+  }
+  return table;
+}
+
+void ExpandSpeechTable(XrioConfig::Map* map) {
+  if (!map) {
+    return;
+  }
+  map->erase("speech-table");
+  auto persona = map->find("speech-persona");
+  if (persona == map->end() || persona->second.empty()) {
+    return;
+  }
+  auto dir = map->find("persona-dir");
+  std::optional<std::string> body = ReadSpeechBody(
+      persona->second, dir == map->end() ? std::string() : dir->second);
+  if (body) {
+    map->insert_or_assign("speech-table", std::move(*body));
+  }
+}
+
+void InstallBrowserSpeechTable(const XrioConfig::Map& map) {
+  const auto persona = map.find("speech-persona");
+  const auto body = map.find("speech-table");
+  const std::string name =
+      persona == map.end() ? std::string() : persona->second;
+  const std::string json = body == map.end() ? std::string() : body->second;
+
+  BrowserTableCache& cache = GetBrowserTableCache();
+  AutoLock guard(cache.lock);
+  if (cache.name == name && cache.body == json) {
+    return;
+  }
+  std::unique_ptr<SpeechTable> table;
+  if (!name.empty() && !json.empty()) {
+    std::string error;
+    table = SpeechTable::Parse(json, name, &error);
+  }
+  cache.name = name;
+  cache.body = json;
+  cache.active = table.get();
+  if (table) {
+    cache.retained.push_back(std::move(table));
+  }
+}
+
+const SpeechTable* BrowserSpeechTable() {
+  BrowserTableCache& cache = GetBrowserTableCache();
+  AutoLock guard(cache.lock);
+  return cache.active;
+}
+
+bool BrowserSpeechPersonaSelected() {
+  BrowserTableCache& cache = GetBrowserTableCache();
+  AutoLock guard(cache.lock);
+  return !cache.name.empty();
+}
+
+const SpeechTable* ActiveSpeechTable() {
+  struct Cache {
+    Lock lock;
+    bool primed GUARDED_BY(lock) = false;
+    uint32_t generation GUARDED_BY(lock) = 0;
+    raw_ptr<const SpeechTable> active GUARDED_BY(lock) = nullptr;
+    std::vector<std::unique_ptr<SpeechTable>> retained GUARDED_BY(lock);
+  };
+  static NoDestructor<Cache> cache;
+
+  const uint32_t generation = XrioConfig::Get().generation();
+  AutoLock guard(cache->lock);
+  if (cache->primed && cache->generation == generation) {
+    return cache->active;
+  }
+  std::unique_ptr<SpeechTable> table;
+  const std::string name = XrioConfig::Get().GetString("speech-persona");
+  if (!name.empty()) {
+    const std::string body = XrioConfig::Get().GetString("speech-table");
+    if (!body.empty()) {
+      std::string error;
+      table = SpeechTable::Parse(body, name, &error);
+    }
+  }
+  cache->active = table.get();
+  if (table) {
+    cache->retained.push_back(std::move(table));
+  }
+  cache->primed = true;
+  cache->generation = generation;
+  return cache->active;
+}
+
+}  // namespace base::xrio
diff --git a/base/xrio_speech_table.h b/base/xrio_speech_table.h
new file mode 100644
index 0000000000000000000000000000000000000000..73e7b3f1dc3c639543f3b67278c453bbf85bf564
--- /dev/null
+++ b/base/xrio_speech_table.h
@@ -0,0 +1,84 @@
+#ifndef BASE_XRIO_SPEECH_TABLE_H_
+#define BASE_XRIO_SPEECH_TABLE_H_
+
+#include <memory>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/base_export.h"
+#include "base/xrio_config.h"
+
+namespace base::xrio {
+
+enum class SpeechEventType {
+  kStart,
+  kEnd,
+  kError,
+};
+
+// One voice exposed by speechSynthesis.getVoices(). The fields deliberately
+// match the web-facing model rather than content::VoiceData, keeping //base
+// independent of //content and preserving the captured list exactly.
+struct BASE_EXPORT SpeechVoice {
+  std::string voice_uri;
+  std::string name;
+  std::string lang;
+  bool local_service;
+  bool is_default;
+  std::vector<SpeechEventType> event_types;
+};
+
+// An ordered speech voice-list artifact. Parsing is all-or-nothing: a partial
+// voice list is a stronger fingerprint contradiction than the stock empty list.
+class BASE_EXPORT SpeechTable {
+ public:
+  static constexpr std::string_view kSchema = "xrio-speech-table/v1";
+
+  static std::unique_ptr<SpeechTable> Parse(std::string_view json,
+                                            std::string_view expected_name,
+                                            std::string* error);
+
+  SpeechTable(const SpeechTable&) = delete;
+  SpeechTable& operator=(const SpeechTable&) = delete;
+  ~SpeechTable();
+
+  const std::string& name() const { return name_; }
+  const std::string& chrome_version() const { return chrome_version_; }
+  const std::string& digest() const { return digest_; }
+  const std::vector<SpeechVoice>& voices() const { return voices_; }
+
+ private:
+  SpeechTable();
+
+  std::string name_;
+  std::string chrome_version_;
+  std::string digest_;
+  std::vector<SpeechVoice> voices_;
+};
+
+// Replaces any injected "speech-table" body with
+// `<speech-persona><speech-table-suffix>` from the configured persona directory.
+BASE_EXPORT void ExpandSpeechTable(XrioConfig::Map* map);
+
+// Installs the already-expanded table for browser-process consumers. The
+// expansion happens in RenderProcessHostImpl::Init, before any renderer can ask
+// for Web Speech, so TTS never performs blocking file I/O on its UI sequence.
+BASE_EXPORT void InstallBrowserSpeechTable(const XrioConfig::Map& map);
+
+// The immutable browser-process table installed above, or nullptr. Returned
+// objects are retained for process lifetime so callers need no lock or owner.
+BASE_EXPORT const SpeechTable* BrowserSpeechTable();
+
+// True when the operator selected a speech persona, including when its artifact
+// was absent or invalid. Consumers use this to fail to an empty list rather
+// than leak host voices under a configuration that claimed a persona.
+BASE_EXPORT bool BrowserSpeechPersonaSelected();
+
+// Lazily parses the table selected by the current XrioConfig generation. An
+// empty "speech-persona" always means off, even if a table body is present.
+BASE_EXPORT const SpeechTable* ActiveSpeechTable();
+
+}  // namespace base::xrio
+
+#endif  // BASE_XRIO_SPEECH_TABLE_H_
diff --git a/base/xrio_speech_table_unittest.cc b/base/xrio_speech_table_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..5827f1e92de6ea576889205a50a2437b306d5cb2
--- /dev/null
+++ b/base/xrio_speech_table_unittest.cc
@@ -0,0 +1,245 @@
+#include "base/xrio_speech_table.h"
+
+#include <memory>
+#include <string>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/xrio_config.h"
+#include "base/strings/strcat.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace base::xrio {
+namespace {
+
+constexpr char kName[] = "stock-linux-speech";
+
+std::string Artifact(std::string_view name = kName) {
+  return StrCat({R"json({
+  "schema": "xrio-speech-table/v1",
+  "name": ")json",
+                 name, R"json(",
+  "chrome_version": "152.0.7977.64",
+  "manifest": "manifest.json",
+  "implementation": "tts_extension.js",
+  "implementation_sha256": "sha256:1111",
+  "reference": "surfaces-xvfb.json",
+  "reference_chrome_version": "152.0.7977.75",
+  "voices": [
+    {"voice_uri":"Google Deutsch","name":"Google Deutsch","lang":"de-DE",
+     "local_service":false,"is_default":true,"event_types":["start","end","error"]},
+    {"voice_uri":"Google US English","name":"Google US English","lang":"en-US",
+     "local_service":false,"is_default":false,"event_types":["start","end","error"]}
+  ],
+  "digest": "sha256:0000"
+})json"});
+}
+
+std::unique_ptr<SpeechTable> ParseWithout(std::string_view key,
+                                          std::string* error) {
+  std::string body = Artifact();
+  const std::string needle = StrCat({"\"", key, "\":"});
+  const size_t at = body.find(needle);
+  CHECK_NE(at, std::string::npos);
+  body[at + 1] = '_';
+  return SpeechTable::Parse(body, kName, error);
+}
+
+class SpeechTableTest : public testing::Test {
+ public:
+  SpeechTableTest() {
+    XrioConfig::Get().SetAll({});
+    InstallBrowserSpeechTable({});
+  }
+  ~SpeechTableTest() override {
+    XrioConfig::Get().SetAll({});
+    InstallBrowserSpeechTable({});
+  }
+};
+
+TEST_F(SpeechTableTest, ParsesCompleteOrderedVoiceModel) {
+  std::string error;
+  auto table = SpeechTable::Parse(Artifact(), kName, &error);
+  ASSERT_TRUE(table) << error;
+  EXPECT_EQ(kName, table->name());
+  EXPECT_EQ("152.0.7977.64", table->chrome_version());
+  EXPECT_EQ("sha256:0000", table->digest());
+  ASSERT_EQ(2u, table->voices().size());
+  const SpeechVoice& first = table->voices()[0];
+  EXPECT_EQ("Google Deutsch", first.voice_uri);
+  EXPECT_EQ(first.voice_uri, first.name);
+  EXPECT_EQ("de-DE", first.lang);
+  EXPECT_FALSE(first.local_service);
+  EXPECT_TRUE(first.is_default);
+  EXPECT_EQ((std::vector<SpeechEventType>{SpeechEventType::kStart,
+                                          SpeechEventType::kEnd,
+                                          SpeechEventType::kError}),
+            first.event_types);
+  EXPECT_EQ("Google US English", table->voices()[1].name);
+  EXPECT_FALSE(table->voices()[1].is_default);
+}
+
+TEST_F(SpeechTableTest, RefusesMalformedEnvelopeAndMissingProvenance) {
+  std::string error;
+  EXPECT_EQ(nullptr, SpeechTable::Parse("{not json", kName, &error));
+  EXPECT_EQ(nullptr, SpeechTable::Parse("[]", kName, &error));
+  std::string wrong = Artifact();
+  wrong.replace(wrong.find("xrio-speech-table/v1"), 19,
+                "xrio-speech-table/v2");
+  EXPECT_EQ(nullptr, SpeechTable::Parse(wrong, kName, &error));
+  EXPECT_EQ(nullptr, SpeechTable::Parse(Artifact(), "another", &error));
+  EXPECT_EQ(nullptr, ParseWithout("chrome_version", &error));
+  EXPECT_EQ(nullptr, ParseWithout("digest", &error));
+  EXPECT_EQ(nullptr, ParseWithout("reference_chrome_version", &error));
+  EXPECT_EQ(nullptr, ParseWithout("implementation_sha256", &error));
+}
+
+TEST_F(SpeechTableTest, RefusesMissingOrEmptyVoices) {
+  std::string error;
+  EXPECT_EQ(nullptr, ParseWithout("voices", &error));
+  std::string empty = Artifact();
+  const size_t begin = empty.find('[', empty.find("\"voices\""));
+  const size_t end = empty.rfind(']');
+  empty.replace(begin + 1, end - begin - 1, "");
+  EXPECT_EQ(nullptr, SpeechTable::Parse(empty, kName, &error));
+}
+
+TEST_F(SpeechTableTest, RefusesIncompleteAndWrongTypedVoiceFields) {
+  std::string error;
+  for (std::string_view field : {"voice_uri", "name", "lang",
+                                 "local_service", "is_default",
+                                 "event_types"}) {
+    EXPECT_EQ(nullptr, ParseWithout(field, &error)) << field;
+  }
+  std::string wrong_bool = Artifact();
+  wrong_bool.replace(wrong_bool.find("\"local_service\":false"), 21,
+                     "\"local_service\":\"false\"");
+  EXPECT_EQ(nullptr, SpeechTable::Parse(wrong_bool, kName, &error));
+}
+
+TEST_F(SpeechTableTest, RefusesUriMismatchAndDuplicateIdentity) {
+  std::string error;
+  std::string mismatch = Artifact();
+  mismatch.replace(mismatch.find("\"voice_uri\":\"Google Deutsch\""), 28,
+                   "\"voice_uri\":\"different\"");
+  EXPECT_EQ(nullptr, SpeechTable::Parse(mismatch, kName, &error));
+  EXPECT_NE(std::string::npos, error.find("must equal"));
+
+  std::string duplicate = Artifact();
+  const std::string us = "Google US English";
+  duplicate.replace(duplicate.find(us), us.size(), "Google Deutsch");
+  duplicate.replace(duplicate.find(us), us.size(), "Google Deutsch");
+  EXPECT_EQ(nullptr, SpeechTable::Parse(duplicate, kName, &error));
+  EXPECT_NE(std::string::npos, error.find("duplicate voice"));
+}
+
+TEST_F(SpeechTableTest, RefusesAnyDefaultOtherThanSoleFirst) {
+  std::string error;
+  std::string no_default = Artifact();
+  no_default.replace(no_default.find("\"is_default\":true"), 17,
+                     "\"is_default\":false");
+  EXPECT_EQ(nullptr, SpeechTable::Parse(no_default, kName, &error));
+
+  std::string second_default = Artifact();
+  const size_t second = second_default.rfind("\"is_default\":false");
+  second_default.replace(second, 18, "\"is_default\":true");
+  EXPECT_EQ(nullptr, SpeechTable::Parse(second_default, kName, &error));
+}
+
+TEST_F(SpeechTableTest, RefusesUnknownNonStringAndDuplicateEvents) {
+  std::string error;
+  std::string unknown = Artifact();
+  unknown.replace(unknown.find("\"start\""), 7, "\"pause\"");
+  EXPECT_EQ(nullptr, SpeechTable::Parse(unknown, kName, &error));
+
+  std::string non_string = Artifact();
+  non_string.replace(non_string.find("\"start\""), 7, "1");
+  EXPECT_EQ(nullptr, SpeechTable::Parse(non_string, kName, &error));
+
+  std::string duplicate = Artifact();
+  duplicate.replace(duplicate.find("\"start\",\"end\""), 13,
+                    "\"start\",\"start\"");
+  EXPECT_EQ(nullptr, SpeechTable::Parse(duplicate, kName, &error));
+  EXPECT_NE(std::string::npos, error.find("duplicate event"));
+
+  std::string missing = Artifact();
+  missing.replace(missing.find("\"start\",\"end\",\"error\""), 21,
+                  "\"start\",\"end\"");
+  EXPECT_EQ(nullptr, SpeechTable::Parse(missing, kName, &error));
+  EXPECT_NE(std::string::npos, error.find("start, end, and error"));
+
+  std::string local = Artifact();
+  local.replace(local.find("\"local_service\":false"), 21,
+                "\"local_service\":true");
+  EXPECT_EQ(nullptr, SpeechTable::Parse(local, kName, &error));
+  EXPECT_NE(std::string::npos, error.find("remote Google voices"));
+}
+
+TEST_F(SpeechTableTest, ActiveRequiresIndependentNonemptySelector) {
+  XrioConfig::Get().SetAll({{"speech-table", Artifact()}});
+  EXPECT_EQ(nullptr, ActiveSpeechTable());
+
+  XrioConfig::Get().SetAll(
+      {{"gl-persona", kName}, {"speech-table", Artifact()}});
+  EXPECT_EQ(nullptr, ActiveSpeechTable());
+
+  XrioConfig::Get().SetAll(
+      {{"speech-persona", kName}, {"speech-table", Artifact()}});
+  ASSERT_NE(nullptr, ActiveSpeechTable());
+  EXPECT_EQ(2u, ActiveSpeechTable()->voices().size());
+
+  XrioConfig::Get().SetAll(
+      {{"speech-persona", "wrong"}, {"speech-table", Artifact()}});
+  EXPECT_EQ(nullptr, ActiveSpeechTable());
+}
+
+TEST_F(SpeechTableTest, ExpandLoadsArtifactAndStripsInjectedBody) {
+  ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const FilePath artifact =
+      dir.GetPath().AppendASCII(StrCat({kName, ".xrio-speech.json"}));
+  ASSERT_TRUE(WriteFile(artifact, Artifact()));
+
+  XrioConfig::Map injected{{"speech-persona", kName},
+                          {"speech-table", "injected"}};
+  ExpandSpeechTable(&injected);
+  EXPECT_EQ(injected.end(), injected.find("speech-table"));
+
+  XrioConfig::Map map{{"speech-persona", kName},
+                     {"persona-dir", dir.GetPath().AsUTF8Unsafe()}};
+  ExpandSpeechTable(&map);
+  ASSERT_NE(map.end(), map.find("speech-table"));
+  EXPECT_EQ(Artifact(), map["speech-table"]);
+
+  XrioConfig::Map off{{"speech-persona", ""},
+                     {"persona-dir", dir.GetPath().AsUTF8Unsafe()},
+                     {"speech-table", "injected"}};
+  ExpandSpeechTable(&off);
+  EXPECT_EQ(off.end(), off.find("speech-table"));
+
+  XrioConfig::Map traversal{{"speech-persona", "../stock-linux-speech"},
+                           {"persona-dir", dir.GetPath().AsUTF8Unsafe()}};
+  ExpandSpeechTable(&traversal);
+  EXPECT_EQ(traversal.end(), traversal.find("speech-table"));
+}
+
+TEST_F(SpeechTableTest, BrowserInstallUsesOnlyExpandedValidArtifact) {
+  XrioConfig::Map map{{"speech-persona", kName},
+                     {"speech-table", Artifact()}};
+  InstallBrowserSpeechTable(map);
+  ASSERT_NE(nullptr, BrowserSpeechTable());
+  EXPECT_TRUE(BrowserSpeechPersonaSelected());
+  EXPECT_EQ(2u, BrowserSpeechTable()->voices().size());
+
+  InstallBrowserSpeechTable(
+      {{"speech-persona", "wrong"}, {"speech-table", Artifact()}});
+  EXPECT_EQ(nullptr, BrowserSpeechTable());
+  EXPECT_TRUE(BrowserSpeechPersonaSelected());
+
+  InstallBrowserSpeechTable({});
+  EXPECT_EQ(nullptr, BrowserSpeechTable());
+  EXPECT_FALSE(BrowserSpeechPersonaSelected());
+}
+
+}  // namespace
+}  // namespace base::xrio
diff --git a/content/browser/speech/xrio_speech_persona.h b/content/browser/speech/xrio_speech_persona.h
new file mode 100644
index 0000000000000000000000000000000000000000..70a4d0bc2527cf6edc8f5157aa14390e65e0bbbd
--- /dev/null
+++ b/content/browser/speech/xrio_speech_persona.h
@@ -0,0 +1,116 @@
+#ifndef CONTENT_BROWSER_SPEECH_XRIO_SPEECH_PERSONA_H_
+#define CONTENT_BROWSER_SPEECH_XRIO_SPEECH_PERSONA_H_
+
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/xrio_speech_table.h"
+#include "content/public/browser/tts_controller.h"
+#include "net/base/network_change_notifier.h"
+
+namespace content::xrio {
+
+inline constexpr char kSpeechPersonaEngineId[] = "xrio-speech-persona";
+inline constexpr char kSpeechPersonaUnavailableEngineId[] =
+    "xrio-speech-persona-unavailable";
+
+enum class SpeechPersonaRoute {
+  kUpstream,
+  kBlockedRemote,
+  kUnavailable,
+};
+
+// Mirrors TtsControllerImpl's policy: branded Chrome does not advertise its
+// remote Google voices while offline or on a metered cellular connection.
+inline bool RemoteVoicesAllowed() {
+  using ConnectionType = net::NetworkChangeNotifier::ConnectionType;
+  switch (net::NetworkChangeNotifier::GetConnectionType()) {
+    case ConnectionType::CONNECTION_UNKNOWN:
+    case ConnectionType::CONNECTION_ETHERNET:
+    case ConnectionType::CONNECTION_WIFI:
+    case ConnectionType::CONNECTION_BLUETOOTH:
+      return true;
+    case ConnectionType::CONNECTION_2G:
+    case ConnectionType::CONNECTION_3G:
+    case ConnectionType::CONNECTION_4G:
+    case ConnectionType::CONNECTION_5G:
+    case ConnectionType::CONNECTION_NONE:
+      return false;
+  }
+  return false;
+}
+
+inline const base::xrio::SpeechTable* ActiveSpeechPersona() {
+  if (!RemoteVoicesAllowed()) {
+    return nullptr;
+  }
+  return base::xrio::BrowserSpeechTable();
+}
+
+// Replaces only the Web Speech list. chrome.tts, accessibility and native TTS
+// keep the platform/controller list rather than inheriting a page-facing mask.
+inline void ApplySpeechPersona(std::vector<VoiceData>* voices) {
+  if (!base::xrio::BrowserSpeechPersonaSelected()) {
+    return;
+  }
+  voices->clear();
+  const base::xrio::SpeechTable* table = ActiveSpeechPersona();
+  if (!table) {
+    return;
+  }
+  voices->reserve(table->voices().size());
+  for (const base::xrio::SpeechVoice& captured : table->voices()) {
+    VoiceData voice;
+    voice.name = captured.name;
+    voice.lang = captured.lang;
+    voice.engine_id = kSpeechPersonaEngineId;
+    voice.remote = !captured.local_service;
+    voice.native = false;
+    for (base::xrio::SpeechEventType event : captured.event_types) {
+      switch (event) {
+        case base::xrio::SpeechEventType::kStart:
+          voice.events.insert(TTS_EVENT_START);
+          break;
+        case base::xrio::SpeechEventType::kEnd:
+          voice.events.insert(TTS_EVENT_END);
+          break;
+        case base::xrio::SpeechEventType::kError:
+          voice.events.insert(TTS_EVENT_ERROR);
+          break;
+      }
+    }
+    voices->push_back(std::move(voice));
+  }
+}
+
+inline SpeechPersonaRoute SpeechPersonaRouteFor(std::string_view voice_name) {
+  if (!base::xrio::BrowserSpeechPersonaSelected()) {
+    return SpeechPersonaRoute::kUpstream;
+  }
+  const base::xrio::SpeechTable* table = ActiveSpeechPersona();
+  if (!table) {
+    return SpeechPersonaRoute::kUnavailable;
+  }
+  if (voice_name.empty()) {
+    return SpeechPersonaRoute::kBlockedRemote;
+  }
+  for (const base::xrio::SpeechVoice& voice : table->voices()) {
+    if (voice.name == voice_name) {
+      return SpeechPersonaRoute::kBlockedRemote;
+    }
+  }
+  return SpeechPersonaRoute::kUnavailable;
+}
+
+inline bool IsSpeechPersonaEngine(std::string_view engine_id) {
+  return engine_id == kSpeechPersonaEngineId;
+}
+
+inline bool IsUnavailableSpeechPersonaEngine(std::string_view engine_id) {
+  return engine_id == kSpeechPersonaUnavailableEngineId;
+}
+
+}  // namespace content::xrio
+
+#endif  // CONTENT_BROWSER_SPEECH_XRIO_SPEECH_PERSONA_H_
diff --git a/services/device/battery/xrio_battery_persona.cc b/services/device/battery/xrio_battery_persona.cc
new file mode 100644
index 0000000000000000000000000000000000000000..b00fd26ef9aec631b73c9e6c358a9b951e3fee0d
--- /dev/null
+++ b/services/device/battery/xrio_battery_persona.cc
@@ -0,0 +1,29 @@
+#include "services/device/battery/xrio_battery_persona.h"
+
+#include <optional>
+
+#include "base/xrio_persona.h"
+
+namespace device::xrio {
+
+mojom::BatteryStatus ApplyBatteryPersona(const mojom::BatteryStatus& status) {
+  // Fully qualified from the global namespace: this is device::xrio, and an
+  // unqualified `base` here would be found by lookup in any future
+  // device::base before it reached ::base.
+  const std::optional<::base::xrio::BatteryStatus> configured =
+      ::base::xrio::BatteryStatusOverride();
+  if (!configured.has_value()) {
+    // Upstream, byte for byte. This is the shipped state: the knob is absent by
+    // default, so an unconfigured build reaches every consumer with the value
+    // the platform backend produced and nothing here is observable.
+    return status;
+  }
+  mojom::BatteryStatus out;
+  out.charging = configured->charging;
+  out.charging_time = configured->charging_time;
+  out.discharging_time = configured->discharging_time;
+  out.level = configured->level;
+  return out;
+}
+
+}  // namespace device::xrio
diff --git a/services/device/battery/xrio_battery_persona.h b/services/device/battery/xrio_battery_persona.h
new file mode 100644
index 0000000000000000000000000000000000000000..a43bf6e6f346ae09600249dd647f679a36d96a0f
--- /dev/null
+++ b/services/device/battery/xrio_battery_persona.h
@@ -0,0 +1,45 @@
+#ifndef SERVICES_DEVICE_BATTERY_XRIO_BATTERY_PERSONA_H_
+#define SERVICES_DEVICE_BATTERY_XRIO_BATTERY_PERSONA_H_
+
+#include "services/device/public/mojom/battery_status.mojom.h"
+
+namespace device::xrio {
+
+// The status every consumer should see, given the one the platform backend
+// produced.
+//
+// WHY THIS IS HERE AND NOT IN base/. `base::xrio::BatteryStatus` is a plain
+// value object with a parser, and it stays that way: base/ must not learn the
+// device service's mojo type, and there is no reason for it to -- the only
+// thing missing at that layer is the mapping, which is this function. So the
+// knob, its rules and its fail-closed read live in base/xrio_persona.*, the
+// mapping lives here, and the upstream patch carries one include and one call
+// per hook. patches/README.md: no logic in a patch, ever.
+//
+// WHY THE SERVICE AND NOT BLINK. The fork catalog's §5 #64 points at Blink's
+// BatteryManager, and for this surface that is the wrong seam:
+//
+//   * ONE transformation covers every renderer and every late subscriber. A
+//     Blink hook would consume configuration once per renderer, and a renderer
+//     that read XrioConfig before the mojo push would answer differently from
+//     one that read it after.
+//   * The service's CACHED status (`status_`) is what a late subscriber is
+//     handed. Transforming after the cache would leave the cache holding the
+//     host's value and hand the raw one to whoever subscribed second.
+//   * Blink compares old against new to decide which change events to fire
+//     (battery_manager.cc DidUpdateData). Transforming below it means those
+//     comparisons run on transformed values, so a host-only change -- a real
+//     laptop being unplugged mid-render -- produces no page-visible event while
+//     the override is fixed. Hooking above that comparison would leak the
+//     host's every transition as an event with unchanged attributes.
+//   * Non-Blink battery consumers keep reading the same answer as pages.
+//
+// REPLACES, never merges. A configured tuple supplies all four fields and the
+// host's are dropped, because a mix is the incoherence the atomic parse exists
+// to prevent: the host's `discharging_time` under a configured `charging` is a
+// battery filling and emptying at once.
+mojom::BatteryStatus ApplyBatteryPersona(const mojom::BatteryStatus& status);
+
+}  // namespace device::xrio
+
+#endif  // SERVICES_DEVICE_BATTERY_XRIO_BATTERY_PERSONA_H_
diff --git a/services/device/battery/xrio_battery_status_unittest.cc b/services/device/battery/xrio_battery_status_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..a99f23323ea0bea018f480c76290655cc0aebbd7
--- /dev/null
+++ b/services/device/battery/xrio_battery_status_unittest.cc
@@ -0,0 +1,423 @@
+// The `battery-status` knob at the seam it is hooked at, plus the Mojo hop that
+// carries the result to a renderer.
+//
+// WHY A SEPARATE FILE rather than hunks in battery_status_service_unittest.cc
+// and battery_monitor_impl_unittest.cc. patches/README.md: a patch may insert a
+// hook and nothing else, because logic in a patch is what makes a rebase
+// expensive -- and a test is logic. This file is an OVERLAY (chromium_src/,
+// symlinked into src/) and reaches the build through a two-line addition to
+// services/device/BUILD.gn's `tests` source list, which is the same mechanism
+// base/BUILD.gn already uses for xrio_persona_unittest.cc.
+//
+// base/xrio_persona_unittest.cc covers the PARSER: which tuples are coherent,
+// what an operator's typo does, that the read fails closed. Nothing is repeated
+// here. What this file answers is the part a parser test cannot:
+//
+//   * an unconfigured build is upstream, byte for byte;
+//   * the transformation happens BEFORE the service's cache, so a late
+//     subscriber is handed the same value as the first one;
+//   * a raw host update cannot change what a consumer sees while the tuple is
+//     fixed -- the property the whole experiment depends on, because a level
+//     that moved mid-render would be a second variable;
+//   * all four fields survive the Mojo hop, and a second query is coherent
+//     with the first.
+//
+// The EVENT-level half of suppression is Blink's and is NOT ASSERTED ANYWHERE,
+// deliberately. BatteryMonitorImpl::DidChange reports whatever it is handed,
+// changed or not, and it is blink::BatteryManager::DidUpdateData that compares
+// old against new and decides which change events to fire. Because the
+// comparison runs on transformed values, an unchanged value fires nothing --
+// but that last step is upstream's own comparison, and the fork's contribution
+// to it is the unchanged VALUE, which is what
+// RawHostUpdatesCannotChangeWhatIsSeen below covers.
+//
+// There is no content browsertest and that is a decision, not an omission:
+// content_shell cannot inject a battery backend without widening
+// //services/device/battery's GN visibility, so navigator.getBattery() there
+// resolves only if the host's own dbus/UPower answers -- a test that passes
+// when nothing happened. tools/battery_probe.py measures the JS-visible side on
+// the real binary instead. See fork/not-implemented.md section J.
+
+#include "services/device/battery/xrio_battery_persona.h"
+
+#include <limits>
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/memory/raw_ptr.h"
+#include "base/xrio_config.h"
+#include "base/run_loop.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/test/task_environment.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "services/device/battery/battery_status_manager.h"
+#include "services/device/battery/battery_status_service.h"
+#include "services/device/device_service_test_base.h"
+#include "services/device/public/mojom/battery_monitor.mojom.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace device {
+namespace {
+
+constexpr double kInfinity = std::numeric_limits<double>::infinity();
+
+// A discharging laptop at 71%, ~11.9 hours from empty. The tuple from the
+// implementation plan, so the arms this file describes and the arms the campaign
+// runs are the same numbers.
+constexpr char kTuple[] =
+    R"json({"charging": false, "level": 0.71,
+            "charging_time": "Infinity", "discharging_time": 42960})json";
+
+// Charging with a finite discharging time: a battery filling and emptying at
+// once. ValidateConfig refuses this launch in the browser; here it stands for
+// "a map was published without that check", which is every unit test and every
+// content_shell.
+constexpr char kIncoherentTuple[] =
+    R"json({"charging": true, "level": 0.5,
+            "charging_time": 600, "discharging_time": 900})json";
+
+void Configure(const char* tuple) {
+  base::XrioConfig::Map map;
+  if (tuple) {
+    map.insert_or_assign("battery-status", tuple);
+  }
+  base::XrioConfig::Get().SetAll(std::move(map));
+}
+
+mojom::BatteryStatus HostStatus(bool charging,
+                                double charging_time,
+                                double discharging_time,
+                                double level) {
+  mojom::BatteryStatus status;
+  status.charging = charging;
+  status.charging_time = charging_time;
+  status.discharging_time = discharging_time;
+  status.level = level;
+  return status;
+}
+
+void ExpectTuple(const mojom::BatteryStatus& status) {
+  EXPECT_FALSE(status.charging);
+  EXPECT_EQ(0.71, status.level);
+  EXPECT_EQ(kInfinity, status.charging_time);
+  EXPECT_EQ(42960.0, status.discharging_time);
+}
+
+// The same shape as upstream's FakeBatteryManager, kept local: upstream's lives
+// inside its own .cc and there is no header to reuse.
+//
+// `notify_on_start_` is off by default and that is deliberate. The service tests
+// below COUNT notifications, so a status pushed from
+// StartListeningBatteryChange() would arrive before the test had asked for
+// anything. Upstream's fake does notify on start, and the Mojo test needs that
+// behaviour for a different reason: BindBatteryMonitor is asynchronous, so a
+// status pushed before the BatteryMonitorImpl exists is dropped and the first
+// QueryNextStatus would then wait forever. Both orders are needed; which one a
+// fixture wants is a flag rather than two fakes.
+class FakeBatteryManager : public BatteryStatusManager {
+ public:
+  explicit FakeBatteryManager(
+      const BatteryStatusService::BatteryUpdateCallback& callback)
+      : callback_(callback) {}
+
+  FakeBatteryManager(const FakeBatteryManager&) = delete;
+  FakeBatteryManager& operator=(const FakeBatteryManager&) = delete;
+
+  ~FakeBatteryManager() override = default;
+
+  bool StartListeningBatteryChange() override {
+    started_ = true;
+    if (notify_on_start_ && available_) {
+      // Asynchronously, the way the OS-specific managers deliver.
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(callback_, status_));
+    }
+    return available_;
+  }
+  void StopListeningBatteryChange() override {}
+
+  void InvokeUpdateCallback(const mojom::BatteryStatus& status) {
+    status_ = status;
+    callback_.Run(status);
+  }
+
+  void set_available(bool value) { available_ = value; }
+  void set_status(const mojom::BatteryStatus& status) { status_ = status; }
+  void set_notify_on_start(bool value) { notify_on_start_ = value; }
+  bool started() const { return started_; }
+
+ private:
+  BatteryStatusService::BatteryUpdateCallback callback_;
+  mojom::BatteryStatus status_;
+  bool available_ = true;
+  bool started_ = false;
+  bool notify_on_start_ = false;
+};
+
+// ---------------------------------------------------------------------------
+// The service seam.
+
+class XrioBatteryStatusServiceTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    Configure(nullptr);
+    auto manager = std::make_unique<FakeBatteryManager>(
+        service_.GetUpdateCallbackForTesting());
+    manager_ = manager.get();
+    service_.SetBatteryManagerForTesting(std::move(manager));
+  }
+
+  void TearDown() override {
+    base::RunLoop().RunUntilIdle();
+    // Process-global, so leaving it set would configure every test that runs
+    // after this one in the same binary.
+    Configure(nullptr);
+  }
+
+  base::CallbackListSubscription Subscribe(mojom::BatteryStatus* seen,
+                                           int* count) {
+    return service_.AddCallback(base::BindRepeating(
+        [](mojom::BatteryStatus* seen, int* count,
+           const mojom::BatteryStatus& status) {
+          *seen = status;
+          ++*count;
+        },
+        seen, count));
+  }
+
+  void PushHostStatus(const mojom::BatteryStatus& status) {
+    manager_->InvokeUpdateCallback(status);
+    base::RunLoop().RunUntilIdle();
+  }
+
+  base::test::SingleThreadTaskEnvironment task_environment_;
+  BatteryStatusService service_;
+  raw_ptr<FakeBatteryManager> manager_ = nullptr;
+};
+
+// The shipped state. Absent knob, host value through untouched -- and asserted
+// field by field, because "no crash" is not the claim.
+TEST_F(XrioBatteryStatusServiceTest, AbsentKnobIsUpstream) {
+  mojom::BatteryStatus seen;
+  int count = 0;
+  base::CallbackListSubscription subscription = Subscribe(&seen, &count);
+  PushHostStatus(HostStatus(true, 120.0, kInfinity, 0.33));
+  ASSERT_EQ(1, count);
+  EXPECT_TRUE(seen.charging);
+  EXPECT_EQ(120.0, seen.charging_time);
+  EXPECT_EQ(kInfinity, seen.discharging_time);
+  EXPECT_EQ(0.33, seen.level);
+}
+
+TEST_F(XrioBatteryStatusServiceTest, AConfiguredTupleReplacesTheHostStatus) {
+  Configure(kTuple);
+  mojom::BatteryStatus seen;
+  int count = 0;
+  base::CallbackListSubscription subscription = Subscribe(&seen, &count);
+  PushHostStatus(HostStatus(true, 120.0, kInfinity, 0.33));
+  ASSERT_EQ(1, count);
+  ExpectTuple(seen);
+}
+
+// REPLACES rather than merges: no field of the host's survives. A mix is the
+// incoherence the atomic parse exists to prevent.
+TEST_F(XrioBatteryStatusServiceTest, NoHostFieldSurvives) {
+  Configure(kTuple);
+  mojom::BatteryStatus seen;
+  int count = 0;
+  base::CallbackListSubscription subscription = Subscribe(&seen, &count);
+  PushHostStatus(HostStatus(true, 7.0, 9.0, 0.02));
+  ASSERT_EQ(1, count);
+  EXPECT_NE(7.0, seen.charging_time);
+  EXPECT_NE(9.0, seen.discharging_time);
+  EXPECT_NE(0.02, seen.level);
+  ExpectTuple(seen);
+}
+
+// The reason the hook is above the cache. status_ is what AddCallback hands a
+// consumer that subscribes after the first update; transforming after the cache
+// would leave it holding the host's value.
+TEST_F(XrioBatteryStatusServiceTest, ALateSubscriberIsHandedTheSameTuple) {
+  Configure(kTuple);
+  mojom::BatteryStatus first;
+  int first_count = 0;
+  base::CallbackListSubscription subscription = Subscribe(&first, &first_count);
+  PushHostStatus(HostStatus(true, 120.0, kInfinity, 0.33));
+  ASSERT_EQ(1, first_count);
+
+  mojom::BatteryStatus late;
+  int late_count = 0;
+  base::CallbackListSubscription late_subscription = Subscribe(&late, &late_count);
+  ASSERT_EQ(1, late_count) << "a late subscriber must get the cached status";
+  ExpectTuple(late);
+  EXPECT_EQ(first.level, late.level);
+}
+
+TEST_F(XrioBatteryStatusServiceTest, TwoSubscribersAgree) {
+  Configure(kTuple);
+  mojom::BatteryStatus one, two;
+  int one_count = 0, two_count = 0;
+  base::CallbackListSubscription s1 = Subscribe(&one, &one_count);
+  base::CallbackListSubscription s2 = Subscribe(&two, &two_count);
+  PushHostStatus(HostStatus(true, 120.0, kInfinity, 0.33));
+  ASSERT_EQ(1, one_count);
+  ASSERT_EQ(1, two_count);
+  ExpectTuple(one);
+  ExpectTuple(two);
+}
+
+// THE PROPERTY THE EXPERIMENT DEPENDS ON. A real laptop being unplugged, or
+// UPower's periodic re-read, must not move what a page sees -- a level that
+// changed mid-render would be a second variable in an arm that is meant to
+// differ from its control in exactly one thing.
+TEST_F(XrioBatteryStatusServiceTest, RawHostUpdatesCannotChangeWhatIsSeen) {
+  Configure(kTuple);
+  mojom::BatteryStatus seen;
+  int count = 0;
+  base::CallbackListSubscription subscription = Subscribe(&seen, &count);
+
+  PushHostStatus(HostStatus(true, 120.0, kInfinity, 0.33));
+  ASSERT_EQ(1, count);
+  const mojom::BatteryStatus after_first = seen;
+
+  // Unplugged, and then nearly empty.
+  PushHostStatus(HostStatus(false, kInfinity, 900.0, 0.31));
+  PushHostStatus(HostStatus(false, kInfinity, 60.0, 0.05));
+  EXPECT_EQ(3, count) << "the notifications still arrive; their VALUE is fixed";
+  EXPECT_EQ(after_first.charging, seen.charging);
+  EXPECT_EQ(after_first.charging_time, seen.charging_time);
+  EXPECT_EQ(after_first.discharging_time, seen.discharging_time);
+  EXPECT_EQ(after_first.level, seen.level);
+  ExpectTuple(seen);
+}
+
+// The AddCallback failure path: the backend could not start, so the service
+// hands out mojom::BatteryStatus()'s defaults directly rather than through a
+// notification. NOT the Linux batteryless path --
+// BatteryStatusManagerLinux::StartListeningBatteryChange() returns true
+// unconditionally and an unreadable UPower sends the default tuple through the
+// normal path -- this is Windows and macOS behaviour, hooked so the two ways a
+// consumer can be handed a status cannot disagree.
+TEST_F(XrioBatteryStatusServiceTest, TheBackendFailurePathIsTransformedToo) {
+  Configure(kTuple);
+  manager_->set_available(false);
+  mojom::BatteryStatus seen;
+  int count = 0;
+  base::CallbackListSubscription subscription = Subscribe(&seen, &count);
+  ASSERT_TRUE(manager_->started());
+  ASSERT_EQ(1, count) << "the failure path runs the callback synchronously";
+  ExpectTuple(seen);
+}
+
+// Same path, unconfigured: upstream's own defaults, which is the value the
+// no-battery answer is made of (charging, full, 0 to full, Infinity to empty).
+TEST_F(XrioBatteryStatusServiceTest, TheBackendFailurePathIsUpstreamWhenAbsent) {
+  manager_->set_available(false);
+  mojom::BatteryStatus seen;
+  int count = 0;
+  base::CallbackListSubscription subscription = Subscribe(&seen, &count);
+  ASSERT_EQ(1, count);
+  EXPECT_TRUE(seen.charging);
+  EXPECT_EQ(0.0, seen.charging_time);
+  EXPECT_EQ(kInfinity, seen.discharging_time);
+  EXPECT_EQ(1.0, seen.level);
+}
+
+// FAILS CLOSED at the seam as well as at the accessor. ValidateConfig refuses
+// this launch in the browser; nothing does in a test binary or a content_shell,
+// and there the host's own answer is the safe one.
+TEST_F(XrioBatteryStatusServiceTest, AnIncoherentTupleLeavesTheHostAlone) {
+  Configure(kIncoherentTuple);
+  mojom::BatteryStatus seen;
+  int count = 0;
+  base::CallbackListSubscription subscription = Subscribe(&seen, &count);
+  PushHostStatus(HostStatus(true, 120.0, kInfinity, 0.33));
+  ASSERT_EQ(1, count);
+  EXPECT_TRUE(seen.charging);
+  EXPECT_EQ(120.0, seen.charging_time);
+  EXPECT_EQ(0.33, seen.level);
+}
+
+// ---------------------------------------------------------------------------
+// The Mojo hop. Same question one layer up: does the tuple reach a consumer
+// that talks to the service over a pipe, with all four fields intact.
+
+void ExpectTupleOverMojo(bool* called,
+                         base::OnceClosure quit,
+                         mojom::BatteryStatusPtr status) {
+  if (called) {
+    *called = true;
+  }
+  EXPECT_FALSE(status->charging);
+  EXPECT_EQ(0.71, status->level);
+  EXPECT_EQ(kInfinity, status->charging_time);
+  EXPECT_EQ(42960.0, status->discharging_time);
+  std::move(quit).Run();
+}
+
+class XrioBatteryMonitorTest : public DeviceServiceTestBase {
+ protected:
+  void SetUp() override {
+    DeviceServiceTestBase::SetUp();
+    Configure(kTuple);
+    BatteryStatusService* service = BatteryStatusService::GetInstance();
+    auto manager = std::make_unique<FakeBatteryManager>(
+        service->GetUpdateCallbackForTesting());
+    manager_ = manager.get();
+    service->SetBatteryManagerForTesting(std::move(manager));
+    // The host status and the notify-on-start behaviour must both be in place
+    // BEFORE the bind: BindBatteryMonitor is asynchronous, so anything pushed
+    // before the impl exists is dropped and the first query would never
+    // resolve. This is why upstream's fake notifies from start.
+    manager_->set_status(HostStatus(true, 120.0, kInfinity, 0.33));
+    manager_->set_notify_on_start(true);
+    device_service()->BindBatteryMonitor(
+        monitor_.BindNewPipeAndPassReceiver());
+  }
+
+  void TearDown() override {
+    monitor_.reset();
+    // BatteryMonitorImpl must detach from the singleton before the service is
+    // shut down; upstream's own test does the same.
+    base::RunLoop().RunUntilIdle();
+    Configure(nullptr);
+  }
+
+  raw_ptr<FakeBatteryManager> manager_ = nullptr;
+  mojo::Remote<mojom::BatteryMonitor> monitor_;
+};
+
+TEST_F(XrioBatteryMonitorTest, AllFourFieldsSurviveThePipe) {
+  base::RunLoop loop;
+  monitor_->QueryNextStatus(
+      base::BindOnce(&ExpectTupleOverMojo, nullptr, loop.QuitClosure()));
+  loop.Run();
+}
+
+// A second query is COHERENT with the first: the same tuple, not a half-applied
+// one and not the host's. It pends until an update arrives, which is upstream's
+// contract for QueryNextStatus -- so this also proves a host update that
+// changes every raw field still delivers the configured value.
+TEST_F(XrioBatteryMonitorTest, ASecondQueryIsCoherentWithTheFirst) {
+  base::RunLoop first;
+  monitor_->QueryNextStatus(
+      base::BindOnce(&ExpectTupleOverMojo, nullptr, first.QuitClosure()));
+  first.Run();
+
+  bool called = false;
+  base::RunLoop second;
+  monitor_->QueryNextStatus(
+      base::BindOnce(&ExpectTupleOverMojo, &called, second.QuitClosure()));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(called) << "QueryNextStatus waits for the next update";
+
+  manager_->InvokeUpdateCallback(HostStatus(false, kInfinity, 60.0, 0.05));
+  second.Run();
+  EXPECT_TRUE(called);
+}
+
+}  // namespace
+}  // namespace device
diff --git a/third_party/blink/renderer/core/dom/xrio_geometry.h b/third_party/blink/renderer/core/dom/xrio_geometry.h
new file mode 100644
index 0000000000000000000000000000000000000000..e6a62482fa06c692ec63091d09f5413bc2b18c1e
--- /dev/null
+++ b/third_party/blink/renderer/core/dom/xrio_geometry.h
@@ -0,0 +1,56 @@
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_DOM_XRIO_GEOMETRY_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_DOM_XRIO_GEOMETRY_H_
+
+#include <cstdint>
+#include <optional>
+
+#include "base/xrio_knobs.h"
+#include "base/xrio_perturb.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/geometry/size_f.h"
+
+namespace blink::xrio {
+
+// Nudges a rect's SIZE by a fraction of a pixel, leaving its position alone.
+//
+// Position is untouched on purpose. getBoundingClientRect() and getClientRects()
+// both derive from Element::ClientQuads, and both are read after scrolling; a
+// rect whose width changes when the page scrolls is a stronger signal than a
+// constant one. Bromite noises each coordinate independently and has exactly
+// that bug, which is why catalog §1 #37 marks it AVOID and §3 #90 marks
+// Fortress's scroll-invariant version TAKE. Keying on the value and moving only
+// the size gets the same property without tracking corners relative to p1.
+//
+// Position is a knob (`jitter-geometry-position`) and it DEFAULTS OFF, which is
+// the only defensible default: turning it on is opting into the measured Bromite
+// defect above, not enabling a feature. It is a knob at all so that "what does
+// it actually cost" can be answered by a launch rather than by a five-hour
+// rebuild -- and whoever turns it on should expect the rect to move on scroll.
+//
+// No-op unless BOTH --xrio-seed and --xrio-jitter-geometry are set. See
+// base::xrio::GeometrySeed() for why this one is opted into separately.
+inline void JitterRectSize(gfx::RectF* rect) {
+  if (!rect) {
+    return;
+  }
+  const std::optional<uint64_t> seed = base::xrio::GeometrySeed();
+  if (!seed.has_value()) {
+    return;
+  }
+  rect->set_size(gfx::SizeF(
+      static_cast<float>(base::xrio::JitterDimension(rect->width(),
+                                                    seed.value())),
+      static_cast<float>(base::xrio::JitterDimension(rect->height(),
+                                                    seed.value()))));
+  if (!base::xrio::GetBool("jitter-geometry-position")) {
+    return;
+  }
+  rect->set_origin(gfx::PointF(
+      static_cast<float>(base::xrio::JitterDimension(rect->x(), seed.value())),
+      static_cast<float>(base::xrio::JitterDimension(rect->y(), seed.value()))));
+}
+
+}  // namespace blink::xrio
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_DOM_XRIO_GEOMETRY_H_
diff --git a/third_party/blink/renderer/modules/media_capabilities/xrio_media_persona.h b/third_party/blink/renderer/modules/media_capabilities/xrio_media_persona.h
