+// A one-row machine-class table THIS host can support, optionally naming a
+// chassis.
+std::string HostRow(std::string_view chassis = {}) {
+  std::string row = StrCat({"[[", NumberToString(HostThreadCeiling()),
+                            ",16,250,1"});
+  if (!chassis.empty()) {
+    row = StrCat({row, ",\"", chassis, "\""});
+  }
+  return StrCat({row, "]]"});
+}
+
+// ---------------------------------------------------------------------------
+// Registry hygiene. These run over the whole table, so a row added later is
+// checked without anyone remembering to add a test -- which is the only kind of
+// coverage guarantee worth having in a file whose whole purpose is to stop
+// knobs that read as working while doing nothing.
+
+TEST_F(XrioKnobsTest, RegistryIsSortedAndUnique) {
+  std::string previous;
+  std::set<std::string_view> seen;
+  for (const Knob& knob : Knobs()) {
+    EXPECT_FALSE(knob.key.empty());
+    EXPECT_LT(previous, std::string(knob.key))
+        << "kKnobs must stay sorted by key; '" << knob.key << "' is out of "
+        << "order after '" << previous << "'";
+    EXPECT_TRUE(seen.insert(knob.key).second)
+        << "duplicate key '" << knob.key << "'";
+    previous = std::string(knob.key);
+    EXPECT_FALSE(knob.doc.empty())
+        << knob.key << " has no doc, and --xrio-dump-config prints it";
+  }
+  EXPECT_FALSE(Knobs().empty());
+}
+
+// A default that does not parse as its own type, or that its own constraint
+// refuses, is a knob nobody can read correctly. This catches it at test time
+// rather than at CHECK time on a render host.
+TEST_F(XrioKnobsTest, EveryDefaultIsValidForItsOwnType) {
+  XrioConfig::Get().SetAll({});
+  for (const Knob& knob : Knobs()) {
+    if (knob.type == KnobType::kDerived || knob.default_value.empty()) {
+      continue;
+    }
+    if (knob.default_value.front() == '@') {
+      const Knob* parent = FindKnob(knob.default_value.substr(1));
+      ASSERT_NE(nullptr, parent)
+          << knob.key << " defers to a key that does not exist";
+      EXPECT_EQ(static_cast<int>(knob.type), static_cast<int>(parent->type))
+          << knob.key << " defers to '" << parent->key
+          << "', which is a different type -- the value would not parse";
+      continue;
+    }
+    XrioConfig::Map one = {{std::string(knob.key),
+                           std::string(knob.default_value)}};
+    std::string error;
+    EXPECT_TRUE(ValidateConfig(one, &error))
+        << knob.key << "'s own default is refused by validation: " << error;
+  }
+}
+
+// Every umbrella chain terminates. Effective() CHECKs on a cycle, so a bad row
+// would abort a browser at startup rather than fail here -- but only if someone
+// ran it. This runs it.
+TEST_F(XrioKnobsTest, EveryKnobResolvesWithoutACycle) {
+  XrioConfig::Get().SetAll({});
+  for (const Knob& knob : Knobs()) {
+    if (knob.type == KnobType::kDerived) {
+      continue;
+    }
+    switch (knob.type) {
+      case KnobType::kBool:
+        (void)GetBool(knob.key);
+        break;
+      case KnobType::kInt:
+        (void)GetOptionalInt(knob.key);
+        break;
+      case KnobType::kDouble:
+        (void)GetOptionalDouble(knob.key);
+        break;
+      default:
+        (void)GetString(knob.key);
+        break;
+    }
+  }
+}
