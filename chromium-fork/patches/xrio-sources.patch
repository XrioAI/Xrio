new file mode 100644
index 0000000000000000000000000000000000000000..bf913c320f310b961cb449324f866e520065f0ea
--- /dev/null
+++ b/base/xrio_perturb.cc
@@ -0,0 +1,270 @@
+#include "base/xrio_perturb.h"
+
+#include <atomic>
+#include <cmath>
+
+#include "base/numerics/checked_math.h"
+#include "base/no_destructor.h"
+#include "base/xrio_config.h"
+#include "base/xrio_knobs.h"
+
+namespace base::xrio {
+
+namespace {
+
+// murmur3's 64-bit finalizer. Chosen because it avalanches well on tiny inputs
+// -- adjacent pixels must not produce correlated decisions, or the perturbation
+// forms a visible or measurable lattice.
+//
+// The three constants are knobs (hash-shift, hash-mix-1, hash-mix-2) so that
+// revising them does not cost a five-hour rebuild, but they are ALGORITHM
+// constants and not tuning: changing one changes every seeded value this fork
+// produces, so a capture taken under different constants is not comparable to
+// one taken under these. --xrio-dump-config records them for exactly that
+// reason. The tuning is passed in rather than read here because this runs once
+// per pixel; the caller hoists it.
+uint64_t Fmix64(uint64_t k, const PerturbTuning& tuning) {
+  k ^= k >> tuning.hash_shift;
+  k *= tuning.hash_mix_1;
+  k ^= k >> tuning.hash_shift;
+  k *= tuning.hash_mix_2;
+  k ^= k >> tuning.hash_shift;
+  return k;
+}
+
+// The pixel selection rate, the bit that moves, and the residue class selected
+// all live in the registry now (pixel-rate-mask, pixel-bit-mask,
+// pixel-rate-phase). The default mask of 0x7 is roughly one pixel in eight:
+// sparse enough to stay invisible and to avoid the flat-region LSB-noise
+// signature, dense enough that any canvas big enough to carry fingerprint
+// entropy gets hundreds of flipped bits. A typical fingerprint canvas is 200x50
+// or larger, so ~1250 pixels move.
+//
+// The tradeoff that rate makes, and it survives becoming a knob: a canvas below
+// ~100 pixels may get no flip at all and keep its constant hash. Accepted
+// deliberately -- a canvas that small carries almost no entropy to join on, and
+// the alternative (force at least one flip per buffer) would break the sub-rect
+// coherence property, because a partial read and a whole-canvas read would then
+// flip different pixels.
+
+}  // namespace
+
+std::optional<uint64_t> Seed(std::string_view purpose) {
+  std::optional<uint64_t> master = XrioConfig::Get().GetSeed("seed");
+  if (!master.has_value()) {
+    return std::nullopt;
+  }
+  const PerturbTuning& tuning = Tuning();
+  // FNV-1a over the purpose, then avalanche together with the master. Cheap and
+  // there is nothing adversarial to defend here -- the requirement is only that
+  // two purposes give uncorrelated streams from one operator-visible value.
+  uint64_t tag = tuning.seed_tag_basis;
+  for (char ch : purpose) {
+    tag ^= static_cast<uint8_t>(ch);
+    tag *= tuning.seed_tag_prime;
+  }
+  uint64_t derived = Fmix64(master.value() ^ tag, tuning);
+  // Zero would read as "unset" everywhere downstream. Astronomically unlikely,
+  // and silently disabling a surface is the wrong way to find that out.
+  return derived == 0 ? tuning.seed_zero_substitute : derived;
+}
+
+namespace {
+
+// Caches one purpose's sub-seed against XrioConfig's generation counter. The
+// config changes at most once per process, so after the first call this costs a
+// single atomic load instead of two mutex acquisitions -- which matters because
+// JitterRectSize runs on every getBoundingClientRect, thousands of times a frame
+// on a layout-thrashing page.
+//
+// Plain function-local statics rather than base::NoDestructor: that class
+// static_asserts AGAINST trivially-destructible types ("please use a
+// function-local static of type T directly instead"), and a pair of atomics is
+// exactly that. Atomics with constant initialisers also mean no dynamic
+// initialisation and no exit-time destructor, which -Wglobal-constructors and
+// -Wexit-time-destructors both care about.
+//
+// The race is benign by construction: two threads arriving on a cold cache
+// compute the same value from the same inputs, so whichever store lands last is
+// identical to the other. Nothing can observe a torn pair, because the
+// generation is published with release only after the seed is stored.
+std::optional<uint64_t> CachedSeed(std::string_view purpose_key,
+                                   bool require_opt_in,
+                                   std::atomic<uint32_t>& cached_generation,
+                                   std::atomic<uint64_t>& cached_seed) {
+  const uint32_t generation = XrioConfig::Get().generation();
+  if (cached_generation.load(std::memory_order_acquire) == generation) {
+    const uint64_t cached = cached_seed.load(std::memory_order_relaxed);
+    return cached == 0 ? std::nullopt : std::optional<uint64_t>(cached);
+  }
+  std::optional<uint64_t> fresh;
+  // GetBool, not Has: the presence-only read this replaces meant
+  // `--xrio-jitter-geometry=false` ENABLED geometry jitter, which is the same
+  // class of defect as a knob that reads as working while doing nothing. A bare
+  // valueless switch still reads as true, so no existing launch changes.
+  if (!require_opt_in || GetBool("jitter-geometry")) {
+    fresh = Seed(GetString(purpose_key));
+  }
+  cached_seed.store(fresh.value_or(0), std::memory_order_relaxed);
+  cached_generation.store(generation, std::memory_order_release);
+  return fresh;
+}
+
+}  // namespace
+
+std::optional<uint64_t> CanvasSeed() {
+  // UINT32_MAX is a generation no real counter holds, so the first call always
+  // misses rather than reporting a cached absence.
+  static std::atomic<uint32_t> generation{UINT32_MAX};
+  static std::atomic<uint64_t> seed{0};
+  return CachedSeed("seed-purpose-canvas", /*require_opt_in=*/false, generation,
+                    seed);
+}
+
+std::optional<uint64_t> GeometrySeed() {
+  static std::atomic<uint32_t> generation{UINT32_MAX};
+  static std::atomic<uint64_t> seed{0};
+  return CachedSeed("seed-purpose-geometry", /*require_opt_in=*/true, generation,
+                    seed);
+}
+
+std::optional<uint64_t> AudioSeed() {
+  return Seed(GetString("seed-purpose-audio"));
+}
+
+void ScaleAudioChannel(span<float> samples, unsigned channel_index) {
+  std::optional<uint64_t> seed = AudioSeed();
+  if (!seed.has_value() || samples.empty()) {
+    return;
+  }
+  const PerturbTuning& tuning = Tuning();
+  // Per channel, so a stereo buffer's two channels do not move in lockstep.
+  const uint64_t h = Fmix64(seed.value() ^ (static_cast<uint64_t>(channel_index)
+                                            * tuning.audio_channel_mixer),
+                            tuning);
+  // [floor, floor + span), which defaults to [0.9990, 1.0000): inaudible, well
+  // inside float precision, and enough to move both the readback hash and the
+  // summed magnitude audio fingerprints compare.
+  //
+  // DIVIDE BY THE RECIPROCAL, do not multiply by the span. The expression this
+  // replaces was `0.999 + (h >> 11) / 2^53 / 1000.0`, and multiplying by 0.001
+  // is NOT the same double: measured over 500k seeds, `u * 0.001` disagrees
+  // with `u / 1000.0` on 7 of them, by 1.1e-16. That is far below float32's
+  // 6.0e-08 eps and so almost never survives the cast back to a sample -- but
+  // "almost never" would still have moved some render's audio hash off the
+  // value a reference capture recorded, for no reason at all. `1.0 / 0.001` is
+  // exactly 1000.0, so this form is bit-identical at the default. A span of 0
+  // gives an infinite divisor and therefore exactly the floor, which is the
+  // right reading of "no variation".
+  const double scale =
+      tuning.audio_scale_floor +
+      static_cast<double>(h >> 11) / static_cast<double>(UINT64_C(1) << 53) /
+          (1.0 / tuning.audio_scale_span);
+  for (float& sample : samples) {
+    sample = static_cast<float>(static_cast<double>(sample) * scale);
+  }
+}
+
+double JitterDimension(double value, uint64_t seed) {
+  if (!std::isfinite(value) || value == 0.0) {
+    return value;
+  }
+  const PerturbTuning& tuning = Tuning();
+  if (tuning.jitter_steps < 1 || !(tuning.jitter_quantum > 0.0) ||
+      !(tuning.jitter_step_size > 0.0)) {
+    // Validation refuses these at launch, so this is unreachable in a real
+    // browser. Unchanged is still the right answer for a unit test that
+    // installed a map directly: never a guessed offset.
+    return value;
+  }
+  // Quantise to 1/quantum px before keying, so two reads of a value that differs
+  // only in float noise still land on the same jitter.
+  const int64_t quantised =
+      static_cast<int64_t>(std::llround(value * tuning.jitter_quantum));
+  const uint64_t h = Fmix64(seed ^ static_cast<uint64_t>(quantised), tuning);
+  // One of `steps` offsets centred on zero, in 1/step_size px. The defaults (41
+  // steps, 1/1024 px) give +-0.02 px: below the threshold where any layout
+  // consumer cares, above the threshold where a hash notices.
+  //
+  // Identical to the `(h % 41 - 20.0) / 1024.0` it replaces -- the centring term
+  // was (steps - 1) / 2 written out, and is derived here rather than keyed so
+  // the two can never disagree and bias every dimension one way.
+  const uint64_t steps = static_cast<uint64_t>(tuning.jitter_steps);
+  const double centre = static_cast<double>(tuning.jitter_steps - 1) / 2.0;
+  const double offset =
+      (static_cast<double>(h % steps) - centre) / tuning.jitter_step_size;
+  return value + offset;
+}
+
+void PerturbPixels(span<uint8_t> pixels,
+                   size_t row_bytes,
+                   int width,
+                   int height,
+                   int bytes_per_pixel,
+                   int origin_x,
+                   int origin_y,
+                   uint64_t seed,
+                   std::array<uint8_t, 3> skip_colour) {
+  if (bytes_per_pixel != 4 || width <= 0 || height <= 0) {
+    return;
+  }
+
+  // Hoisted once per buffer, never per pixel: the inner loop below runs for
+  // every pixel of every readback, and a flat_map lookup plus a strtod there
+  // would be a real cost. Hoisting also makes the whole buffer coherent -- the
+  // rate cannot move between two rows of one image.
+  const PerturbTuning& tuning = Tuning();
+
+  // Refuse rather than clamp. A buffer that does not hold what its geometry
+  // claims means an assumption here is wrong, and writing into it on a guess is
+  // how a fingerprint patch becomes a memory-safety bug. subspan() would CHECK
+  // rather than corrupt, but a crash is not the behaviour we want either.
+  const size_t row_pixel_bytes = static_cast<size_t>(width) * 4u;
+  CheckedNumeric<size_t> required =
+      CheckedNumeric<size_t>(row_bytes) * static_cast<size_t>(height - 1);
+  required += row_pixel_bytes;
+  size_t required_bytes = 0;
+  if (!required.AssignIfValid(&required_bytes) ||
+      required_bytes > pixels.size()) {
+    return;
+  }
+
+  for (int row = 0; row < height; ++row) {
+    // Bounds-checked, and padding past row_pixel_bytes is never in the span we
+    // hand the inner loop, so it cannot be written.
+    span<uint8_t> scanline = pixels.subspan(
+        static_cast<size_t>(row) * row_bytes, row_pixel_bytes);
+    const uint64_t y =
+        static_cast<uint64_t>(static_cast<uint32_t>(origin_y + row));
+    for (int column = 0; column < width; ++column) {
+      const uint64_t x =
+          static_cast<uint64_t>(static_cast<uint32_t>(origin_x + column));
+      // Absolute coordinates only. Using the offset into this buffer instead
+      // would make a sub-rect read disagree with a whole-canvas read.
+      const uint64_t h =
+          Fmix64(seed ^ (x * tuning.coord_mixer) ^ (y << 32), tuning);
+      if ((h & tuning.pixel_rate_mask) != tuning.pixel_rate_phase) {
+        continue;
+      }
+      // One of the three colour bytes; the fourth is alpha under both RGBA and
+      // BGRA and is never touched, so a transparent pixel stays transparent.
+      span<uint8_t> pixel =
+          scanline.subspan(static_cast<size_t>(column) * 4u, 4u);
+      // A CLEARED pixel is left exactly as it was found -- see the header for
+      // why this is a value test rather than a neighbourhood test, and why the
+      // caller supplies the colour instead of it being hardcoded black.
+      //
+      // Three colour bytes, never alpha: a transparent pixel that is not the
+      // skip colour still moves, and alpha is never written either way.
+      if (pixel[0] == skip_colour[0] && pixel[1] == skip_colour[1] &&
+          pixel[2] == skip_colour[2]) {
+        continue;
+      }
+      // Shifted past the bits the rate decision consumed, or the two would
+      // correlate and only one channel would ever move.
+      pixel[(h >> tuning.channel_shift) % 3] ^= tuning.pixel_bit_mask;
+    }
+  }
+}
+
+}  // namespace base::xrio
