@@ -0,0 +1,56 @@
+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_MEDIA_CAPABILITIES_XRIO_MEDIA_PERSONA_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_MEDIA_CAPABILITIES_XRIO_MEDIA_PERSONA_H_
+
+#include "base/xrio_media_table.h"
+#include "media/base/video_codecs.h"
+#include "third_party/blink/renderer/bindings/modules/v8/v8_media_capabilities_decoding_info.h"
+
+// Header-only glue between //media's codec enum and the persona table, living
+// on the Blink side because //base cannot name media::VideoCodec: base is a
+// dependency of media, and the reverse edge is a cycle -- the same reason
+// xrio_gl_table.h cannot read version_info. Everything heavy (parsing, caching,
+// gating) is in base::xrio; this file is only the enum translation and the
+// three-setter dance that would otherwise spread across the hook site.
+
+namespace base::xrio {
+
+inline MediaFamily MediaPersonaFamily(media::VideoCodec codec) {
+  switch (codec) {
+    case media::VideoCodec::kH264:
+      return MediaFamily::kH264;
+    case media::VideoCodec::kHEVC:
+      return MediaFamily::kHevc;
+    case media::VideoCodec::kVP8:
+      return MediaFamily::kVp8;
+    case media::VideoCodec::kVP9:
+      return MediaFamily::kVp9;
+    case media::VideoCodec::kAV1:
+      return MediaFamily::kAv1;
+    default:
+      // VC1, MPEG2, MPEG4, Theora, Dolby Vision: no RENOIR-class iGPU decodes
+      // these in Chrome on Linux either, so SwiftShader's honest answer IS the
+      // persona's answer and the table must not speak for them.
+      return MediaFamily::kNone;
+  }
+}
+
+// Overwrites all three answers from the persona when it covers this request's
+// family, or none of them when it does not. The triple moves together or not
+// at all -- see DecodingAnswer in base/xrio_media_table.h.
+inline void ApplyDecodingPersona(MediaFamily family,
+                                 blink::MediaCapabilitiesDecodingInfo* info) {
+  if (family == MediaFamily::kNone) {
+    return;
+  }
+  DecodingAnswer answer{/*supported=*/info->supported(),
+                        /*smooth=*/info->smooth(),
+                        /*power_efficient=*/info->powerEfficient()};
+  ::base::xrio::ApplyMediaPersona(family, &answer);
+  info->setSupported(answer.supported);
+  info->setSmooth(answer.smooth);
+  info->setPowerEfficient(answer.power_efficient);
+}
+
+}  // namespace base::xrio
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_MEDIA_CAPABILITIES_XRIO_MEDIA_PERSONA_H_
