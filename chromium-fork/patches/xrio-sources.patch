+// patches/series has always said the strings, the capability table and the
+// readback perturbation "ship together or not at all". Until this test the code
+// did not: the perturbation was gated on --xrio-seed alone, and
+// `xrio --chrome-path` without `--gl-persona` reached honest SwiftShader
+// strings over non-stock pixels through an ordinary flag combination.
+//
+// TWO GATES BECAME ONE, 2026-09-07. `perturb-gl-readback` and
+// PerturbGlReadbackEnabled() were REMOVED, so the arms that asserted the GL
+// opt-in reached pixels are gone rather than relaxed: there is nothing left for
+// them to assert. The measurement is in fork/readback-perturbation.md -- the
+// hooked readPixels() and the unhooked gl.canvas.toDataURL() disagreed on 378
+// of 11907 channel samples reading ONE framebuffer, a value no driver produces.
+// The canvas2d gate below keeps the property this test was written for: a knob
+// that reaches pixels must not do so without a persona behind it.
+TEST(XrioPersonaTest, ReadbackPerturbationNeedsThePersona) {
+  XrioConfig::Get().SetAll({{"seed", "0x1234"}});
+  EXPECT_FALSE(PerturbCanvasEnabled())
+      << "a seed alone must not perturb pixels under honest GL strings";
+  // Audio makes no claim about a GPU, so it is not persona-gated and stays that
+  // way -- but it is no longer seed-gated ONLY. Its own enable defaults false
+  // as of 2026-09-09, so a seed alone leaves audio exactly as upstream
+  // rendered it, and this arm asserts the seed is not sufficient rather than
+  // that the persona is unnecessary.
+  EXPECT_FALSE(PerturbAudioBuffersEnabled());
+  XrioConfig::Get().SetAll({{"seed", "0x1234"}, {"perturb-audio", "true"}});
+  EXPECT_TRUE(PerturbAudioBuffersEnabled())
+      << "the opt-in must not need a GL persona; audio claims no GPU";
+  EXPECT_FALSE(PerturbCanvasEnabled())
+      << "and it must not carry canvas2d with it";
+
+  XrioConfig::Get().SetAll({{"seed", "0x1234"},
+                           {"gl-persona", kPersona},
+                           {"gl-table", kArtifact}});
+  // Canvas2d ships OFF even with a persona: creepjs writes an 8x8 canvas with
+  // colours it records and diffs the readback, so no mask survives there. So a
+  // persona is NECESSARY and not SUFFICIENT.
+  EXPECT_FALSE(PerturbCanvasEnabled())
+      << "a persona alone must not perturb readback while the default is off";
+  XrioConfig::Get().SetAll({{"seed", "0x1234"},
+                           {"gl-persona", kPersona},
+                           {"gl-table", kArtifact},
+                           {"perturb-canvas", "true"}});
+  EXPECT_TRUE(PerturbCanvasEnabled()) << "the opt-in must still work";
+
+  // The opt-in STILL needs the persona -- which is the property this test
+  // exists for. Turning the knob on without a persona must not reach pixels, or
+  // the flag combination this test was written to close would simply have moved
+  // from the default to the opt-in.
+  XrioConfig::Get().SetAll({{"seed", "0x1234"}, {"perturb-canvas", "true"}});
+  EXPECT_FALSE(PerturbCanvasEnabled())
+      << "the opt-in must not bypass the persona gate";
+  XrioConfig::Get().SetAll({});
+}
