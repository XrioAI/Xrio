+const char* GlRenderer() {
+  const GlTable* table = ActiveGlTable();
+  if (!table) {
+    return nullptr;
+  }
+  if (const char* from_knob = InternedKnobString("gl-renderer")) {
+    return from_knob;
+  }
+  return table->renderer().c_str();
