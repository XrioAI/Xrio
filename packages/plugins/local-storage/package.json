{
  "name": "@xrio/plugin-local-storage",
  "version": "0.0.0",
  "description": "Xrio plugin that saves every finished scrape as a file on disk.",
  "keywords": [
    "scraper",
    "storage",
    "xrio",
    "xrio-plugin"
  ],
  "homepage": "https://github.com/XrioHQ/Xrio#readme",
  "bugs": {
    "url": "https://github.com/XrioHQ/Xrio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XrioHQ/Xrio.git",
    "directory": "packages/plugins/local-storage"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "vp exec tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@xrio/core": "workspace:*",
    "@xrio/typescript-config": "workspace:*",
    "vite-plus": "1.0.0"
  },
  "peerDependencies": {
    "@xrio/core": "workspace:^"
  },
  "engines": {
    "node": ">=22.1.0"
  }
}
