{
  "name": "@xrio/plugin-http-api",
  "version": "0.0.0",
  "description": "Xrio plugin that serves scraping over HTTP (POST /scrape) with Swagger docs.",
  "keywords": [
    "api",
    "http",
    "openapi",
    "scraper",
    "swagger",
    "xrio",
    "xrio-plugin"
  ],
  "homepage": "https://github.com/XrioHQ/Xrio#readme",
  "bugs": {
    "url": "https://github.com/XrioHQ/Xrio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XrioHQ/Xrio.git",
    "directory": "packages/plugins/http-api"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "vp exec tsc --noEmit"
  },
  "dependencies": {
    "express": "5.2.1",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "@types/swagger-ui-express": "4.1.8",
    "@xrio/core": "workspace:*",
    "@xrio/typescript-config": "workspace:*",
    "vite-plus": "1.0.0"
  },
  "peerDependencies": {
    "@xrio/core": "workspace:^"
  },
  "engines": {
    "node": ">=22.1.0"
  }
}
