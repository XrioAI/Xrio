{
  "name": "@xrio/core",
  "version": "0.0.0",
  "description": "Pluggable web scraping core: one Xrio instance, many scrapes.",
  "keywords": [
    "headless",
    "plugins",
    "proxy",
    "scraper",
    "web-scraping"
  ],
  "homepage": "https://github.com/XrioHQ/Xrio#readme",
  "bugs": {
    "url": "https://github.com/XrioHQ/Xrio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XrioHQ/Xrio.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "vp exec tsc --noEmit"
  },
  "dependencies": {
    "express": "5.2.1",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "@types/swagger-ui-express": "4.1.8",
    "@xrio/typescript-config": "workspace:*",
    "vite-plus": "1.0.0"
  },
  "engines": {
    "node": ">=22.1.0"
  }
}
