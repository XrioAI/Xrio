{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/landing": {
      "entry": [
        "src/components/sections/benchmarks.tsx!",
        "src/components/sections/design-panel.tsx!",
        "src/components/sections/pricing.tsx!"
      ]
    },
    "packages/core": {
      "entry": [
        "src/client.ts!",
        "src/config.ts!",
        "src/proxy/manager.ts!",
        "scripts/*.ts!",
        "examples/*.ts"
      ],
      "project": ["src/**/*.ts!", "scripts/*.ts!", "examples/*.ts", "!src/testing/**!"]
    }
  }
}
