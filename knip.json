{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/landing": {
      "entry": ["src/components/sections/design-panel.tsx!", "src/components/sections/pricing.tsx!"]
    },
    "packages/core": {
      "entry": [
        "src/client.ts!",
        "src/proxy/route.ts!",
        "src/humanizer/contracts.ts!",
        "src/sessions/session.ts!",
        "scripts/*.ts!",
        "examples/*.ts"
      ],
      "project": ["src/**/*.ts!", "scripts/*.ts!", "examples/*.ts", "!src/testing/**!"]
    },
    ".": {
      "entry": ["lint/*.ts!", "!lint/*.test.ts!"]
    }
  }
}
